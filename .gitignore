node_modules/
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
/playwright/.auth/

# Generated by scripts/copy-pdf-worker.mjs (postinstall + prebuild)
/public/copilot/

# Superpowers workflow artifacts
.worktrees/
docs/superpowers/

# local testimonial source screenshots — raw customer message captures.
# Quotes are transcribed into lib/emailAutomations/testimonials.ts; the
# images themselves are never shipped and must not reach a public path.
public/media/automation-feedback-images/

# local machine artifacts (never commit)
.claude/settings.local.json
social-crm.db

# Purchased design reference (Lumen, Shadcnblocks).
# NEVER commit: the licence forbids publishing the source in a repository, and
# Lumen.fig alone is 218MB.
#
# No trailing slash on purpose. In this worktree `_reference` is a SYMLINK to
# the copy outside it, and git does not treat a symlink as a directory — the
# `_reference/` form silently fails to match it.
_reference
