exports[`Hebrew baseline — /inbox/messenger page-level states (server HTML) > not enabled, no Page, permission missing / declined 1`] = `
{
  "declined": "<div class="grid gap-3 p-3 sm:p-4"><header class="flex flex-wrap items-center justify-between gap-2"><h1 class="text-lg font-semibold text-gray-900">הודעות Messenger</h1><nav aria-label="ערוץ" class="flex flex-wrap items-center gap-1.5"><a class="inline-flex items-center gap-1.5 rounded-full border px-2.5 py-1 text-xs transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary/40 border-gray-200 text-gray-500 hover:bg-gray-50" href="/inbox"><span aria-hidden="true" class="inline-block shrink-0 size-3.5" style="background-color:var(--color-success);mask-image:url(/media/social-icons/whatsapp.svg);-webkit-mask-image:url(/media/social-icons/whatsapp.svg);mask-repeat:no-repeat;-webkit-mask-repeat:no-repeat;mask-position:center;-webkit-mask-position:center;mask-size:contain;-webkit-mask-size:contain"></span>שיחות</a><a aria-current="page" class="inline-flex items-center gap-1.5 rounded-full border px-2.5 py-1 text-xs transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary/40 border-info-border bg-primary-tint text-primary-text font-medium" href="/inbox/messenger"><span aria-hidden="true" class="inline-block shrink-0 size-3.5" style="background-color:#0866FF;mask-image:url(https://res.cloudinary.com/dfletli2x/image/upload/icons/sol/facebook-messenger.svg);-webkit-mask-image:url(https://res.cloudinary.com/dfletli2x/image/upload/icons/sol/facebook-messenger.svg);mask-repeat:no-repeat;-webkit-mask-repeat:no-repeat;mask-position:center;-webkit-mask-position:center;mask-size:contain;-webkit-mask-size:contain"></span>Messenger</a><a class="inline-flex items-center gap-1.5 rounded-full border px-2.5 py-1 text-xs transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary/40 border-gray-200 text-gray-500 hover:bg-gray-50" href="/inbox/comments"><span aria-hidden="true" class="inline-block shrink-0 size-3.5" style="background-color:#1877F2;mask-image:url(/media/social-icons/facebook.svg);-webkit-mask-image:url(/media/social-icons/facebook.svg);mask-repeat:no-repeat;-webkit-mask-repeat:no-repeat;mask-position:center;-webkit-mask-position:center;mask-size:contain;-webkit-mask-size:contain"></span>תגובות</a></nav></header><div class="grid gap-2"><div role="status" class="rounded-md border p-3 border-amber-300 bg-amber-50"><p class="text-sm font-medium text-amber-800">ההרשאה ל-Messenger לא אושרה</p><p class="mt-1 text-sm text-amber-700">במסך האישור של פייסבוק ההרשאה לניהול הודעות לא סומנה, ולכן הודעות Messenger לא יגיעו לכאן.</p><p class="mt-2 text-xs text-amber-700/80">בדרך כלל בגלל:</p><ul class="mt-0.5 list-disc ps-5 text-sm text-amber-700"><li>ההרשאה לא סומנה במסך האישור של Facebook</li></ul><p class="mt-2 text-sm text-amber-700">אפשר לנסות שוב ולסמן את ההרשאה.</p></div><div class="grid gap-2"><button class="flex items-center min-w-fit justify-center font-medium rounded-md flex-nowrap bg-solid text-white hover:bg-solid/85 h-9 px-3 gap-3 text-[15px] w-fit"><div aria-hidden="true" class="dark:bg-white bg-white size-[15px] " style="mask-image:url(https://res.cloudinary.com/dfletli2x/image/upload/icons/sol/facebook.svg);-webkit-mask-image:url(https://res.cloudinary.com/dfletli2x/image/upload/icons/sol/facebook.svg);mask-repeat:no-repeat;-webkit-mask-repeat:no-repeat;mask-position:center;-webkit-mask-position:center;mask-size:contain;-webkit-mask-size:contain;mask-type:alpha"></div><span>לנסות שוב</span></button></div></div></div>",
  "notConnected": "<div class="grid gap-3 p-3 sm:p-4"><header class="flex flex-wrap items-center justify-between gap-2"><h1 class="text-lg font-semibold text-gray-900">הודעות Messenger</h1><nav aria-label="ערוץ" class="flex flex-wrap items-center gap-1.5"><a class="inline-flex items-center gap-1.5 rounded-full border px-2.5 py-1 text-xs transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary/40 border-gray-200 text-gray-500 hover:bg-gray-50" href="/inbox"><span aria-hidden="true" class="inline-block shrink-0 size-3.5" style="background-color:var(--color-success);mask-image:url(/media/social-icons/whatsapp.svg);-webkit-mask-image:url(/media/social-icons/whatsapp.svg);mask-repeat:no-repeat;-webkit-mask-repeat:no-repeat;mask-position:center;-webkit-mask-position:center;mask-size:contain;-webkit-mask-size:contain"></span>שיחות</a><a aria-current="page" class="inline-flex items-center gap-1.5 rounded-full border px-2.5 py-1 text-xs transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary/40 border-info-border bg-primary-tint text-primary-text font-medium" href="/inbox/messenger"><span aria-hidden="true" class="inline-block shrink-0 size-3.5" style="background-color:#0866FF;mask-image:url(https://res.cloudinary.com/dfletli2x/image/upload/icons/sol/facebook-messenger.svg);-webkit-mask-image:url(https://res.cloudinary.com/dfletli2x/image/upload/icons/sol/facebook-messenger.svg);mask-repeat:no-repeat;-webkit-mask-repeat:no-repeat;mask-position:center;-webkit-mask-position:center;mask-size:contain;-webkit-mask-size:contain"></span>Messenger</a><a class="inline-flex items-center gap-1.5 rounded-full border px-2.5 py-1 text-xs transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary/40 border-gray-200 text-gray-500 hover:bg-gray-50" href="/inbox/comments"><span aria-hidden="true" class="inline-block shrink-0 size-3.5" style="background-color:#1877F2;mask-image:url(/media/social-icons/facebook.svg);-webkit-mask-image:url(/media/social-icons/facebook.svg);mask-repeat:no-repeat;-webkit-mask-repeat:no-repeat;mask-position:center;-webkit-mask-position:center;mask-size:contain;-webkit-mask-size:contain"></span>תגובות</a></nav></header><div class="flex flex-col items-center justify-center px-6 py-10 text-center"><span class="flex size-14 items-center justify-center rounded-full bg-gray-100"><span aria-hidden="true" class="inline-block shrink-0 size-6" style="background-color:#0866FF;mask-image:url(https://res.cloudinary.com/dfletli2x/image/upload/icons/sol/facebook-messenger.svg);-webkit-mask-image:url(https://res.cloudinary.com/dfletli2x/image/upload/icons/sol/facebook-messenger.svg);mask-repeat:no-repeat;-webkit-mask-repeat:no-repeat;mask-position:center;-webkit-mask-position:center;mask-size:contain;-webkit-mask-size:contain"></span></span><p class="mt-3 text-base font-medium text-gray-700">דף הפייסבוק אינו מחובר</p><p class="mt-1 max-w-md text-sm text-gray-500">כדי לקבל הודעות Messenger מהדף ולהשיב להן מכאן, צריך לחבר את הדף קודם בהגדרות.</p><a class="mt-3 inline-flex min-h-10 items-center rounded-md bg-primary px-4 text-sm font-medium text-white hover:bg-primary/90 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary/40" href="/settings/integrations?section=facebook">חבר דף פייסבוק</a></div></div>",
  "notEnabled": "<div class="grid gap-3 p-3 sm:p-4"><header class="flex flex-wrap items-center justify-between gap-2"><h1 class="text-lg font-semibold text-gray-900">הודעות Messenger</h1><nav aria-label="ערוץ" class="flex flex-wrap items-center gap-1.5"><a class="inline-flex items-center gap-1.5 rounded-full border px-2.5 py-1 text-xs transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary/40 border-gray-200 text-gray-500 hover:bg-gray-50" href="/inbox"><span aria-hidden="true" class="inline-block shrink-0 size-3.5" style="background-color:var(--color-success);mask-image:url(/media/social-icons/whatsapp.svg);-webkit-mask-image:url(/media/social-icons/whatsapp.svg);mask-repeat:no-repeat;-webkit-mask-repeat:no-repeat;mask-position:center;-webkit-mask-position:center;mask-size:contain;-webkit-mask-size:contain"></span>שיחות</a><a aria-current="page" class="inline-flex items-center gap-1.5 rounded-full border px-2.5 py-1 text-xs transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary/40 border-info-border bg-primary-tint text-primary-text font-medium" href="/inbox/messenger"><span aria-hidden="true" class="inline-block shrink-0 size-3.5" style="background-color:#0866FF;mask-image:url(https://res.cloudinary.com/dfletli2x/image/upload/icons/sol/facebook-messenger.svg);-webkit-mask-image:url(https://res.cloudinary.com/dfletli2x/image/upload/icons/sol/facebook-messenger.svg);mask-repeat:no-repeat;-webkit-mask-repeat:no-repeat;mask-position:center;-webkit-mask-position:center;mask-size:contain;-webkit-mask-size:contain"></span>Messenger</a><a class="inline-flex items-center gap-1.5 rounded-full border px-2.5 py-1 text-xs transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary/40 border-gray-200 text-gray-500 hover:bg-gray-50" href="/inbox/comments"><span aria-hidden="true" class="inline-block shrink-0 size-3.5" style="background-color:#1877F2;mask-image:url(/media/social-icons/facebook.svg);-webkit-mask-image:url(/media/social-icons/facebook.svg);mask-repeat:no-repeat;-webkit-mask-repeat:no-repeat;mask-position:center;-webkit-mask-position:center;mask-size:contain;-webkit-mask-size:contain"></span>תגובות</a></nav></header><div class="flex flex-col items-center justify-center px-6 py-10 text-center"><span class="flex size-14 items-center justify-center rounded-full bg-gray-100"><span aria-hidden="true" class="inline-block shrink-0 size-6" style="background-color:#0866FF;mask-image:url(https://res.cloudinary.com/dfletli2x/image/upload/icons/sol/facebook-messenger.svg);-webkit-mask-image:url(https://res.cloudinary.com/dfletli2x/image/upload/icons/sol/facebook-messenger.svg);mask-repeat:no-repeat;-webkit-mask-repeat:no-repeat;mask-position:center;-webkit-mask-position:center;mask-size:contain;-webkit-mask-size:contain"></span></span><p class="mt-3 text-base font-medium text-gray-700">הודעות Messenger</p><p class="mt-1 max-w-md text-sm text-gray-500">הודעות שנשלחות לדף הפייסבוק שלך ב-Messenger יופיעו כאן אחרי שהערוץ יופעל בחשבון.</p></div></div>",
  "permission": "<div class="grid gap-3 p-3 sm:p-4"><header class="flex flex-wrap items-center justify-between gap-2"><h1 class="text-lg font-semibold text-gray-900">הודעות Messenger</h1><nav aria-label="ערוץ" class="flex flex-wrap items-center gap-1.5"><a class="inline-flex items-center gap-1.5 rounded-full border px-2.5 py-1 text-xs transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary/40 border-gray-200 text-gray-500 hover:bg-gray-50" href="/inbox"><span aria-hidden="true" class="inline-block shrink-0 size-3.5" style="background-color:var(--color-success);mask-image:url(/media/social-icons/whatsapp.svg);-webkit-mask-image:url(/media/social-icons/whatsapp.svg);mask-repeat:no-repeat;-webkit-mask-repeat:no-repeat;mask-position:center;-webkit-mask-position:center;mask-size:contain;-webkit-mask-size:contain"></span>שיחות</a><a aria-current="page" class="inline-flex items-center gap-1.5 rounded-full border px-2.5 py-1 text-xs transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary/40 border-info-border bg-primary-tint text-primary-text font-medium" href="/inbox/messenger"><span aria-hidden="true" class="inline-block shrink-0 size-3.5" style="background-color:#0866FF;mask-image:url(https://res.cloudinary.com/dfletli2x/image/upload/icons/sol/facebook-messenger.svg);-webkit-mask-image:url(https://res.cloudinary.com/dfletli2x/image/upload/icons/sol/facebook-messenger.svg);mask-repeat:no-repeat;-webkit-mask-repeat:no-repeat;mask-position:center;-webkit-mask-position:center;mask-size:contain;-webkit-mask-size:contain"></span>Messenger</a><a class="inline-flex items-center gap-1.5 rounded-full border px-2.5 py-1 text-xs transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary/40 border-gray-200 text-gray-500 hover:bg-gray-50" href="/inbox/comments"><span aria-hidden="true" class="inline-block shrink-0 size-3.5" style="background-color:#1877F2;mask-image:url(/media/social-icons/facebook.svg);-webkit-mask-image:url(/media/social-icons/facebook.svg);mask-repeat:no-repeat;-webkit-mask-repeat:no-repeat;mask-position:center;-webkit-mask-position:center;mask-size:contain;-webkit-mask-size:contain"></span>תגובות</a></nav></header><div class="grid gap-2"><div role="status" class="rounded-md border p-3 border-amber-300 bg-amber-50"><p class="text-sm font-medium text-amber-800">כדי לקבל ולשלוח הודעות Messenger צריך לאשר הרשאה</p><p class="mt-1 text-sm text-amber-700">הדף מחובר והלידים ממשיכים להגיע כרגיל. כדי שהודעות Messenger מהדף יופיעו כאן ושתוכל להשיב להן, פייסבוק דורש אישור לניהול הודעות הדף.</p><p class="mt-2 text-sm text-amber-700">לאשר את ההרשאה במסך של פייסבוק. החיבור והלידים הקיימים לא ייפגעו.</p></div><div class="grid gap-2"><button class="flex items-center min-w-fit justify-center font-medium rounded-md flex-nowrap bg-solid text-white hover:bg-solid/85 h-9 px-3 gap-3 text-[15px] w-fit"><div aria-hidden="true" class="dark:bg-white bg-white size-[15px] " style="mask-image:url(https://res.cloudinary.com/dfletli2x/image/upload/icons/sol/facebook.svg);-webkit-mask-image:url(https://res.cloudinary.com/dfletli2x/image/upload/icons/sol/facebook.svg);mask-repeat:no-repeat;-webkit-mask-repeat:no-repeat;mask-position:center;-webkit-mask-position:center;mask-size:contain;-webkit-mask-size:contain;mask-type:alpha"></div><span>אשר הרשאה ל-Messenger</span></button></div></div></div>",
  "repPermission": "<div class="grid gap-3 p-3 sm:p-4"><header class="flex flex-wrap items-center justify-between gap-2"><h1 class="text-lg font-semibold text-gray-900">הודעות Messenger</h1><nav aria-label="ערוץ" class="flex flex-wrap items-center gap-1.5"><a class="inline-flex items-center gap-1.5 rounded-full border px-2.5 py-1 text-xs transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary/40 border-gray-200 text-gray-500 hover:bg-gray-50" href="/inbox"><span aria-hidden="true" class="inline-block shrink-0 size-3.5" style="background-color:var(--color-success);mask-image:url(/media/social-icons/whatsapp.svg);-webkit-mask-image:url(/media/social-icons/whatsapp.svg);mask-repeat:no-repeat;-webkit-mask-repeat:no-repeat;mask-position:center;-webkit-mask-position:center;mask-size:contain;-webkit-mask-size:contain"></span>שיחות</a><a aria-current="page" class="inline-flex items-center gap-1.5 rounded-full border px-2.5 py-1 text-xs transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary/40 border-info-border bg-primary-tint text-primary-text font-medium" href="/inbox/messenger"><span aria-hidden="true" class="inline-block shrink-0 size-3.5" style="background-color:#0866FF;mask-image:url(https://res.cloudinary.com/dfletli2x/image/upload/icons/sol/facebook-messenger.svg);-webkit-mask-image:url(https://res.cloudinary.com/dfletli2x/image/upload/icons/sol/facebook-messenger.svg);mask-repeat:no-repeat;-webkit-mask-repeat:no-repeat;mask-position:center;-webkit-mask-position:center;mask-size:contain;-webkit-mask-size:contain"></span>Messenger</a><a class="inline-flex items-center gap-1.5 rounded-full border px-2.5 py-1 text-xs transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary/40 border-gray-200 text-gray-500 hover:bg-gray-50" href="/inbox/comments"><span aria-hidden="true" class="inline-block shrink-0 size-3.5" style="background-color:#1877F2;mask-image:url(/media/social-icons/facebook.svg);-webkit-mask-image:url(/media/social-icons/facebook.svg);mask-repeat:no-repeat;-webkit-mask-repeat:no-repeat;mask-position:center;-webkit-mask-position:center;mask-size:contain;-webkit-mask-size:contain"></span>תגובות</a></nav></header><div class="grid gap-2"><div role="status" class="rounded-md border p-3 border-amber-300 bg-amber-50"><p class="text-sm font-medium text-amber-800">כדי לקבל ולשלוח הודעות Messenger צריך לאשר הרשאה</p><p class="mt-1 text-sm text-amber-700">הדף מחובר והלידים ממשיכים להגיע כרגיל. כדי שהודעות Messenger מהדף יופיעו כאן ושתוכל להשיב להן, פייסבוק דורש אישור לניהול הודעות הדף.</p><p class="mt-2 text-sm text-amber-700">לאשר את ההרשאה במסך של פייסבוק. החיבור והלידים הקיימים לא ייפגעו.</p></div><p class="text-sm text-gray-600">מנהל החשבון צריך לאשר את ההרשאה בפייסבוק.</p></div></div>",
}
`;

exports[`Hebrew baseline — /inbox/messenger page-level states (server HTML) > populated list, nothing selected (unread, outbound, nameless, profile-access notice); rep sees no notice 1`] = `
{
