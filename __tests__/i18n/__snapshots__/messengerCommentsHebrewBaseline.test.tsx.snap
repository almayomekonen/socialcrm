exports[`Hebrew baseline — /inbox/messenger page-level states (server HTML) > connected, no conversations: ready (+ import offer, + granted), not subscribed, reconnect, rep; search without results 1`] = `
{
  "granted": "<div class="grid gap-3 p-3 sm:p-4"><header class="flex flex-wrap items-center justify-between gap-2"><h1 class="text-lg font-semibold text-gray-900">הודעות Messenger</h1><nav aria-label="ערוץ" class="flex flex-wrap items-center gap-1.5"><a class="inline-flex items-center gap-1.5 rounded-full border px-2.5 py-1 text-xs transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary/40 border-gray-200 text-gray-500 hover:bg-gray-50" href="/inbox"><span aria-hidden="true" class="inline-block shrink-0 size-3.5" style="background-color:var(--color-success);mask-image:url(/media/social-icons/whatsapp.svg);-webkit-mask-image:url(/media/social-icons/whatsapp.svg);mask-repeat:no-repeat;-webkit-mask-repeat:no-repeat;mask-position:center;-webkit-mask-position:center;mask-size:contain;-webkit-mask-size:contain"></span>שיחות</a><a aria-current="page" class="inline-flex items-center gap-1.5 rounded-full border px-2.5 py-1 text-xs transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary/40 border-info-border bg-primary-tint text-primary-text font-medium" href="/inbox/messenger"><span aria-hidden="true" class="inline-block shrink-0 size-3.5" style="background-color:#0866FF;mask-image:url(https://res.cloudinary.com/dfletli2x/image/upload/icons/sol/facebook-messenger.svg);-webkit-mask-image:url(https://res.cloudinary.com/dfletli2x/image/upload/icons/sol/facebook-messenger.svg);mask-repeat:no-repeat;-webkit-mask-repeat:no-repeat;mask-position:center;-webkit-mask-position:center;mask-size:contain;-webkit-mask-size:contain"></span>Messenger</a><a class="inline-flex items-center gap-1.5 rounded-full border px-2.5 py-1 text-xs transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary/40 border-gray-200 text-gray-500 hover:bg-gray-50" href="/inbox/comments"><span aria-hidden="true" class="inline-block shrink-0 size-3.5" style="background-color:#1877F2;mask-image:url(/media/social-icons/facebook.svg);-webkit-mask-image:url(/media/social-icons/facebook.svg);mask-repeat:no-repeat;-webkit-mask-repeat:no-repeat;mask-position:center;-webkit-mask-position:center;mask-size:contain;-webkit-mask-size:contain"></span>תגובות</a></nav></header><p role="status" class="text-sm text-green-600">ההרשאה אושרה. הודעות Messenger חדשות יופיעו כאן.</p><div class="flex flex-col items-center justify-center px-6 py-10 text-center"><span class="flex size-14 items-center justify-center rounded-full bg-gray-100"><span aria-hidden="true" class="inline-block shrink-0 size-6" style="background-color:#0866FF;mask-image:url(https://res.cloudinary.com/dfletli2x/image/upload/icons/sol/facebook-messenger.svg);-webkit-mask-image:url(https://res.cloudinary.com/dfletli2x/image/upload/icons/sol/facebook-messenger.svg);mask-repeat:no-repeat;-webkit-mask-repeat:no-repeat;mask-position:center;-webkit-mask-position:center;mask-size:contain;-webkit-mask-size:contain"></span></span><p class="mt-3 text-base font-medium text-gray-700">אין עדיין הודעות</p><p class="mt-1 max-w-md text-sm text-gray-500">כשמישהו ישלח הודעה לדף ב-Messenger, השיחה תופיע כאן ותוכל להשיב לה ולהפוך אותה לליד.</p></div><div class="grid gap-1.5"><button class="flex items-center min-w-fit justify-center font-medium rounded-md flex-nowrap border text-black border-gray-200 bg-white hover:bg-gray-100/60 h-10 px-4 gap-3"><span>ייבא שיחות קיימות מהדף</span></button><p class="text-[11px] leading-relaxed text-gray-500">פייסבוק מאפשר לייבא רק את ההודעות האחרונות בכל שיחה (עד 20), ולא את כל ההיסטוריה.</p></div></div>",
  "noResults": "<div class="grid gap-3 p-3 sm:p-4"><header class="flex flex-wrap items-center justify-between gap-2"><h1 class="text-lg font-semibold text-gray-900">הודעות Messenger</h1><nav aria-label="ערוץ" class="flex flex-wrap items-center gap-1.5"><a class="inline-flex items-center gap-1.5 rounded-full border px-2.5 py-1 text-xs transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary/40 border-gray-200 text-gray-500 hover:bg-gray-50" href="/inbox"><span aria-hidden="true" class="inline-block shrink-0 size-3.5" style="background-color:var(--color-success);mask-image:url(/media/social-icons/whatsapp.svg);-webkit-mask-image:url(/media/social-icons/whatsapp.svg);mask-repeat:no-repeat;-webkit-mask-repeat:no-repeat;mask-position:center;-webkit-mask-position:center;mask-size:contain;-webkit-mask-size:contain"></span>שיחות</a><a aria-current="page" class="inline-flex items-center gap-1.5 rounded-full border px-2.5 py-1 text-xs transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary/40 border-info-border bg-primary-tint text-primary-text font-medium" href="/inbox/messenger"><span aria-hidden="true" class="inline-block shrink-0 size-3.5" style="background-color:#0866FF;mask-image:url(https://res.cloudinary.com/dfletli2x/image/upload/icons/sol/facebook-messenger.svg);-webkit-mask-image:url(https://res.cloudinary.com/dfletli2x/image/upload/icons/sol/facebook-messenger.svg);mask-repeat:no-repeat;-webkit-mask-repeat:no-repeat;mask-position:center;-webkit-mask-position:center;mask-size:contain;-webkit-mask-size:contain"></span>Messenger</a><a class="inline-flex items-center gap-1.5 rounded-full border px-2.5 py-1 text-xs transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary/40 border-gray-200 text-gray-500 hover:bg-gray-50" href="/inbox/comments"><span aria-hidden="true" class="inline-block shrink-0 size-3.5" style="background-color:#1877F2;mask-image:url(/media/so