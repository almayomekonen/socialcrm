      "success",
      "הדף "Dana Studio EN" חובר בהצלחה",
    ],
    [
      "router.refresh",
    ],
  ],
  "connectButton_none": "לנסות שוב",
  "connectButton_resource_claimed": "חבר דף",
  "connectButton_subscription_failed": "לנסות שוב",
  "connectFailed_none": "<div role="status" class="rounded-md border p-3 border-red-200 bg-red-50"><p class="text-sm font-medium text-red-800">החיבור לא נשמר</p><p class="mt-1 text-sm text-red-700">מדובר בתקלה במערכת שלנו. בפייסבוק לא בוצע שינוי כלשהו.</p><p class="mt-2 text-xs text-red-700/80">בדרך כלל בגלל:</p><ul class="mt-0.5 list-disc ps-5 text-sm text-red-700"><li>עומס רגעי במערכת</li></ul><p class="mt-2 text-sm text-red-700">לנסות שוב כעת.</p></div>",
  "connectFailed_resource_claimed": "<div role="status" class="rounded-md border p-3 border-red-200 bg-red-50"><p class="text-sm font-medium text-red-800">הדף כבר מחובר לחשבון אחר</p><p class="mt-1 text-sm text-red-700">דף ה-Facebook הזה כבר מחובר לחשבון SocialCRM אחר. כדי למנוע כפילות, אי אפשר לחבר אותו לשני חשבונות במקביל.</p><p class="mt-2 text-xs text-red-700/80">בדרך כלל בגלל:</p><ul class="mt-0.5 list-disc ps-5 text-sm text-red-700"><li>ייתכן שהדף חובר בעבר מחשבון אחר שלכם</li></ul><p class="mt-2 text-sm text-red-700">אם הדף שייך לכם, יש לנתקו מהחשבון האחר תחילה ואז לחבר כאן.</p></div>",
  "connectFailed_subscription_failed": "<div role="status" class="rounded-md border p-3 border-red-200 bg-red-50"><p class="text-sm font-medium text-red-800">הדף לא נרשם לקבלת לידים</p><p class="mt-1 text-sm text-red-700">פייסבוק לא אישרה קבלת לידים מהדף, ולכן העדפנו לא לשמור חיבור שלא יביא לידים.</p><p class="mt-2 text-xs text-red-700/80">בדרך כלל בגלל:</p><ul class="mt-0.5 list-disc ps-5 text-sm text-red-700"><li>הרשאת ניהול חלקית</li><li>הגבלות ב-Business Manager</li></ul><p class="mt-2 text-sm text-red-700">לוודא הרשאת מנהל מלאה לדף ולנסות שוב.</p></div>",
  "disconnectDialog": "<div role="dialog" aria-modal="true" aria-label="לנתק את הדף &quot;סטודיו דנה&quot;?" tabindex="-1" class="overflow-y-auto bg-white shadow-2xl relative popin overflow-x-hidden scrollbar-slim outline-none p-8 max-h-[90vh] rounded-lg"><button class="absolute top-2 left-2" title="יציאה ללא שמירה" aria-label="סגירה"><div aria-hidden="true" class="dark:bg-white size-[22px] bg-red-700 " style="mask-image: url(&quot;https://res.cloudinary.com/dfletli2x/image/upload/icons/lit/circle-xmark.svg&quot;); -webkit-mask-image: url(&quot;https://res.cloudinary.com/dfletli2x/image/upload/icons/lit/circle-xmark.svg&quot;); mask-repeat: no-repeat; -webkit-mask-repeat: no-repeat; mask-position: center; -webkit-mask-position: center; mask-size: contain; -webkit-mask-size: contain; mask-type: alpha;"></div></button><div class="flex flex-col gap-6 min-w-[320px] pt-4"><p class="font-semibold whitespace-pre-line pe-6">לנתק את הדף "סטודיו דנה"?</p><div class="flex justify-end gap-2"><button class="flex items-center min-w-fit justify-center font-medium rounded-md flex-nowrap border text-black border-gray-200 bg-white hover:bg-gray-100/60 h-10 px-4 gap-3"><span>ביטול</span></button><button class="flex items-center min-w-fit justify-center font-medium rounded-md flex-nowrap bg-red-600 text-white hover:bg-red-700 h-10 px-4 gap-3"><span>אישור</span></button></div></div></div>",
}
`;

exports[`Hebrew baseline — Facebook and WhatsApp connect > WhatsApp: launch failures (Meta error with / without a documented step, SDK, not completed) on a live connection and when not connected; disconnect; number picker failure 1`] = `
{
  "disconnectDialog": "<div role="dialog" aria-modal="true" aria-label="לנתק את חיבור הוואטסאפ?" tabindex="-1" class="overflow-y-auto bg-white shadow-2xl relative popin overflow-x-hidden scrollbar-slim outline-none p-8 max-h-[90vh] rounded-lg"><button class="absolute top-2 left-2" title="יציאה ללא שמירה" aria-label="סגירה"><div aria-hidden="true" class="dark:bg-white size-[22px] bg-red-700 " style="mask-image: url(&quot;https://res.cloudinary.com/dfletli2x/image/upload/icons/lit/circle-xmark.svg&quot;); -webkit-mask-image: url(&quot;https://res.cloudinary.com/dfletli2x/image/upload/icons/lit/circle-xmark.svg&quot;); mask-repeat: no-repeat; -webkit-mask-repeat: no-repeat; mask-position: center; -webkit-mask-position: center; mask-size: contain; -webkit-mask-size: contain; mask-type: alpha;"></div></button><div class="flex flex-col gap-6 min-w-[320px] pt-4"><p class="font-semibold whitespace-pre-line pe-6">לנתק את חיבור הוואטסאפ?</p><div class="flex justify-end gap-2"><button class="flex items-center min-w-fit justify-center font-medium rounded-md flex-nowrap border text-black border-gray-200 bg-white hover:bg-gray-100/60 h-10 px-4 gap-3"><span>ביטול</span></button><button class="flex items-center min-w-fit justify-center font-medium rounded-md flex-nowrap bg-red-600 text-white hover:bg-red-700 h-10 px-4 gap-3"><span>אישור</span></button></div></div></div>",
  "live_metaDocumented": "<div role="status" class="rounded-md border p-3 border-red-200 bg-red-50"><p class="text-sm font-medium text-red-800">לא הצלחנו להשלים את החיבור לוואטסאפ</p><p class="mt-1 text-sm text-red-700">ההודעה שהוצגה בחלון של Meta: ⁨"This phone number is registered to an existing WhatsApp account."⁩</p><p class="mt-2 text-sm text-red-700">המספר פעיל בחשבון וואטסאפ אחר. אם זה המספר של אפליקציית WhatsApp Business, לבחור בחלון של Meta בחיבור האפליקציה הקיימת. אחרת, לנתק אותו מהחשבון הקיים ולנסות שוב אחרי כ-3 דקות.</p></div>",
  "live_metaUndocumented": "<div role="status" class="rounded-md border p-3 border-red-200 bg-red-50"><p class="text-sm font-medium text-red-800">לא הצלחנו להשלים את החיבור לוואטסאפ</p><p class="mt-1 text-sm text-red-700">ההודעה שהוצגה בחלון של Meta: ⁨"Unexpected Meta failure"⁩</p><p class="mt-2 text-sm text-red-700">לפעול לפי ההודעה של Meta ואז לנסות שוב. אם ההודעה מבקשת להמתין, כדאי לחזור לחיבור מאוחר יותר.</p></div>",
  "live_network": "<div role="status" class="rounded-md border p-3 border-red-200 bg-red-50"><p class="text-sm font-medium text-red-800">החיבור לאינטרנט נקטע</p><p class="mt-1 text-sm text-red-700">הפעולה לא הושלמה. לא נשמר ולא השתנה מידע כלשהו.</p><p class="mt-2 text-xs text-red-700/80">בדרך כלל בגלל:</p><ul class="mt-0.5 list-disc ps-5 text-sm text-red-700"><li>הפרעה זמנית ברשת</li></ul><p class="mt-2 text-sm text-red-700">לבדוק את חיבור האינטרנט ולנסות שוב.</p></div>",
  "live_sdk": "<div role="status" class="rounded-md border p-3 border-red-200 bg-red-50"><p class="text-sm font-medium text-red-800">חלון ההתחברות לא נפתח</p><p class="mt-1 text-sm text-red-700">הדפדפן חסם את רכיב ההתחברות של פייסבוק.</p><p class="mt-2 text-xs text-red-700/80">בדרך כלל בגלל:</p><ul class="mt-0.5 list-disc ps-5 text-sm text-red-700"><li>חוסם פרסומות</li><li>הגדרת פרטיות מחמירה</li></ul><p class="mt-2 text-sm text-red-700">להשבית זמנית את החוסם, או לנסות בדפדפן אחר.</p></div>",
  "live_verification": "<div role="status" class="rounded-md border p-3 border-red-200 bg-red-50"><p class="text-sm font-medium text-red-800">החיבור לוואטסאפ פג</p><p class="mt-1 text-sm text-red-700">הודעות ולידים חדשים אינם נכנסים כרגע. כל המידע הקיים במערכת נשמר במלואו.</p><p class="mt-2 text-xs text-red-700/80">בדרך כלל בגלל:</p><ul class="mt-0.5 list-disc ps-5 text-sm text-red-700"><li>חלף זמן מהחיבור</li><li>ההרשאה ב-WhatsApp שונתה</li></ul><p class="mt-2 text-sm text-red-700">חידוש החיבור אורך פחות מדקה ואינו משפיע על נתונים קיימים.</p></div>",
  "new_metaDocumented": "<div role="status" class="rounded-md border p-3 border-red-200 bg-red-50"><p class="text-sm font-medium text-red-800">לא הצלחנו להשלים את החיבור לוואטסאפ</p><p class="mt-1 text-sm text-red-700">ההודעה שהוצגה בחלון של Meta: ⁨"This phone number is registered to an existing WhatsApp account."⁩</p><p class="mt-2 text-sm text-red-700">המספר פעיל בחשבון וואטסאפ אחר. אם זה המספר של אפליקציית WhatsApp Business, לבחור בחלון של Meta בחיבור האפליקציה הקיימת. אחרת, לנתק אותו מהחשבון הקיים ולנסות שוב אחרי כ-3 דקות.</p></div>",
  "new_metaUndocumented": "<div role="status" class="rounded-md border p-3 border-red-200 bg-red-50"><p class="text-sm font-medium text-red-800">לא הצלחנו להשלים את החיבור לוואטסאפ</p><p class="mt-1 text-sm text-red-700">ההודעה שהוצגה בחלון של Meta: ⁨"Unexpected Meta failure"⁩</p><p class="mt-2 text-sm text-red-700">לפעול לפי ההודעה של Meta ואז לנסות שוב. אם ההודעה מבקשת להמתין, כדאי לחזור לחיבור מאוחר יותר.</p></div>",
  "new_network": "<div role="status" class="rounded-md border p-3 border-red-200 bg-red-50"><p class="text-sm font-medium text-red-800">החיבור לאינטרנט נקטע</p><p class="mt-1 text-sm text-red-700">הפעולה לא הושלמה. לא נשמר ולא השתנה מידע כלשהו.</p><p class="mt-2 text-xs text-red-700/80">בדרך כלל בגלל:</p><ul class="mt-0.5 list-disc ps-5 text-sm text-red-700"><li>הפרעה זמנית ברשת</li></ul><p class="mt-2 text-sm text-red-700">לבדוק את חיבור האינטרנט ולנסות שוב.</p></div>",
  "new_notCompleted": "<div role="status" class="rounded-md border p-3 border-amber-300 bg-amber-50"><p class="text-sm font-medium text-amber-800">החיבור לוואטסאפ לא הושלם</p><p class="mt-1 text-sm text-amber-700">חלון ההתחברות של Meta נסגר לפני שכל השלבים הסתיימו.</p><p class="mt-2 text-xs text-amber-700/80">בדרך כלל בגלל:</p><ul class="mt-0.5 list-disc ps-5 text-sm text-amber-700"><li>החלון נסגר לפני הסיום</li><li>מעבר לאפליקציה אחרת באמצע התהליך</li></ul><p class="mt-2 text-sm text-amber-700">לנסות שוב ולהשלים את השלבים ברצף, או להשלים את החיבור מהמחשב.</p></div>",
  "new_sdk": "<div role="status" class="rounded-md border p-3 border-red-200 bg-red-50"><p class="text-sm font-medium text-red-800">חלון ההתחברות לא נפתח</p><p class="mt-1 text-sm text-red-700">הדפדפן חסם את רכיב ההתחברות של פייסבוק.</p><p class="mt-2 text-xs text-red-700/80">בדרך כלל בגלל:</p><ul class="mt-0.5 list-disc ps-5 text-sm text-red-700"><li>חוסם פרסומות</li><li>הגדרת פרטיות מחמירה</li></ul><p class="mt-2 text-sm text-red-700">להשבית זמנית את החוסם, או לנסות בדפדפן אחר.</p></div>",
  "new_verification": "<div role="status" class="rounded-md border p-3 border-amber-300 bg-amber-50"><p class="text-sm font-medium text-amber-800">אימות המספר העסקי לא הושלם</p><p class="mt-1 text-sm text-amber-700">חלון ההתחברות של Meta נסגר בשלב אימות מספר הוואטסאפ העסקי.</p><p class="mt-2 text-xs text-amber-700/80">בדרך כלל בגלל:</p><ul class="mt-0.5 list-disc ps-5 text-sm text-amber-700"><li>קוד האימות לא הוזן</li><li>הטלפון עם המספר העסקי לא היה זמין</li></ul><p class="mt-2 text-sm text-amber-700">לוודא שהטלפון עם המספר העסקי בהישג יד, כי אליו נשלח קוד האימות, ולנסות שוב.</p></div>",
  "phoneConnectFailed": "<summary><div class="flex items-center gap-2"><div aria-hidden="true" class="size-[18.5px] dark:bg-white bg-[#25D366] group-open/acrdn:bg-[#25D366] " style="mask-image: url(&quot;https://res.cloudinary.com/dfletli2x/image/upload/icons/reg/whatsapp.svg&quot;); -webkit-mask-image: url(&quot;https://res.cloudinary.com/dfletli2x/image/upload/icons/reg/whatsapp.svg&quot;); mask-repeat: no-repeat; -webkit-mask-repeat: no-repeat; mask-position: center; -webkit-mask-position: center; mask-size: contain; -webkit-mask-size: contain; mask-type: alpha;"></div><p class="group-open/acrdn:text-solid">וואטסאפ</p></div><div aria-hidden="true" class="bg-gray-800 size-[18.5px] dark:bg-white duration-200 group-hover/acrdn:bg-gray-950 group-open/acrdn:rotate-90 group-open/acrdn:bg-solid " style="mask-image: url(&quot;https://res.cloudinary.com/dfletli2x/image/upload/icons/lit/chevron-left.svg&quot;); -webkit-mask-image: url(&quot;https://res.cloudinary.com/dfletli2x/image/upload/icons/lit/chevron-left.svg&quot;); mask-repeat: no-repeat; -webkit-mask-repeat: no-repeat; mask-position: center; -webkit-mask-position: center; mask-size: contain; -webkit-mask-size: contain; mask-type: alpha;"></div></summary><div class="p-6"><div class="grid gap-4"><div role="status" class="rounded-md border p-3 border-red-200 bg-red-50"><p class="text-sm font-medium text-red-800">החיבור נקטע לפני השלמתו</p><p class="mt-1 text-sm text-red-700">האישור מ-Meta התקבל, אך החיבור לא הושלם.</p><p class="mt-2 text-xs text-red-700/80">בדרך כלל בגלל:</p><ul class="mt-0.5 list-disc ps-5 text-sm text-red-700"><li>התהליך ארך זמן רב</li></ul><p class="mt-2 text-sm text-red-700">לנסות שוב ולהשלים את השלבים ברצף.</p></div><p class="text-sm text-gray-600">בחר את מספר הטלפון שברצונך לחבר:</p><div class="block"><div class="flex justify-between mb-1 ms-1 items-end "><p class="text-gray-600 text-sm font-medium ">מספר וואטסאפ עסקי</p></div><select class="h-10 w-full rounded-md border border-gray-200 bg-white px-3 focus:outline-2 focus:outline-offset-0 focus:outline-primary"><option value="">בחר מספר...</option><option value="ph1">+972 50-123-4567 — סטודיו דנה</option></select></div><div data-edu="whatsapp-connect" class="w-fit"><button class="flex items-center min-w-fit justify-center font-medium rounded-md flex-nowrap bg-solid text-white hover:bg-solid/85 h-10 px-4 gap-3 w-fit"><div aria-hidden="true" class="dark:bg-white bg-white size-4 " style="mask-image: url(&quot;https://res.cloudinary.com/dfletli2x/image/upload/icons/sol/comment-dots.svg&quot;); -webkit-mask-image: url(&quot;https://res.cloudinary.com/dfletli2x/image/upload/icons/sol/comment-dots.svg&quot;); mask-repeat: no-repeat; -webkit-mask-repeat: no-repeat; mask-position: center; -webkit-mask-position: center; mask-size: contain; -webkit-mask-size: contain; mask-type: alpha;"></div><span>לנסות שוב</span></button></div></div></div>",
}
`;

exports[`Hebrew baseline — Messenger, Calendar, Drive, AI > Google Calendar / Drive / AI: disconnect dialogs and toasts, Drive status states, how-to disclosure 1`] = `
{
  "aiDialog": "<div role="dialog" aria-modal="true" aria-label="פגישות קיימות יישארו ב-CRM אך לא יסונכרנו עוד.
ניתן להתחבר שוב בכל עת." tabindex="-1" class="overflow-y-auto bg-white shadow-2xl relative popin overflow-x-hidden scrollbar-slim outline-none p-8 max-h-[90vh] rounded-lg"><button class="absolute top-2 left-2" title="יציאה ללא שמירה" aria-label="סגירה"><div aria-hidden="true" class="dark:bg-white size-[22px] bg-red-700 " style="mask-image: url(&quot;https://res.cloudinary.com/dfletli2x/image/upload/icons/lit/circle-xmark.svg&quot;); -webkit-mask-image: url(&quot;https://res.cloudinary.com/dfletli2x/image/upload/icons/lit/circle-xmark.svg&quot;); mask-repeat: no-repeat; -webkit-mask-repeat: no-repeat; mask-position: center; -webkit-mask-position: center; mask-size: contain; -webkit-mask-size: contain; mask-type: alpha;"></div></button><div class="flex flex-col gap-6 min-w-[320px] pt-4"><p class="font-semibold whitespace-pre-line pe-6">פגישות קיימות יישארו ב-CRM אך לא יסונכרנו עוד.
ניתן להתחבר שוב בכל עת.</p><div class="flex justify-end gap-2"><button class="flex items-center min-w-fit justify-center font-medium rounded-md flex-nowrap border text-black border-gray-200 bg-white hover:bg-gray-100/60 h-10 px-4 gap-3"><span>ביטול</span></button><button class="flex items-center min-w-fit justify-center font-medium rounded-md flex-nowrap bg-red-600 text-white hover:bg-red-700 h-10 px-4 gap-3"><span>נתק חשבון</span></button></div></div></div>
