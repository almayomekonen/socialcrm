  "invoice:failed": "<section class="rounded-xl border border-gray-200 bg-gray-50 px-6 py-5 flex flex-wrap items-center gap-x-6 gap-y-3" data-testid="post-issue-send-banner" data-pdf-status="failed"><div class="size-10 rounded-full bg-white border border-gray-200 flex items-center justify-center shrink-0"><div aria-hidden="true" class="dark:bg-white size-5 bg-gray-600 " style="mask-image: url(&quot;https://res.cloudinary.com/dfletli2x/image/upload/icons/sol/triangle-exclamation.svg&quot;); -webkit-mask-image: url(&quot;https://res.cloudinary.com/dfletli2x/image/upload/icons/sol/triangle-exclamation.svg&quot;); mask-repeat: no-repeat; -webkit-mask-repeat: no-repeat; mask-position: center; -webkit-mask-position: center; mask-size: contain; -webkit-mask-size: contain; mask-type: alpha;"></div></div><div class="min-w-0 flex-1"><p class="text-base font-semibold text-gray-900">הפקת ה-PDF נכשלה</p><p class="text-sm mt-0.5 text-gray-600">אפשר לנסות להפיק שוב מתפריט הפעולות.</p></div><div class="flex items-center gap-2 shrink-0"><button class="flex items-center min-w-fit justify-center font-medium rounded-md flex-nowrap bg-solid text-white hover:bg-solid/85 h-10 px-4 gap-3" disabled="" title="יש לנסות להפיק את ה-PDF מחדש" data-testid="post-issue-send-banner-send"><div aria-hidden="true" class="dark:bg-white bg-white size-4 " style="mask-image: url(&quot;https://res.cloudinary.com/dfletli2x/image/upload/icons/sol/paper-plane.svg&quot;); -webkit-mask-image: url(&quot;https://res.cloudinary.com/dfletli2x/image/upload/icons/sol/paper-plane.svg&quot;); mask-repeat: no-repeat; -webkit-mask-repeat: no-repeat; mask-position: center; -webkit-mask-position: center; mask-size: contain; -webkit-mask-size: contain; mask-type: alpha;"></div><span>שלח חשבונית</span></button><button class="flex items-center min-w-fit justify-center font-medium rounded-md flex-nowrap border text-black border-gray-200 bg-white hover:bg-gray-100/60 h-10 px-4 gap-3" data-testid="post-issue-send-banner-later"><span>מאוחר יותר</span></button></div></section>",
  "invoice:none": "<section class="rounded-xl border border-gray-200 bg-gray-50/80 px-6 py-5 flex flex-wrap items-center gap-x-6 gap-y-3" data-testid="post-issue-send-banner" data-pdf-status="none"><div class="size-10 rounded-full bg-white border border-gray-200 flex items-center justify-center shrink-0"><span class="inline-block size-3 rounded-full bg-gray-500 animate-pulse"></span></div><div class="min-w-0 flex-1"><p class="text-base font-semibold text-gray-900">מפיק את החשבונית…</p><p class="text-sm mt-0.5 text-gray-600">ברגע שהמסמך יהיה מוכן אפשר יהיה לשלוח אותו.</p></div><div class="flex items-center gap-2 shrink-0"><button class="flex items-center min-w-fit justify-center font-medium rounded-md flex-nowrap bg-solid text-white hover:bg-solid/85 h-10 px-4 gap-3" disabled="" title="המסמך עדיין מופק…" data-testid="post-issue-send-banner-send"><div aria-hidden="true" class="dark:bg-white bg-white size-4 " style="mask-image: url(&quot;https://res.cloudinary.com/dfletli2x/image/upload/icons/sol/paper-plane.svg&quot;); -webkit-mask-image: url(&quot;https://res.cloudinary.com/dfletli2x/image/upload/icons/sol/paper-plane.svg&quot;); mask-repeat: no-repeat; -webkit-mask-repeat: no-repeat; mask-position: center; -webkit-mask-position: center; mask-size: contain; -webkit-mask-size: contain; mask-type: alpha;"></div><span>שלח חשבונית</span></button><button class="flex items-center min-w-fit justify-center font-medium rounded-md flex-nowrap border text-black border-gray-200 bg-white hover:bg-gray-100/60 h-10 px-4 gap-3" data-testid="post-issue-send-banner-later"><span>מאוחר יותר</span></button></div></section>",
  "invoice:ready": "<section class="rounded-xl border border-emerald-200 bg-emerald-50/60 px-6 py-5 flex flex-wrap items-center gap-x-6 gap-y-3" data-testid="post-issue-send-banner" data-pdf-status="ready"><div class="size-10 rounded-full bg-white border border-emerald-200 flex items-center justify-center shrink-0"><div aria-hidden="true" class="dark:bg-white size-5 bg-emerald-600 " style="mask-image: url(&quot;https://res.cloudinary.com/dfletli2x/image/upload/icons/sol/circle-check.svg&quot;); -webkit-mask-image: url(&quot;https://res.cloudinary.com/dfletli2x/image/upload/icons/sol/circle-check.svg&quot;); mask-repeat: no-repeat; -webkit-mask-repeat: no-repeat; mask-position: center; -webkit-mask-position: center; mask-size: contain; -webkit-mask-size: contain; mask-type: alpha;"></div></div><div class="min-w-0 flex-1"><p class="text-base font-semibold text-emerald-900">החשבונית מוכנה</p><p class="text-sm mt-0.5 text-emerald-800/80">לשלוח ללקוח עכשיו?</p></div><div class="flex items-center gap-2 shrink-0"><button class="flex items-center min-w-fit justify-center font-medium rounded-md flex-nowrap bg-solid text-white hover:bg-solid/85 h-10 px-4 gap-3" data-testid="post-issue-send-banner-send"><div aria-hidden="true" class="dark:bg-white bg-white size-4 " style="mask-image: url(&quot;https://res.cloudinary.com/dfletli2x/image/upload/icons/sol/paper-plane.svg&quot;); -webkit-mask-image: url(&quot;https://res.cloudinary.com/dfletli2x/image/upload/icons/sol/paper-plane.svg&quot;); mask-repeat: no-repeat; -webkit-mask-repeat: no-repeat; mask-position: center; -webkit-mask-position: center; mask-size: contain; -webkit-mask-size: contain; mask-type: alpha;"></div><span>שלח חשבונית</span></button><button class="flex items-center min-w-fit justify-center font-medium rounded-md flex-nowrap border text-black border-gray-200 bg-white hover:bg-gray-100/60 h-10 px-4 gap-3" data-testid="post-issue-send-banner-later"><span>מאוחר יותר</span></button></div></section>",
