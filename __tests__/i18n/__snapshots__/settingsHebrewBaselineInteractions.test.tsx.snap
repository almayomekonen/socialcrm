    ],
    [
      "cancelRenewal",
    ],
    [
      "cancelRenewal",
    ],
    [
      "resumeRenewal",
    ],
  ],
  "cancelDialog": "<div role="dialog" aria-modal="true" aria-label="ביטול המנוי" tabindex="-1" class="overflow-y-auto bg-white shadow-2xl relative popin overflow-x-hidden scrollbar-slim outline-none p-8 max-h-[90vh] rounded-lg w-[min(90vw,28rem)]"><button class="absolute top-2 left-2" title="יציאה ללא שמירה" aria-label="סגירה"><div aria-hidden="true" class="dark:bg-white size-[22px] bg-red-700 " style="mask-image: url(&quot;https://res.cloudinary.com/dfletli2x/image/upload/icons/lit/circle-xmark.svg&quot;); -webkit-mask-image: url(&quot;https://res.cloudinary.com/dfletli2x/image/upload/icons/lit/circle-xmark.svg&quot;); mask-repeat: no-repeat; -webkit-mask-repeat: no-repeat; mask-position: center; -webkit-mask-position: center; mask-size: contain; -webkit-mask-size: contain; mask-type: alpha;"></div></button><div dir="rtl" class="flex flex-col gap-4 p-1"><h2 class="text-xl font-bold">לבטל את המשך המנוי?</h2><p class="text-sm text-gray-700">לא יבוצע חיוב של ₪89. הגישה נמשכת עד סוף התקופה הנוכחית, והלידים והנתונים שלך יישמרו.</p><div class="flex items-center gap-2"><button class="flex items-center min-w-fit justify-center font-medium rounded-md flex-nowrap bg-solid text-white hover:bg-solid/85 h-10 px-4 gap-3"><span>ביטול המנוי</span></button><button class="flex items-center min-w-fit justify-center font-medium rounded-md flex-nowrap border text-black border-gray-200 bg-white hover:bg-gray-100/60 h-10 px-4 gap-3"><span>חזרה</span></button></div></div></div>",
  "cancelError_boom": "<p class="text-sm text-red-500" role="alert">אירעה שגיאה, נסו שוב</p>",
  "cancelError_no_subscription": "<p class="text-sm text-red-500" role="alert">לא נמצא מנוי פעיל</p>",
  "cancelError_reactivation_required": "<p class="text-sm text-red-500" role="alert">הגישה כבר הסתיימה. כדי לחדש יש לאשר אמצעי תשלום מחדש בעמוד הכניסה למערכת.</p>",
  "chargeInProgressNotice": "<p class="text-sm text-amber-800 bg-amber-50 border border-amber-200 rounded-lg px-3 py-2" role="status">הביטול נרשם. החיוב האחרון כבר נשלח לעיבוד ואי אפשר לעצור אותו — נעדכן ברגע שתתקבל תשובה.</p>",
  "replace": "<div class="mb-6 max-w-3xl p-6 bg-white rounded-lg border border-gray-200 flex flex-col gap-3" dir="rtl"><div class="flex items-center justify-between gap-4 flex-wrap"><p class="text-lg font-semibold">אמצעי תשלום</p><span class="rounded-full px-2.5 py-0.5 text-xs font-medium border bg-gray-50 border-gray-200 text-gray-700">חיוב חודשי פעיל</span></div><p class="text-sm text-gray-700">כרטיס שמור · Visa •••• 4242</p><p class="text-sm text-gray-700">החיוב הבא: ₪89 ב־01/11/2026, ומדי חודש לאחר מכן.</p><p class="text-sm text-gray-600">החיוב הקרוב ממתין לביצוע.</p><div class="flex flex-col gap-3"><p class="text-sm text-gray-700">הכרטיס החדש יישמר במקום הקיים, והחיוב החודשי יימשך ממנו.</p><label class="has-[:checked]:bg-solid/5 grid grid-cols-[16px_1fr] items-center gap-4 min-h-10 cursor-pointer bg-white px-4 py-2 rounded-md border border-gray-200 w-auto"><input class="size-4 accent-solid" type="checkbox"><p>אני מאשר/ת שפרטי הכרטיס יישמרו באופן מאובטח אצל ספק הסליקה Grow, ושניתן יהיה לחייב אותו בעתיד עבור המנוי</p></label><div class="flex gap-2"><button class="flex items-center min-w-fit justify-center font-medium rounded-md flex-nowrap bg-solid text-white hover:bg-solid/85 h-10 px-4 gap-3" disabled=""><span>המשך להחלפת הכרטיס</span></button><button class="flex items-center min-w-fit justify-center font-medium rounded-md flex-nowrap border text-black border-gray-200 bg-white hover:bg-gray-100/60 h-10 px-4 gap-3"><span>חזרה</span></button></div></div></div>",
  "replaceError": "<p class="text-sm text-red-500" role="alert">לא הצלחנו לפתוח את דף התשלום. נסו שוב בעוד רגע.</p>",
}
`;

