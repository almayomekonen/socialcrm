exports[`Hebrew baseline — guides > every guide article; unknown slug > article — ai-assistant 1`] = `"<article><p class="text-xs font-medium text-gray-400">עוזר חכם</p><h1 class="mt-1 text-2xl font-bold text-ink">העוזר החכם</h1><p class="mt-2 text-sm leading-relaxed text-gray-500">מה העוזר החכם יודע לעשות ומה הוא לא עושה.</p><section class="mt-7"><h2 class="text-base font-bold text-ink">מה הוא עושה</h2><p class="mt-2 text-sm leading-relaxed text-gray-600">מסכם שיחות, מציע צעד הבא, ועוזר לנסח הודעה — תמיד על בסיס הנתונים שבמערכת.</p></section><section class="mt-7"><h2 class="text-base font-bold text-ink">מה הוא לא עושה</h2><p class="mt-2 text-sm leading-relaxed text-gray-600">הוא לא שולח הודעות ללקוחות בלי שתאשרו, ולא ממציא נתונים שאינם במערכת.</p></section></article><div class="mt-10 border-t border-gray-100 pt-5"><p class="text-sm text-gray-500">זה לא פתר את הבעיה? <a class="font-medium text-primary-text hover:underline" href="/support/new?kind=problem">ספרו לנו מה קרה</a></p></div>"`;

exports[`Hebrew baseline — guides > every guide article; unknown slug > article — automations-overview 1`] = `"<article><p class="text-xs font-medium text-gray-400">אוטומציות</p><h1 class="mt-1 text-2xl font-bold text-ink">איך עובדות אוטומציות</h1><p class="mt-2 text-sm leading-relaxed text-gray-500">מה אוטומציה עושה, מתי היא רצה, ואיך לבדוק שהיא פעלה.</p><section class="mt-7"><h2 class="text-base font-bold text-ink">העיקרון</h2><p class="mt-2 text-sm leading-relaxed text-gray-600">אוטומציה מחכה לאירוע — למשל ליד חדש — ומבצעת פעולה אחת, כמו שליחת הודעה.</p></section><section class="mt-7"><h2 class="text-base font-bold text-ink">בדיקה</h2><p class="mt-2 text-sm leading-relaxed text-gray-600">בהגדרות ואז אוטומציות אפשר לראות מתי כל אוטומציה רצה לאחרונה.</p></section></article><div class="mt-10 border-t border-gray-100 pt-5"><p class="text-sm text-gray-500">זה לא פתר את הבעיה? <a class="font-medium text-primary-text hover:underline" href="/support/new?kind=problem">ספרו לנו מה קרה</a></p></div>"`;

exports[`Hebrew baseline — guides > every guide article; unknown slug > article — connect-facebook-instagram 1`] = `"<article><p class="text-xs font-medium text-gray-400">Facebook ו-Instagram</p><h1 class="mt-1 text-2xl font-bold text-ink">חיבור Facebook ו-Instagram</h1><p class="mt-2 text-sm leading-relaxed text-gray-500">איך לחבר עמוד וטפסי לידים כדי שלידים ייכנסו למערכת אוטומטית.</p><section class="mt-7"><h2 class="text-base font-bold text-ink">מה מתחבר</h2><p class="mt-2 text-sm leading-relaxed text-gray-600">החיבור מאפשר לקבל לידים מטפסי הלידים של Facebook ו-Instagram ישירות לרשימת הלידים.</p></section><section class="mt-7"><h2 class="text-base font-bold text-ink">שלבי החיבור</h2><p class="mt-2 text-sm leading-relaxed text-gray-600">נכנסים להגדרות ואז לאינטגרציות ולוחצים על חיבור Facebook.</p><p class="mt-2 text-sm leading-relaxed text-gray-600">מאשרים את ההרשאות ובוחרים את העמוד שממנו מגיעים הלידים.</p></section></article><div class="mt-10 border-t border-gray-100 pt-5"><p class="text-sm text-gray-500">זה לא פתר את הבעיה? <a class="font-medium text-primary-text hover:underline" href="/support/new?kind=problem">ספרו לנו מה קרה</a></p></div>"`;

exports[`Hebrew baseline — guides > every guide article; unknown slug > article — connect-whatsapp 1`] = `"<article><p class="text-xs font-medium text-gray-400">WhatsApp</p><h1 class="mt-1 text-2xl font-bold text-ink">חיבור WhatsApp למערכת</h1><p class="mt-2 text-sm leading-relaxed text-gray-500">איך לחבר מספר WhatsApp עסקי כדי שהודעות מלקוחות ייכנסו לשיחות.</p><section class="mt-7"><h2 class="text-base font-bold text-ink">לפני שמתחילים</h2><p class="mt-2 text-sm leading-relaxed text-gray-600">צריך מספר WhatsApp עסקי שאינו מחובר כרגע לאפליקציית WhatsApp Business רגילה.</p><p class="mt-2 text-sm leading-relaxed text-gray-600">החיבור נעשה פעם אחת, ומשם ההודעות נכנסות אוטומטית.</p></section><section class="mt-7"><h2 class="text-base font-bold text-ink">שלבי החיבור</h2><p class="mt-2 text-sm leading-relaxed text-gray-600">נכנסים להגדרות ואז לאינטגרציות.</p><p class="mt-2 text-sm leading-relaxed text-gray-600">לוחצים על חיבור WhatsApp ומשלימים את ההרשמה בחלון שנפתח.</p><p class="mt-2 text-sm leading-relaxed text-gray-600">בסיום מופיע סטטוס &quot;מקבל אירועים&quot; בכרטיס החיבור.</p></section></article><div class="mt-10 border-t border-gray-100 pt-5"><p class="text-sm text-gray-500">זה לא פתר את הבעיה? <a class="font-medium text-primary-text hover:underline" href="/support/new?kind=problem">ספרו לנו מה קרה</a></p></div>"`;

exports[`Hebrew baseline — guides > every guide article; unknown slug > article — import-leads-excel 1`] = `"<article><p class="text-xs font-medium text-gray-400">לידים</p><h1 class="mt-1 text-2xl font-bold text-ink">ייבוא לידים מקובץ Excel</h1><p class="mt-2 text-sm leading-relaxed text-gray-500">איך להעלות רשימת לידים קיימת כדי להתחיל לעבוד מיד.</p><section class="mt-7"><h2 class="text-base font-bold text-ink">הכנת הקובץ</h2><p class="mt-2 text-sm leading-relaxed text-gray-600">הקובץ צריך לכלול לפחות שם וטלפון בכל שורה.</p><p class="mt-2 text-sm leading-relaxed text-gray-600">עמודות נוספות כמו אימייל ומקור הליד ייובאו אם הן קיימות.</p></section><section class="mt-7"><h2 class="text-base font-bold text-ink">העלאה</h2><p class="mt-2 text-sm leading-relaxed text-gray-600">בעמוד הלידים בוחרים &quot;העלה לידים&quot; ומצרפים את הקובץ.</p></section></article><div class="mt-10 border-t border-gray-100 pt-5"><p class="text-sm text-gray-500">זה לא פתר את הבעיה? <a class="font-medium text-primary-text hover:underline" href="/support/new?kind=problem">ספרו לנו מה קרה</a></p></div>"`;

exports[`Hebrew baseline — guides > every guide article; unknown slug > article — invite-team-members 1`] = `"<article><p class="text-xs font-medium text-gray-400">חשבון והגדרות</p><h1 class="mt-1 text-2xl font-bold text-ink">הוספת נציגים לצוות</h1><p class="mt-2 text-sm leading-relaxed text-gray-500">איך להזמין נציג חדש ומה הוא יראה.</p><section class="mt-7"><h2 class="text-base font-bold text-ink">הזמנה</h2><p class="mt-2 text-sm leading-relaxed text-gray-600">בהגדרות ואז משתמשים מזינים שם ואימייל ושולחים הזמנה.</p></section><section class="mt-7"><h2 class="text-base font-bold text-ink">מה הנציג רואה</h2><p class="mt-2 text-sm leading-relaxed text-gray-600">נציג רואה את הלידים שהוקצו לו; מנהל רואה את כל הלידים.</p></section></article><div class="mt-10 border-t border-gray-100 pt-5"><p class="text-sm text-gray-500">זה לא פתר את הבעיה? <a class="font-medium text-primary-text hover:underline" href="/support/new?kind=problem">ספרו לנו מה קרה</a></p></div>"`;

exports[`Hebrew baseline — guides > every guide article; unknown slug > article — lead-statuses 1`] = `"<article><p class="text-xs font-medium text-gray-400">לידים</p><h1 class="mt-1 text-2xl font-bold text-ink">סטטוסים של לידים</h1><p class="mt-2 text-sm leading-relaxed text-gray-500">מה המשמעות של כל סטטוס ומתי לעדכן אותו.</p><section class="mt-7"><h2 class="text-base font-bold text-ink">למה זה חשוב</h2><p class="mt-2 text-sm leading-relaxed text-gray-600">הסטטוס הוא מה שמאפשר לדעת למי צריך לחזור היום ומה כבר טופל.</p></section><section class="mt-7"><h2 class="text-base font-bold text-ink">מתי לעדכן</h2><p class="mt-2 text-sm leading-relaxed text-gray-600">מיד אחרי שיחה או הודעה — עדכון לוקח שניות וחוסך בלבול מאוחר יותר.</p></section></article><div class="mt-10 border-t border-gray-100 pt-5"><p class="text-sm text-gray-500">זה לא פתר את הבעיה? <a class="font-medium text-primary-text hover:underline" href="/support/new?kind=problem">ספרו לנו מה קרה</a></p></div>"`;

exports[`Hebrew baseline — guides > every guide article; unknown slug > article — subscription-and-billing 1`] = `"<article><p class="text-xs font-medium text-gray-400">מנוי ותשלום</p><h1 class="mt-1 text-2xl font-bold text-ink">מנוי ותשלום</h1><p class="mt-2 text-sm leading-relaxed text-gray-500">איך לראות את המנוי, לשדרג, ולעדכן אמצעי תשלום.</p><section class="mt-7"><h2 class="text-base font-bold text-ink">איפה זה נמצא</h2><p class="mt-2 text-sm leading-relaxed text-gray-600">בהגדרות ואז מנוי ותשלום מופיעים מצב המנוי וההיסטוריה.</p></section><section class="mt-7"><h2 class="text-base font-bold text-ink">שדרוג</h2><p class="mt-2 text-sm leading-relaxed text-gray-600">השדרוג נכנס לתוקף מיד והנתונים הקיימים נשמרים כפי שהם.</p></section></article><div class="mt-10 border-t border-gray-100 pt-5"><p class="text-sm text-gray-500">זה לא פתר את הבעיה? <a class="font-medium text-primary-text hover:underline" href="/support/new?kind=problem">ספרו לנו מה קרה</a></p></div>"`;

exports[`Hebrew baseline — guides > every guide article; unknown slug > article — website-form-connection 1`] = `"<article><p class="text-xs font-medium text-gray-400">אינטגרציות</p><h1 class="mt-1 text-2xl font-bold text-ink">חיבור טופס מהאתר</h1><p class="mt-2 text-sm leading-relaxed text-gray-500">איך לחבר טופס יצירת קשר באתר כך שפניות ייכנסו כלידים.</p><section class="mt-7"><h2 class="text-base font-bold text-ink">מה צריך</h2><p class="mt-2 text-sm leading-relaxed text-gray-600">בהגדרות ואז אינטגרציות יוצרים חיבור לאתר ומקבלים כתובת וקוד סודי.</p></section><section class="mt-7"><h2 class="text-base font-bold text-ink">אם פניות נדחות</h2><p class="mt-2 text-sm leading-relaxed text-gray-600">אם מופיע &quot;פניות נדחות&quot;, הקוד הסודי באתר כנראה השתנה — יוצרים חיבור חדש ומעדכנים אותו באתר.</p></section></article><div class="mt-10 border-t border-gray-100 pt-5"><p class="text-sm text-gray-500">זה לא פתר את הבעיה? <a class="font-medium text-primary-text hover:underline" href="/support/new?kind=problem">ספרו לנו מה קרה</a></p></div>"`;

exports[`Hebrew baseline — guides > every guide article; unknown slug > article — whatsapp-not-receiving 1`] = `"<article><p class="text-xs font-medium text-gray-400">WhatsApp</p><h1 class="mt-1 text-2xl font-bold text-ink">הודעות WhatsApp לא נכנסות</h1><p class="mt-2 text-sm leading-relaxed text-gray-500">מה לבדוק כשהחיבור קיים אבל הודעות חדשות לא מגיעות לשיחות.</p><section class="mt-7"><h2 class="text-base font-bold text-ink">בדיקה ראשונה</h2><p class="mt-2 text-sm leading-relaxed text-gray-600">פותחים הגדרות ואז אינטגרציות ומסתכלים על הסטטוס בכרטיס WhatsApp.</p><p class="mt-2 text-sm leading-relaxed text-gray-600">אם כתוב &quot;החיבור נותק&quot; צריך לחבר מחדש — ההרשאה פגה.</p></section><section class="mt-7"><h2 class="text-base font-bold text-ink">אם הסטטוס תקין</h2><p class="mt-2 text-sm leading-relaxed text-gray-600">שולחים הודעת בדיקה מטלפון אחר ובודקים אם היא מופיעה בשיחות תוך דקה.</p></section></article><div class="mt-10 border-t border-gray-100 pt-5"><p class="text-sm text-gray-500">זה לא פתר את הבעיה? <a class="font-medium text-primary-text hover:underline" href="/support/new?kind=problem">ספרו לנו מה קרה</a></p></div>"`;

