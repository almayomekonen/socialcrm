exports[`Hebrew baseline — the phone lead list (/leads on a phone) > filtered empty (search, status), the empty workspace for each connection state 1`] = `
{
  "firstRun": "<div data-testid="header-action"></div><div dir="rtl" class="flex flex-col px-4 py-6"><header class="mb-6"><h1 class="text-xl font-bold leading-tight text-ink">סביבת העבודה שלכם פתוחה, עכשיו נכניס את הלידים</h1><p class="mt-1.5 text-sm leading-relaxed text-gray-500">SocialCRM מרכז את הלידים מוואטסאפ וממודעות פייסבוק ואינסטגרם לרשימה אחת, עם סטטוס ומעקב לכל ליד.</p></header><section class="mb-7"><h2 class="text-sm font-semibold text-ink">הכניסו את הלידים שיש לכם עכשיו</h2><p class="mb-2.5 mt-0.5 text-[13px] leading-relaxed text-gray-500">תוך דקה תראו רשימה אחת של כל מי שצריך לחזור אליו.</p><div class="overflow-hidden rounded-xl border border-primary/40 bg-primary-tint/50"><div class="divide-y divide-gray-100 "><button type="button" class="flex w-full min-h-16 items-center gap-3 px-4 py-3 text-start transition-colors hover:bg-gray-50 active:bg-gray-100 focus:outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-primary  press"><div class="shrink-0"><span class="flex size-9 items-center justify-center rounded-lg bg-[#217346]"><div aria-hidden="true" class="dark:bg-white size-4 bg-white " style="mask-image:url(https://res.cloudinary.com/dfletli2x/image/upload/icons/sol/file-excel.svg);-webkit-mask-image:url(https://res.cloudinary.com/dfletli2x/image/upload/icons/sol/file-excel.svg);mask-repeat:no-repeat;-webkit-mask-repeat:no-repeat;mask-position:center;-webkit-mask-position:center;mask-size:contain;-webkit-mask-size:contain;mask-type:alpha"></div></span></div><div class="min-w-0 flex-1"><div class="flex items-baseline gap-2"><span class="truncate text-[15px] leading-tight text-ink font-semibold">הרשימה שלכם, מסודרת</span></div><p class="mt-0.5 truncate text-[13px] leading-tight text-gray-500">קובץ אקסל, או פשוט הדביקו מספרי טלפון</p><div class="mt-1.5 flex flex-wrap items-center gap-1.5"><span class="rounded-full bg-info-bg px-2 py-0.5 text-[11px] font-medium text-info-text">הכי מהיר</span></div></div><div class="flex shrink-0 ite