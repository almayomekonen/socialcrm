r font-medium rounded-md flex-nowrap border text-black border-gray-200 bg-white hover:bg-gray-100/60 h-10 px-4 gap-3 tabular-nums" aria-haspopup="menu" aria-expanded="false"><div aria-hidden="true" class="dark:bg-white bg-black size-4 " style="mask-image:url(https://res.cloudinary.com/dfletli2x/image/upload/icons/reg/calendar.svg);-webkit-mask-image:url(https://res.cloudinary.com/dfletli2x/image/upload/icons/reg/calendar.svg);mask-repeat:no-repeat;-webkit-mask-repeat:no-repeat;mask-position:center;-webkit-mask-position:center;mask-size:contain;-webkit-mask-size:contain;mask-type:alpha"></div><span>קבע מעקב</span></button></div></div><p class="text-sm text-gray-800 truncate tabular-nums mt-2">לא נקבע מעקב</p><div class="mt-3 pt-3 border-t border-gray-100"><div class="flex flex-wrap items-center gap-2"><span class="text-xs text-gray-500">תוצאת שיחה:</span><button class="flex items-center min-w-fit justify-center font-medium rounded-md flex-nowrap border text-black border-gray-200 bg-white hover:bg-gray-100/60 h-9 px-3 gap-3 text-[15px]"><span>לא ענה</span></button><button class="flex items-center min-w-fit justify-center font-medium rounded-md flex-nowrap border text-black border-gray-200 bg-white hover:bg-gray-100/60 h-9 px-3 gap-3 text-[15px]"><span>דיברנו</span></button><button class="flex items-center min-w-fit justify-center font-medium rounded-md flex-nowrap border text-black border-gray-200 bg-white hover:bg-gray-100/60 h-9 px-3 gap-3 text-[15px]"><span>מעוניין</span></button><button class="flex items-center min-w-fit justify-center font-medium rounded-md flex-nowrap bg-transparent text-black hover:bg-gray-100/60 h-9 px-3 gap-3 text-[15px]"><span>לא מעוניין</span></button></div></div></div></div><!--/$--><!--$--><div class="mb-8 flex justify-end"><button class="flex items-center min-w-fit justify-center font-medium rounded-md flex-nowrap border text-black border-gray-200 bg-white hover:bg-gray-100/60 h-9 px-3 gap-3 text-[15px] w-fit"><div aria-hidden="true" class="dark:bg-white bg-black size-[15px] " style="mask-image:url(https://res.cloudinary.com/dfletli2x/image/upload/icons/reg/paper-plane.svg);-webkit-mask-image:url(https://res.cloudinary.com/dfletli2x/image/upload/icons/reg/paper-plane.svg);mask-repeat:no-repeat;-webkit-mask-repeat:no-repeat;mask-position:center;-webkit-mask-position:center;mask-size:contain;-webkit-mask-size:contain;mask-type:alpha"></div><span>שלח הודעה מוכנה</span></button></div><!--/$--><!--$--><div class="rounded-lg border border-gray-200 bg-white p-5 mb-8" style="min-height:200px"><style>
