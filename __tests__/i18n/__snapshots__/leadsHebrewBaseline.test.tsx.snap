  "dupStrong": "<div class="mb-4 rounded-lg border px-4 py-3 border-amber-300 bg-amber-50"><div class="flex items-start justify-between gap-3"><p class="text-sm font-semibold text-amber-900">ייתכן שהליד הזה כבר קיים במערכת</p><button type="button" class="shrink-0 text-xs text-gray-500 hover:text-gray-700">הסתר</button></div><ul class="mt-2 grid gap-2"><li class="rounded-md border border-gray-200 bg-white px-3 py-2 text-sm"><div class="flex items-center justify-between gap-2"><span class="font-medium text-gray-900">אבי מזרחי</span><span class="text-xs text-gray-500">בטיפול</span></div><div class="mt-0.5 text-xs text-gray-500">0501234567 · avi@example.test</div><div class="mt-1 text-xs text-gray-600">מספר טלפון זהה · תעודת זהות זהה</div></li><li class="rounded-md border border-gray-200 bg-white px-3 py-2 text-sm"><div class="flex items-center justify-between gap-2"><span class="font-medium text-gray-900">ליד ללא שם</span><span class="text-xs text-gray-500">לא רלוונטי</span></div><div class="mt-0.5 text-xs text-gray-500">x@example.test</div><div class="mt-1 text-xs text-gray-600">כתובת מייל זהה</div></li></ul><p class="mt-2 text-xs text-amber-800">אם זה אותו ליד, אפשר לבטל ולעדכן את הליד הקיים. אחרת, אפשר להמשיך ולשמור.</p></div>",
  "edit": "<div><div class="inline-flex items-center gap-4 border-b pb-2 border-gray-400 mb-6"><p class="text-lg font-semibold">עריכת ליד</p></div><form id="clientForm"><div class="max-w-4xl" data-prefix=""><div class="flex items-start flex-col gap-3"><div class="flex w-full gap-3"><div class="flex-3 min-w-0"><div class="block"><div class="flex justify-between mb-1 ms-1 items-end "><label for="«id»" class="text-gray-600 text-sm font-medium ">שם פרטי</label></div><input id="«id»" class="h-10 w-full rounded-md border bg-white focus:outline-2 focus:outline-offset-0 disabled:opacity-50 border-gray-200 focus:outline-primary px-2.5" required="" name="firstName" value="אבי"/></div></div><div class="flex-3 min-w-0"><div class="block"><div class="flex justify-between mb-1 ms-1 items-end "><label for="«id»" class="text-gray-600 text-sm font-medium ">שם משפחה</label></div><input id="«id»" class="h-10 w-full rounded-md border bg-white focus:outline-2 focus:outline-offset-0 disabled:opacity-50 border-gray-200 focus:outline-primary px-2.5" required="" name="lastName" value="מזרחי"/></div></div><div class="flex-2 min-w-0"><div class="block"><div class="flex justify-between mb-1 ms-1 items-end "><label for="«id»" class="text-gray-600 text-sm font-medium ">מין</label></div><select id="«id»" class="h-10 w-full rounded-md border bg-white focus:outline-2 focus:outline-offset-0 disabled:opacity-50 border-gray-200 focus:outline-primary pe-8 ps-2" name="gender"><option value="זכר">זכר</option><option value="נקבה">נקבה</option></select></div></div></div><div class="flex w-full gap-3"><div class="flex-3 min-w-0"><div class="block"><div class="flex justify-between mb-1 ms-1 items-end "><label for="«id»" class="text-gray-600 text-sm font-medium ">טלפון נייד</label></div><input id="«id»" class="h-10 w-full rounded-md border bg-white focus:outline-2 focus:outline-offset-0 disabled:opacity-50 border-gray-200 focus:outline-primary px-2.5" type="tel" name="phone" value="0501234567"/></div></div><div class="flex-3 min-w-0"><div class="block"><div class="flex justify-between mb-1 ms-1 items-end "><label for="«id»" class="text-gray-600 text-sm font-medium ">מייל</label></div><input id="«id»" class="h-10 w-full rounded-md border bg-white focus:outline-2 focus:outline-offset-0 disabled:opacity-50 border-gray-200 focus:outline-primary px-2.5" type="email" name="email" value="dana@example.test"/></div></div><div class="flex-2 min-w-0"><div class="block"><div class="flex justify-between mb-1 ms-1 items-end "><label for="«id»" class="text-gray-600 text-sm font-medium ">תאריך לידה</label></div><input id="«id»" class="h-10 w-full rounded-md border bg-white focus:outline-2 focus:outline-offset-0 disabled:opacity-50 border-gray-200 focus:outline-primary px-2.5" type="date" name="birthDate" value="1990-05-01"/></div></div></div><div class="flex w-full gap-3"><div class="flex-3 min-w-0"><div class="block"><div class="flex justify-between mb-1 ms-1 items-end "><label for="«id»" class="text-gray-600 text-sm font-medium ">מקור הליד</label></div><input id="«id»" class="h-10 w-full rounded-md border bg-white focus:outline-2 focus:outline-offset-0 disabled:opacity-50 border-gray-200 focus:outline-primary px-2.5" name="leadSource" value="manual"/></div></div><div class="flex-3 min-w-0"><div class="block"><div class="flex justify-between mb-1 ms-1 items-end "><label for="«id»" class="text-gray-600 text-sm font-medium ">סטטוס</label></div><select id="«id»" class="h-10 w-full rounded-md border bg-white focus:outline-2 focus:outline-offset-0 disabled:opacity-50 border-gray-200 focus:outline-primary pe-8 ps-2" name="status"><option value="new" selected="">חדש</option><option value="contacted">בטיפול</option><option value="interested">מתעניין</option><option value="closed">נסגר</option><option value="lost">לא רלוונטי</option></select></div></div><div class="flex-2 min-w-0"><div class="block"><div class="flex justify-between mb-1 ms-1 items-end "><label for="«id»" class="text-gray-600 text-sm font-medium ">סטטוס</label></div><select id="«id»" class="h-10 w-full rounded-md border bg-white focus:outline-2 focus:outline-offset-0 disabled:opacity-50 border-gray-200 focus:outline-primary pe-8 ps-2" name="lead"><option value="false">לקוח</option><option value="true" selected="">ליד</option></select></div></div></div><div class="accordion w-full"><details name="x" class="group/acrdn border-b-2 last:border-b-0"><summary><div class="flex items-center gap-2"><p class="group-open/acrdn:text-solid">מידע נוסף</p></div><div aria-hidden="true" class="bg-gray-800 size-[18.5px] dark:bg-white duration-200 group-hover/acrdn:bg-gray-950 group-open/acrdn:rotate-90 group-open/acrdn:bg-solid " style="mask-image:url(https://res.cloudinary.com/dfletli2x/image/upload/icons/lit/chevron-left.svg);-webkit-mask-image:url(https://res.cloudinary.com/dfletli2x/image/upload/icons/lit/chevron-left.svg);mask-repeat:no-repeat;-webkit-mask-repeat:no-repeat;mask-position:center;-webkit-mask-position:center;mask-size:contain;-webkit-mask-size:contain;mask-type:alpha"></div></summary><div class="p-4 pt-1"><div class="flex w-full gap-3"><div class="flex-3 min-w-0"><div class="block"><div class="flex justify-between mb-1 ms-1 items-end "><label for="«id»" class="text-gray-600 text-sm font-medium ">מס&#x27; תעודת זהות</label></div><input id="«id»" class="h-10 w-full rounded-md border bg-white focus:outline-2 focus:outline-offset-0 disabled:opacity-50 border-gray-200 focus:outline-primary px-2.5" type="number" name="idNum" value="123456782"/></div></div><div class="flex-3 min-w-0"><div class="block"><div class="flex justify-between mb-1 ms-1 items-end "><label for="«id»" class="text-gray-600 text-sm font-medium ">טלפון נוסף</label></div><input id="«id»" class="h-10 w-full rounded-md border bg-white focus:outline-2 focus:outline-offset-0 disabled:opacity-50 border-gray-200 focus:outline-primary px-2.5" type="tel" name="secPhone" value="0529876543"/></div></div></div></div></details></div></div></div><button class="flex items-center min-w-fit justify-center font-medium rounded-md flex-nowrap bg-solid text-white hover:bg-solid/85 h-10 px-4 gap-3 w-full mt-8"><div aria-hidden="true" class="dark:bg-white bg-white size-4 " style="mask-image:url(https://res.cloudinary.com/dfletli2x/image/upload/icons/sol/floppy-disk.svg);-webkit-mask-image:url(https://res.cloudinary.com/dfletli2x/image/upload/icons/sol/floppy-disk.svg);mask-repeat:no-repeat;-webkit-mask-repeat:no-repeat;mask-position:center;-webkit-mask-position:center;mask-size:contain;-webkit-mask-size:contain;mask-type:alpha"></div><span>שמירה</span></button></form></div>",
}
`;

exports[`Hebrew baseline — list-page components > CrmSyncBanner: connection problem with and without retry, subscription lapsed 1`] = `
{
  "compact": "<div role="status" aria-live="polite" class="flex items-center justify-between gap-2 border-b border-amber-300 bg-amber-50 px-3 py-2 text-xs"><p class="font-semibold text-amber-900 text-xs leading-snug">בעיית חיבור. מנסים שוב</p><button type="button" class="shrink-0 rounded-md bg-solid px-3 py-1.5 text-xs font-semibold text-white hover:bg-solid/85">נסה שוב</button></div>",
  "lapsed": "<div class="mb-4"><div data-testid="subscription-expired-inline" class="flex flex-wrap items-center gap-3 rounded-lg border border-warning-border bg-warning-bg px-3.5 py-3 "><div aria-hidden="true" class="dark:bg-white size-4 shrink-0 bg-warning-text " style="mask-image: url(&quot;https://res.cloudinary.com/dfletli2x/image/upload/icons/sol/lock.svg&quot;); -webkit-mask-image: url(&quot;https://res.cloudinary.com/dfletli2x/image/upload/icons/sol/lock.svg&quot;); mask-repeat: no-repeat; -webkit-mask-repeat: no-repeat; mask-position: center; -webkit-mask-position: center; mask-size: contain; -webkit-mask-size: contain; mask-type: alpha;"></div><p class="min-w-0 flex-1 text-[13px] leading-snug text-warning-text">חידוש המנוי מחזיר את הסנכרון החי</p><a href="/settings/update_payment?source=crm_sync_banner" class="shrink-0 text-[13px] font-semibold text-warning-text underline underline-offset-2">חידוש מנוי</a></div></div>",
  "noRetry": "<div role="status" aria-live="polite" class="mb-4 flex items-center justify-between gap-4 rounded-lg border border-amber-300 bg-amber-50 px-4 py-3"><p class="font-semibold text-amber-900 text-sm">בעיית חיבור. מנסים שוב</p></div>",
  "retry": "<div role="status" aria-live="polite" class="mb-4 flex items-center justify-between gap-4 rounded-lg border border-amber-300 bg-amber-50 px-4 py-3"><p class="font-semibold text-amber-900 text-sm">בעיית חיבור. מנסים שוב</p><button type="button" class="shrink-0 rounded-md bg-solid px-4 py-2 text-sm font-semibold text-white hover:bg-solid/85">נסה שוב</button></div>",
}
`;

