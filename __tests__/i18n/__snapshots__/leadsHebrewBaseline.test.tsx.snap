  "listFormEdit": "<div popover="auto" id="listForm" class="pop min-w-96 overflow-hidden"><form><div class="flex justify-between items-center"><div class="inline-flex items-center gap-4 border-b pb-2 border-gray-400"><p class="text-lg font-semibold">עריכת רשימה</p></div><button class="flex items-center min-w-fit justify-center font-medium rounded-md flex-nowrap border text-black border-gray-200 bg-white hover:bg-gray-100/60 size-10 p-0" aria-label="מחיקת רשימה"><div aria-hidden="true" class="dark:bg-white bg-black size-4 " style="mask-image:url(https://res.cloudinary.com/dfletli2x/image/upload/icons/reg/trash.svg);-webkit-mask-image:url(https://res.cloudinary.com/dfletli2x/image/upload/icons/reg/trash.svg);mask-repeat:no-repeat;-webkit-mask-repeat:no-repeat;mask-position:center;-webkit-mask-position:center;mask-size:contain;-webkit-mask-size:contain;mask-type:alpha"></div></button></div><div class="py-4"><div class="block"><div class="flex justify-between mb-1 ms-1 items-end "><label for="«id»" class="text-gray-600 text-sm font-medium ">שם הרשימה</label></div><input id="«id»" class="h-10 w-full rounded-md border bg-white focus:outline-2 focus:outline-offset-0 disabled:opacity-50 border-gray-200 focus:outline-primary px-2.5 mb-2" required="" name="title" value="לקוחות חמים"/></div><div class="relative undefined"><div class="block"><div class="flex justify-between mb-1 ms-1 items-end "><label for="«id»" data-tip="דנה כהן, יוסי לוי, מיכל אברהם" class="text-gray-600 text-sm font-medium ">בחר לידים (3)</label></div><input id="«id»" class="h-10 w-full rounded-md border bg-white focus:outline-2 focus:outline-offset-0 disabled:opacity-50 border-gray-200 focus:outline-primary px-2.5" placeholder="חיפוש" autoComplete="off"/></div><div class="block"><input id="«id»" class="h-10 w-full rounded-md border bg-white focus:outline-2 focus:outline-offset-0 disabled:opacity-50 border-gray-200 focus:outline-primary px-2.5 absolute bottom-0 right-0 -z-50" name="clientIds[,]" value="1,2,