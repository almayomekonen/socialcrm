exports[`Hebrew baseline — the card return page > CardSetupVerifier: every state 1`] = `
{
  "failed": "<div dir="rtl" class="w-full max-w-md bg-white rounded-lg border border-gray-200 p-6 flex flex-col gap-4 text-center"><h1 class="text-xl font-bold">לא הצלחנו לאמת את הכרטיס</h1><p class="text-sm text-gray-600">לא בוצע חיוב. אפשר לנסות שוב עם אותו כרטיס או עם כרטיס אחר.</p><button class="flex items-center min-w-fit font-medium rounded-md flex-nowrap bg-solid text-white hover:bg-solid/85 h-11 px-5 gap-4 text-lg w-full justify-center"><span>לעמוד המנוי</span></button></div>",
  "reactivate": "<div dir="rtl" class="w-full max-w-md bg-white rounded-lg border border-gray-200 p-6 flex flex-col gap-4 text-center"><h1 class="text-xl font-bold">המנוי חודש</h1><p class="text-sm font-semibold text-amber-800" role="status">בדיקת סליקה בסביבת Sandbox — לא בוצעה עסקה אמיתית ולא נשמר כרטיס אמיתי.</p><p class="text-sm text-gray-600">הפרטים נשמרו. אפשר להמשיך לעבוד.</p><button class="flex items-center min-w-fit font-medium rounded-md flex-nowrap bg-solid text-white hover:bg-solid/85 h-11 px-5 gap-4 text-lg w-full justify-center"><span>כניסה למערכת</span></button></div>",
  "timed out, callback false": "<div dir="rtl" class="w-full max-w-md bg-white rounded-lg border border-gray-200 p-6 flex flex-col gap-4 text-center"><h1 class="text-xl font-bold">האישור עדיין בבדיקה</h1><p class="text-sm text-gray-600">טרם קיבלנו אישור מחברת הסליקה. עדיין לא בוצע חיוב.</p><p class="text-sm text-gray-600">אין צורך להמתין כאן — נעדכן במייל ברגע שהאימות יסתיים, והסטטוס מופיע תמיד בעמוד המנוי.</p><div class="flex flex-col gap-2"><button class="flex items-center min-w-fit font-medium rounded-md flex-nowrap bg-solid text-white hover:bg-solid/85 h-11 px-5 gap-4 text-lg w-full justify-center"><span>לעמוד המנוי</span></button><button class="flex items-center min-w-fit font-medium rounded-md flex-nowrap border text-black border-gray-200 bg-white hover:bg-gray-100/60 h-11 px-5 gap-4 text-lg w-full justify-center"><span>חזרה למערכת</span></button></div></div>",
  "timed out, callback true": "<div dir="rtl" class="w-full max-w-md bg-white rounded-lg border border-gray-200 p-6 flex flex-col gap-4 text-center"><h1 class="text-xl font-bold">האישור עדיין בבדיקה</h1><p class="text-sm text-gray-600">קיבלנו את פרטי הכרטיס ואנחנו מאמתים אותם מול Grow. עדיין לא בוצע חיוב.</p><p class="text-sm text-gray-600">אין צורך להמתין כאן — נעדכן במייל ברגע שהאימות יסתיים, והסטטוס מופיע תמיד בעמוד המנוי.</p><div class="flex flex-col gap-2"><button class="flex items-center min-w-fit font-medium rounded-md flex-nowrap bg-solid text-white hover:bg-solid/85 h-11 px-5 gap-4 text-lg w-full justify-center"><span>לעמוד המנוי</span></button><button class="flex items-center min-w-fit font-medium rounded-md flex-nowrap border text-black border-gray-200 bg-white hover:bg-gray-100/60 h-11 px-5 gap-4 text-lg w-full justify-center"><span>חזרה למערכת</span></button></div></div>",
  "trial charges off": "<div dir="rtl" class="w-full max-w-md bg-white rounded-lg border border-gray-200 p-6 flex flex-col gap-4 text-center"><h1 class="text-xl font-bold">תקופת הניסיון הופעלה</h1><p class="text-sm text-gray-600">הכרטיס נשמר. תקופת הניסיון מסתיימת ב־27/10/2026; חיוב אוטומטי אינו פעיל כרגע, ולכן לא ייגבה תשלום במועד הזה.</p><button class="flex items-center min-w-fit font-medium rounded-md flex-nowrap bg-solid text-white hover:bg-solid/85 h-11 px-5 gap-4 text-lg w-full justify-center"><span>כניסה למערכת</span></button></div>",
  "trial charges on": "<div dir="rtl" class="w-full max-w-md bg-white rounded-lg border border-gray-200 p-6 flex flex-col gap-4 text-center"><h1 class="text-xl font-bold">תקופת הניסיון הופעלה</h1><p class="text-sm text-gray-600">הכרטיס נשמר. החיוב הראשון, ₪89, יתבצע ב־27/10/2026. אפשר לבטל לפני כן בעמוד המנוי.</p><button class="flex items-center min-w-fit font-medium rounded-md flex-nowrap bg-solid text-white hover:bg-solid/85 h-11 px-5 gap-4 text-lg w-full justify-center"><span>כניסה למערכת</span></button></div>",
  "trial no date": "<div dir="rtl" class="w-full max-w-md bg-white rounded-lg border border-gray-200 p-6 flex flex-col gap-4 text-center"><h1 class="text-xl font-bold">תקופת הניסיון הופעלה</h1><button class="flex items-center min-w-fit font-medium rounded-md flex-nowrap bg-solid text-white hover:bg-solid/85 h-11 px-5 gap-4 text-lg w-full justify-center"><span>כניסה למערכת</span></button></div>",
  "trial sandbox": "<div dir="rtl" class="w-full max-w-md bg-white rounded-lg border border-gray-200 p-6 flex flex-col gap-4 text-center"><h1 class="text-xl font-bold">תקופת הניסיון הופעלה</h1><p class="text-sm font-semibold text-amber-800" role="status">בדיקת סליקה בסביבת Sandbox — לא בוצעה עסקה אמיתית ולא נשמר כרטיס אמיתי.</p><p class="text-sm text-gray-600">הכרטיס נשמר. החיוב הראשון, ₪89, יתבצע ב־27/10/2026. אפשר לבטל לפני כן בעמוד המנוי.</p><button class="flex items-center min-w-fit font-medium rounded-md flex-nowrap bg-solid text-white hover:bg-solid/85 h-11 px-5 gap-4 text-lg w-full justify-center"><span>כניסה למערכת</span></button></div>",
  "update": "<div dir="rtl" class="w-full max-w-md bg-white rounded-lg border border-gray-200 p-6 flex flex-col gap-4 text-center"><h1 class="text-xl font-bold">הכרטיס עודכן</h1><p class="text-sm text-gray-600">הפרטים נשמרו. אפשר להמשיך לעבוד.</p><button class="flex items-center min-w-fit font-medium rounded-md flex-nowrap bg-solid text-white hover:bg-solid/85 h-11 px-5 gap-4 text-lg w-full justify-center"><span>כניסה למערכת</span></button></div>",
  "verifying": "<div dir="rtl" class="w-full max-w-md bg-white rounded-lg border border-gray-200 p-6 flex flex-col gap-4 text-center"><h1 class="text-xl font-bold">רק רגע, מאמתים מול חברת הסליקה</h1><p class="text-sm text-gray-600" role="status">הכרטיס נשמר בצד של Grow ואנחנו מאשרים אותו. לא מבוצע חיוב עבור המנוי בשלב הזה; תיתכן הקפאה זמנית של ₪1 לאימות; לפי Grow היא משתחררת בתוך עד 10 ימים.</p></div>",
}
`;

