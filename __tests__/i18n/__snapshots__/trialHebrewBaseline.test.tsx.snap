  "leads": "<div class="fixed inset-0 z-99999 flex items-center justify-center p-4 bg-gray-950/20 backdrop-blur-[2px] anim-fade-in"><div class="pointer-events-none absolute bottom-8 right-8 z-0"><div dir="rtl" class="rounded-sm bg-black/85 shadow-lg transition-all duration-500 ease-out motion-reduce:transition-none -translate-x-8 opacity-0"><div class="flex items-center gap-4 ps-6 pe-9 py-3 font-medium text-white"><div aria-hidden="true" class="dark:bg-white size-5 bg-white " style="mask-image:url(https://res.cloudinary.com/dfletli2x/image/upload/icons/reg/users.svg);-webkit-mask-image:url(https://res.cloudinary.com/dfletli2x/image/upload/icons/reg/users.svg);mask-repeat:no-repeat;-webkit-mask-repeat:no-repeat;mask-position:center;-webkit-mask-position:center;mask-size:contain;-webkit-mask-size:contain;mask-type:alpha"></div><h3 class="font-medium leading-snug whitespace-pre-line">דנה כהן</h3></div></div></div><div dir="rtl" class="relative z-10 flex flex-col gap-6 w-full max-w-[440px] bg-gray-900 rounded-2xl p-8 shadow-2xl shadow-gray-900/40"><div><span class="inline-block text-xs font-bold px-3 py-1 bg-white text-gray-900 rounded-full">Pro</span><h1 class="text-2xl font-bold leading-snug text-white mt-4">הלידים שלך מחכים</h1><p class="text-sm text-white/70 mt-2 leading-relaxed">הלידים והנתונים שלך נשמרו בדיוק כפי שהשארת אותם. כדי להמשיך לעבוד יש לשדרג.</p><p class="text-sm text-white/80 mt-3"><span class="font-bold text-white">1234</span> לידים ממתינים לחזרה שלך</p></div><div><p class="text-4xl font-extrabold text-white">₪89<span class="text-base font-normal text-white/50 mr-1">/חודש</span></p></div><ul class="list-none space-y-2.5"><li class="flex items-start gap-3"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-check h-4 w-4 shrink-0 mt-0.5 text-white" aria-hidden="true"><path d="M20 6 9 17l-5-5"></path></svg>