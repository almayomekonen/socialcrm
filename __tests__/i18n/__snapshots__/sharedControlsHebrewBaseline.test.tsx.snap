exports[`(app) error boundary > the recovery screen 1`] = `"<div class="flex min-h-[50vh] w-full items-center justify-center p-6" dir="rtl" role="alert"><div class="grid w-full max-w-md gap-3 rounded-xl border border-gray-200 bg-white p-7 text-center shadow-sm"><h2 class="m-0 text-xl font-bold text-gray-900">חלה שגיאה במערכת</h2><p class="m-0 text-sm leading-relaxed text-gray-600">משהו השתבש בטעינת המסך. אפשר לנסות שוב, או לחזור לרשימת הלידים.</p><div class="mt-2 flex flex-col items-stretch justify-center gap-2 sm:flex-row sm:items-center"><button class="flex items-center min-w-fit justify-center font-medium rounded-md flex-nowrap bg-solid text-white hover:bg-solid/85 h-11 px-5 gap-4 text-lg" type="button"><span>נסה שנית</span></button><a class="flex items-center min-w-fit justify-center font-medium rounded-md flex-nowrap border text-black border-gray-200 bg-white hover:bg-gray-100/60 h-11 px-5 gap-4 text-lg" href="/leads"><span>חזרה ללידים</span></a></div></div></div>"`;

exports[`file chrome shared with translated uploaders > the gallery button and an unreadable file entry 1`] = `"<button class="flex items-center min-w-fit justify-center font-medium rounded-md flex-nowrap border text-black border-gray-200 bg-white hover:bg-gray-100/60 h-10 px-4 gap-3" type="button" popovertarget="galleryPop"><div aria-hidden="true" class="dark:bg-white bg-black size-4 " style="mask-image: url(&quot;https://res.cloudinary.com/dfletli2x/image/upload/icons/reg/images.svg&quot;); -webkit-mask-image: url(&quot;https://res.cloudinary.com/dfletli2x/image/upload/icons/reg/images.svg&quot;); mask-repeat: no-repeat; -webkit-mask-repeat: no-repeat; mask-position: center; -webkit-mask-position: center; mask-size: contain; -webkit-mask-size: contain; mask-type: alpha;"></div><span>בחירה מגלריה</span></button><div id="galleryPop" popover="auto" class="pop"><div class="grid grid-cols-6 gap-4"><img alt="img" loading="lazy" class="size-22 cursor-pointer shadow-1 rounded-md" src="https://example.test/a.webp"></div></div><div class="text-sm mb-2"><div class="grid grid-cols-[auto_1fr_auto] gap-2 group mb-1 items-center relative w-full"><div aria-hidden="true" class="dark:bg-white bg-gray-600 size-4 " style="mask-image: url(&quot;https://res.cloudinary.com/dfletli2x/image/upload/icons/lit/file.svg&quot;); -webkit-mask-image: url(&quot;https://res.cloudinary.com/dfletli2x/image/upload/icons/lit/file.svg&quot;); mask-repeat: no-repeat; -webkit-mask-repeat: no-repeat; mask-position: center; -webkit-mask-position: center; mask-size: contain; -webkit-mask-size: contain; mask-type: alpha;"></div><a href="" target="_blank" rel="noopener noreferrer" class="underline underline-offset-4 truncate">לא ניתן להציג</a></div><div class="grid grid-cols-[auto_1fr_auto] gap-2 group mb-1 items-center relative w-full"><div aria-hidden="true" class="dark:bg-white bg-red-600 size-4 " style="mask-image: url(&quot;https://res.cloudinary.com/dfletli2x/image/upload/icons/lit/file-pdf.svg&quot;); -webkit-mask-image: url(&quot;https://res.cloudinary.com/dfletli2x/image/upload/icons/lit/file-pdf.svg&quot;); mask-repeat: no-repeat; -webkit-mask-repeat: no-repeat; mask-position: center; -webkit-mask-position: center; mask-size: contain; -webkit-mask-size: contain; mask-type: alpha;"></div><a href="https://example.test/a.pdf" target="_blank" rel="noopener noreferrer" class="underline underline-offset-4 truncate">הצעה.pdf</a></div></div>"`;

