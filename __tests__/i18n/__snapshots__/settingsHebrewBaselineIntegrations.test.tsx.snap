ntain;mask-type:alpha"></div><span>הודעה מוכנה חדשה</span></button></div><ul class="grid list-none gap-2" aria-label="הודעות WhatsApp מוכנות"><li><div class="rounded-md border border-gray-200 p-3"><div class="flex items-center justify-between gap-3"><div class="min-w-0"><p class="truncate text-sm font-medium text-gray-800">הצעה אחרונה</p><p class="line-clamp-1 text-sm text-gray-500">קנו עכשיו!!!</p></div><div class="flex shrink-0 items-center gap-1"><span class="inline-flex shrink-0 items-center rounded-full border font-medium tabular-nums gap-1.5 px-2 py-0.5 text-xs " style="background-color:var(--color-error-bg);color:var(--color-error-text);border-color:var(--color-error-border)"><span class="shrink-0 rounded-full size-1.5 " style="background-color:var(--color-error-dot)"></span>נדחתה</span><button class="flex items-center min-w-fit justify-center font-medium rounded-md flex-nowrap bg-transparent text-black hover:bg-gray-100/60 h-9 px-3 gap-3 text-[15px]"><span>עריכה ושליחה מחדש</span></button><button class="flex items-center min-w-fit justify-center font-medium rounded-md flex-nowrap bg-transparent text-black hover:bg-gray-100/60 h-9 px-3 gap-3 text-[15px]"><span>הסר</span></button></div></div><div class="mt-2"><div role="status" class="rounded-md border p-3 border-red-200 bg-red-50"><p class="text-sm font-medium text-red-800">ההודעה לא אושרה</p><p class="mt-1 text-sm text-red-700">ההודעה לא אושרה — התוכן נוגד את מדיניות וואטסאפ. כדאי לנסח מחדש בלי תוכן שיווקי אגרסיבי.</p></div></div></div></li><li><div class="rounded-md border border-gray-200 p-3"><div class="flex items-center justify-between gap-3"><div class="min-w-0"><p class="truncate text-sm font-medium text-gray-800">מבצע חגים</p><p class="line-clamp-1 text-sm text-gray-500">מבצע מיוחד לחגים!</p></div><div class="flex shrink-0 items-center gap-1"><span class="inline-flex shrink-0 items-center rounded-full border font-medium tabular-nums gap-1.5 px-2 py-0.5 text-xs " style="background-color:var(--color-warning-bg);color:var(--color-warning-text);border-color:var(--color-warning-border)"><span class="shrink-0 rounded-full size-1.5 animate-pulse" style="background-color:var(--color-warning-dot)"></span>בבדיקת וואטסאפ</span><button class="flex items-center min-w-fit justify-center font-medium rounded-md flex-nowrap bg-transparent text-black hover:bg-gray-100/60 h-9 px-3 gap-3 text-[15px]"><span>הסר</span></button></div></div><div class="mt-2"><div role="status" class="rounded-md border p-3 border-amber-300 bg-amber-50"><p class="text-sm font-medium text-amber-800">ההודעה נשלחה לאישור וואטסאפ</p><p class="mt-1 text-sm text-amber-700">אין צורך לעשות דבר — ברגע שתאושר, היא תהיה מוכנה לשליחה.</p></div></div></div></li><li><div class="rounded-md border border-gray-200 p-3"><div class="flex items-center justify-between gap-3"><div class="min-w-0"><p class="truncate text-sm font-medium text-gray-800">תזכורת פגישה</p><p class="line-clamp-1 text-sm text-gray-500">היי {{שם הליד}}, מזכירים את הפגישה מחר.</p></div><div class="flex shrink-0 items-center gap-1"><span class="inline-flex shrink-0 items-center rounded-full border font-medium tabular-nums gap-1.5 px-2 py-0.5 text-xs " style="background-color:var(--color-success-bg);color:var(--color-success-text);border-color:var(--color-success-border)"><span class="shrink-0 rounded-full size-1.5 " style="background-color:var(--color-success-dot)"></span>מוכנה לשליחה</span><button class="flex items-center min-w-fit justify-center font-medium rounded-md flex-nowrap bg-transparent text-black hover:bg-gray-100/60 h-9 px-3 gap-3 text-[15px]"><span>עריכת הודעה</span></button><button class="flex items-center min-w-fit justify-center font-medium rounded-md flex-nowrap bg-transparent text-black hover:bg-gray-100/60 h-9 px-3 gap-3 text-[15px]"><span>ארכיון</span></button></div></div></div></li></ul></div><!--/$--><!--/$--></div></details></div></div></section><section><h2 class="text-xl font-bold text-dark">כלים מחוברים</h2><p class="mt-1 mb-4 max-w-2xl text-sm text-gray-600">שירותים חיצוניים שמעשירים את הלידים הקיימים.</p><div class="grid max-w-3xl grid-cols-2 gap-4 mobile:grid-cols-1"><div class="rounded-lg border border-gray-200 bg-white p-6 flex flex-col gap-4"><div class="flex items-center gap-2.5"><img src="/media/social-icons/google-calendar-color.svg" alt="" aria-hidden="true" class="size-7 shrink-0 object-contain"/><h3 class="text-lg font-bold">Google Calendar</h3></div><p class="text-gray-600 text-sm leading-relaxed">תזמון פגישות עם לידים וקישורי Google Meet אוטומטיים, ישירות מתוך ה-CRM.</p><div class="mt-auto flex items-center justify-between gap-3"><span class="text-sm text-gray-400">לא מחובר</span><button class="flex items-center min-w-fit justify-center font-medium rounded-md flex-nowrap bg-solid text-white hover:bg-solid/85 h-10 px-4 gap-3"><span>חבר את Google Calendar</span></button></div></div><div class="rounded-lg border border-gray-200 bg-white p-6 flex flex-col gap-4"><div class="flex items-center gap-2.5"><img src="/media/social-icons/google-drive-color.svg" alt="" aria-hidden="true" class="size-7 shrink-0 object-contain"/><h3 class="text-lg font-bold text-dark">Google Drive</h3></div><p class="text-sm text-gray-600 leading-relaxed">חיפוש, צירוף וניתוח של קבצים מ-Drive ישירות בתוך הלידים ובעוזר החכם.</p><div class="mt-auto h-9 flex items-center text-sm text-gray-400">טוען…</div></div><div class="col-span-2 mobile:col-span-1 rounded-lg border border-gray-200 bg-white p-6 flex flex-col gap-4"><div class="flex items-center gap-2.5"><h3 class="text-lg font-bold">חיבורי AI</h3><div aria-hidden="true" class="dark:bg-white size-4 bg-green-600 " style="mask-image:url(https://res.cloudinary.com/dfletli2x/image/upload/icons/reg/check.svg);-webkit-mask-image:url(https://res.cloudinary.com/dfletli2x/image/upload/icons/reg/check.svg);mask-repeat:no-repeat;-webkit-mask-repeat:no-repeat;mask-position:center;-webkit-mask-position:center;mask-size:contain;-webkit-mask-size:contain;mask-type:alpha"></div></div><div class="flex flex-col gap-1"><p class="text-gray-600 text-sm leading-relaxed">חברו את SocialCRM ל-Claude או ChatGPT כדי לשאול על לידים, מעקבים ושיחות.</p><p class="text-xs text-gray-500">הגישה מוגבלת לנתונים שאתם מורשים לראות. מספרי טלפון ואימיילים אינם נשלחים.</p></div><ul class="divide-y divide-gray-100 rounded-md border border-gray-100"><li class="flex flex-col gap-2 px-4 py-3"><div class="flex items-center gap-3"><span class="flex size-7 shrink-0 items-center justify-center"><img src="/media/social-icons/claude-color.png" alt="" aria-hidden="true" class="max-h-7 max-w-7 object-contain"/></span><div class="min-w-0 flex-1"><p class="text-sm font-medium text-gray-800">Claude</p><div class="flex flex-wrap items-center gap-x-1.5 text-xs text-gray-500"><span class="inline-flex items-center gap-1 font-medium text-green-700"><div aria-hidden="true" class="dark:bg-white size-3 bg-green-600 " style="mask-image:url(https://res.cloudinary.com/dfletli2x/image/upload/icons/reg/check.svg);-webkit-mask-image:url(https://res.cloudinary.com/dfletli2x/image/upload/icons/reg/check.svg);mask-repeat:no-repeat;-webkit-mask-repeat:no-repeat;mask-position:center;-webkit-mask-position:center;mask-size:contain;-webkit-mask-size:contain;mask-type:alpha"></div>מחובר</span><span>· מאז 1.10.2026</span><span>· שימוש אחרון 27.10.2026</span></div></div><button class="flex items-center min-w-fit justify-center font-medium rounded-md flex-nowrap border text-black border-gray-200 bg-white hover:bg-gray-100/60 h-10 px-4 gap-3"><span>נתק את Claude</span></button></div><ul class="list-disc ps-[3.25rem] text-xs text-gray-600"><li class="desktop:whitespace-nowrap">צפייה בלידים שלך, במעקבים ובסיכום היומי</li></ul></li><li class="flex flex-col gap-2 px-4 py-3"><div class="flex items-center gap-3"><span class="flex size-7 shrink-0 items-center justify-center"><img src="/media/social-icons/openai.png" alt="" aria-hidden="true" class="max-h-7 max-w-7 object-contain"/></span><div class="min-w-0 flex-1"><p class="text-sm font-medium text-gray-800">ChatGPT</p><div class="text-xs text-gray-500"><span class="text-gray-400">לא מחובר עדיין</span> · החיבור מתחיל מתוך ChatGPT</div></div><button class="flex items-center min-w-fit justify-center font-medium rounded-md flex-nowrap border text-black border-gray-200 bg-white hover:bg-gray-100/60 h-9 px-3 gap-3 text-[15px]" aria-controls="ai-connections-howto"><span>הוראות חיבור</span></button></div></li><li class="flex flex-col gap-2 px-4 py-3"><div class="flex items-center gap-3"><span class="flex size-7 shrink-0 items-center justify-center"><div aria-hidden="true" class="dark:bg-white size-5 bg-gray-400 " style="mask-image:url(https://res.cloudinary.com/dfletli2x/image/upload/icons/reg/plug.svg);-webkit-mask-image:url(https://res.cloudinary.com/dfletli2x/image/upload/icons/reg/plug.svg);mask-repeat:no-repeat;-webkit-mask-repeat:no-repeat;mask-position:center;-webkit-mask-position:center;mask-size:contain;-webkit-mask-size:contain;mask-type:alpha"></div></span><div class="min-w-0 flex-1"><p class="text-sm font-medium text-gray-800">Cursor</p><div class="flex flex-wrap items-center gap-x-1.5 text-xs text-gray-500"><span class="inline-flex items-center gap-1 font-medium text-green-700"><div aria-hidden="true" class="dark:bg-white size-3 bg-green-600 " style="mask-image:url(https://res.cloudinary.com/dfletli2x/image/upload/icons/reg/check.svg);-webkit-mask-image:url(https://res.cloudinary.com/dfletli2x/image/upload/icons/reg/check.svg);mask-repeat:no-repeat;-webkit-mask-repeat:no-repeat;mask-position:center;-webkit-mask-position:center;mask-size:contain;-webkit-mask-size:contain;mask-type:alpha"></div>מחובר</span><span>· מאז 20.10.2026</span><span>· שימוש אחרון —</span></div></div><button class="flex items-center min-w-fit justify-center font-medium rounded-md flex-nowrap border text-black border-gray-200 bg-white hover:bg-gray-100/60 h-10 px-4 gap-3"><span>נתק את Cursor</span></button></div><ul class="list-disc ps-[3.25rem] text-xs text-gray-600"><li class="desktop:whitespace-nowrap">צפייה בלידים שלך, במעקבים ובסיכום היומי</li><li class="desktop:whitespace-nowrap">צפייה בסיכומי שיחות WhatsApp עם הלידים שלך, ובהודעות עצמן לפי בקשה</li></ul></li></ul><details id="ai-connections-howto" class="group/howto"><summary class="flex w-fit cursor-pointer list-none items-center gap-1.5 text-sm text-solid [&amp;::-webkit-details-marker]:hidden"><div aria-hidden="true" class="dark:bg-white size-3 bg-solid transition-transform duration-200 group-open/howto:rotate-180 " style="mask-image:url(https://res.cloudinary.com/dfletli2x/image/upload/icons/reg/chevron-down.svg);-webkit-mask-image:url(https://res.cloudinary.com/dfletli2x/image/upload/icons/reg/chevron-down.svg);mask-repeat:no-repeat;-webkit-mask-repeat:no-repeat;mask-position:center;-webkit-mask-position:center;mask-size:contain;-webkit-mask-size:contain;mask-type:alpha"></div>איך מתחברים?</summary><ol class="mt-2.5 list-decimal space-y-1.5 ps-5 text-sm text-gray-600"><li>פותחים את Claude או ChatGPT</li><li>מוסיפים חיבור MCP חדש</li><li><div class="grid gap-1.5 min-w-0"><span class="text-sm text-gray-500">מזינים:</span><div class="flex items-start gap-2 min-w-0"><code dir="ltr" class="min-w-0 flex-1 break-all rounded-md border border-gray-200 bg-gray-50 px-3 py-2 text-xs leading-relaxed text-gray-800">https://mcp.example.test/mcp</code><button class="flex items-center min-w-fit justify-center font-medium rounded-md flex-nowrap border text-black border-gray-200 bg-white hover:bg-gray-100/60 h-9 px-3 gap-3 text-[15px]"><div aria-hidden="true" class="dark:bg-white bg-black size-[15px] " style="mask-image:url(https://res.cloudinary.com/dfletli2x/image/upload/icons/reg/copy.svg);-webkit-mask-image:url(https://res.cloudinary.com/dfletli2x/image/upload/icons/reg/copy.svg);mask-repeat:no-repeat;-webkit-mask-repeat:no-repeat;mask-position:center;-webkit-mask-position:center;mask-size:contain;-webkit-mask-size:contain;mask-type:alpha"></div><span>העתקה</span></button></div></div></li><li>מתחברים ל-SocialCRM ומאשרים הרשאה</li></ol></details></div></div></section></div>",
  "calendarReauth": "<link rel="preload" as="image" href="/media/social-icons/google-calendar-color.svg"/><link rel="preload" as="image" href="/media/social-icons/google-drive-color.svg"/><link rel="preload" as="image" href="/media/social-icons/claude-color.png"/><link rel="preload" as="image" href="/media/social-icons/openai.png"/><div><h1 class="title">אינטגרציות</h1><p class="mt-2 mb-8 max-w-2xl text-sm text-gray-600 leading-relaxed">חברו כאן את המערכות שמהן מגיעים הלידים, ואת הכלים שעוזרים לטפל בהם. החיבור מתבצע פעם אחת.</p><section class="mb-10"><h2 class="text-xl font-bold text-dark">מקורות לידים</h2><p class="mt-1 mb-4 max-w-2xl text-sm text-gray-600">מכאן נכנסים לידים חדשים למערכת, אוטומטית.</p><div class="max-w-lg"><div class="accordion border rounded-lg bg-white"><details id="facebook" name="x" class="group/acrdn border-b-2 last:border-b-0" open="" data-edu="facebook-section"><summary><div class="flex items-center gap-2"><div aria-hidden="true" class="size-[18.5px] dark:bg-white bg-[#1877F2] group-open/acrdn:bg-[#1877F2] " style="mask-image:url(https://res.cloudinary.com/dfletli2x/image/upload/icons/reg/facebook.svg);-webkit-mask-image:url(https://res.cloudinary.com/dfletli2x/image/upload/icons/reg/facebook.svg);mask-repeat:no-repeat;-webkit-mask-repeat:no-repeat;mask-position:center;-webkit-mask-position:center;mask-size:contain;-webkit-mask-size:contain;mask-type:alpha"></div><p class="group-open/acrdn:text-solid">פייסבוק</p></div><div aria-hidden="true" class="bg-gray-800 size-[18.5px] dark:bg-white duration-200 group-hover/acrdn:bg-gray-950 group-open/acrdn:rotate-90 group-open/acrdn:bg-solid " style="mask-image:url(https://res.cloudinary.com/dfletli2x/image/upload/icons/lit/chevron-left.svg);-webkit-mask-image:url(https://res.cloudinary.com/dfletli2x/image/upload/icons/lit/chevron-left.svg);mask-repeat:no-repeat;-webkit-mask-repeat:no-repeat;mask-position:center;-webkit-mask-position:center;mask-size:contain;-webkit-mask-size:contain;mask-type:alpha"></div></summary><div class="p-6"><!--$--><div class="grid gap-4"><p class="text-sm text-gray-600" data-edu="facebook-connect">מחובר לדף: <strong>סטודיו דנה</strong></p><p class="text-sm text-green-600">החיבור תקין  לידים מגיעים אוטומטית</p><button class="flex items-center min-w-fit justify-center font-medium rounded-md flex-nowrap bg-red-600 text-white hover:bg-red-700 h-9 px-3 gap-3 text-[15px] w-fit"><span>נתק דף</span></button></div><!--/$--></div></details><details id="whatsapp" name="x" class="group/acrdn border-b-2 last:border-b-0" data-edu="whatsapp-section"><summary><div class="flex items-center gap-2"><div aria-hidden="true" class="size-[18.5px] dark:bg-white bg-[#25D366] group-open/acrdn:bg-[#25D366] " style="mask-image:url(https://res.cloudinary.com/dfletli2x/image/upload/icons/reg/whatsapp.svg);-webkit-mask-image:url(https://res.cloudinary.com/dfletli2x/image/upload/icons/reg/whatsapp.svg);mask-repeat:no-repeat;-webkit-mask-repeat:no-repeat;mask-position:center;-webkit-mask-position:center;mask-size:contain;-webkit-mask-size:contain;mask-type:alpha"></div><p class="group-open/acrdn:text-solid">וואטסאפ</p></div><div aria-hidden="true" class="bg-gray-800 size-[18.5px] dark:bg-white duration-200 group-hover/acrdn:bg-gray-950 group-open/acrdn:rotate-90 group-open/acrdn:bg-solid " style="mask-image:url(https://res.cloudinary.com/dfletli2x/image/upload/icons/lit/chevron-left.svg);-webkit-mask-image:url(https://res.cloudinary.com/dfletli2x/image/upload/icons/lit/chevron-left.svg);mask-repeat:no-repeat;-webkit-mask-repeat:no-repeat;mask-position:center;-webkit-mask-position:center;mask-size:contain;-webkit-mask-size:contain;mask-type:alpha"></div></summary><div class="p-6"><!--$--><div class="grid gap-4" data-edu="whatsapp-connect"><p class="text-sm text-green-600">החיבור תקין — לידים מגיעים אוטומטית</p><div class="flex flex-wrap items-center gap-3"><button class="flex items-center min-w-fit justify-center font-medium rounded-md flex-nowrap border bg-white h-9 px-3 gap-3 text-[15px] w-fit border-red-200 text-red-600 hover:bg-red-50"><span>נתק וואטסאפ</span></button></div></div><!--/$--></div></details><details id="messenger" name="x" class="group/acrdn border-b-2 last:border-b-0"><summary><div class="flex items-center gap-2"><div aria-hidden="true" class="size-[18.5px] dark:bg-white bg-[#1877F2] group-open/acrdn:bg-[#1877F2] " style="mask-image:url(https://res.cloudinary.com/dfletli2x/image/upload/icons/reg/facebook.svg);-webkit-mask-image:url(https://res.cloudinary.com/dfletli2x/image/upload/icons/reg/facebook.svg);mask-repeat:no-repeat;-webkit-mask-repeat:no-repeat;mask-position:center;-webkit-mask-position:center;mask-size:contain;-webkit-mask-size:contain;mask-type:alpha"></div><p class="group-open/acrdn:text-solid">הודעת פתיחה ותפריט ב-Messenger</p></div><div aria-hidden="true" class="bg-gray-800 size-[18.5px] dark:bg-white duration-200 group-hover/acrdn:bg-gray-950 group-open/acrdn:rotate-90 group-open/acrdn:bg-solid " style="mask-image:url(https://res.cloudinary.com/dfletli2x/image/upload/icons/lit/chevron-left.svg);-webkit-mask-image:url(https://res.cloudinary.com/dfletli2x/image/upload/icons/lit/chevron-left.svg);mask-repeat:no-repeat;-webkit-mask-repeat:no-repeat;mask-position:center;-webkit-mask-position:center;mask-size:contain;-webkit-mask-size:contain;mask-type:alpha"></div></summary><div class="p-6"><!--$--><div class="grid gap-5"><div><label for="messenger-greeting" class="block text-sm font-medium text-gray-900">הודעת פתיחה</label><p class="mt-0.5 text-xs text-gray-500">מוצגת לפונה לפני ההודעה הראשונה שלו, כשהוא פותח את השיחה עם הדף.</p><textarea id="messenger-greeting" rows="2" placeholder="היי! כתבו לנו ונחזור אליכם בהקדם." class="mt-1.5 w-full resize-none rounded-md border border-gray-200 bg-white px-3 py-2 text-sm text-gray-900 placeholder:text-gray-400 focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary disabled:opacity-50">שלום! איך אפשר לעזור?</textarea><p class="mt-0.5 text-[11px] text-gray-400">21/160 · השאר ריק כדי לא להציג הודעת פתיחה</p></div><div><p class="text-sm font-medium text-gray-900">תפריט קבוע</p><p class="mt-0.5 text-xs text-gray-500">עד 3 אפשרויות שהפונה יכול לבחור בתוך השיחה. בחירה תופיע אצלך בשיחה כשורה נפרדת.</p><div class="mt-1.5 grid gap-2"><div><label for="messenger-menu-0" class="sr-only">פריט 1 בתפריט</label><input id="messenger-menu-0" type="text" placeholder="לדוגמה: לקבלת הצעת מחיר" class="w-full rounded-md border border-gray-200 bg-white px-3 py-2 text-sm text-gray-900 placeholder:text-gray-400 focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary disabled:opacity-50" value="הצעת מחיר"/></div><div><label for="messenger-menu-1" class="sr-only">פריט 2 בתפריט</label><input id="messenger-menu-1" type="text" placeholder="אפשרות נוספת (לא חובה)" class="w-full rounded-md border border-gray-200 bg-white px-3 py-2 text-sm text-gray-900 placeholder:text-gray-400 focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary disabled:opacity-50" value=""/></div><div><label for="messenger-menu-2" class="sr-only">פריט 3 בתפריט</label><input id="messenger-menu-2" type="text" placeholder="אפשרות נוספת (לא חובה)" class="w-full rounded-md border border-gray-200 bg-white px-3 py-2 text-sm text-gray-900 placeholder:text-gray-400 focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary disabled:opacity-50" value=""/></div></div><p class="mt-1 text-[11px] text-gray-400">השאר את כל השדות ריקים כדי להסיר את התפריט.</p></div><div><button class="flex items-center min-w-fit justify-center font-medium rounded-md flex-nowrap bg-solid text-white hover:bg-solid/85 h-10 px-4 gap-3"><span>שמור שינויים</span></button></div></div><!--/$--></div></details><details id="messenger-replies" name="x" class="group/acrdn border-b-2 last:border-b-0"><summary><div class="flex items-center gap-2"><div aria-hidden="true" class="size-[18.5px] dark:bg-white bg-[#1877F2] group-open/acrdn:bg-[#1877F2] " style="mask-image:url(https://res.cloudinary.com/dfletli2x/image/upload/icons/reg/facebook.svg);-webkit-mask-image:url(https://res.cloudinary.com/dfletli2x/image/upload/icons/reg/facebook.svg);mask-repeat:no-repeat;-webkit-mask-repeat:no-repeat;mask-position:center;-webkit-mask-position:center;mask-size:contain;-webkit-mask-size:contain;mask-type:alpha"></div><p class="group-open/acrdn:text-solid">תשובות שמורות ב-Messenger</p></div><div aria-hidden="true" class="bg-gray-800 size-[18.5px] dark:bg-white duration-200 group-hover/acrdn:bg-gray-950 group-open/acrdn:rotate-90 group-open/acrdn:bg-solid " style="mask-image:url(https://res.cloudinary.com/dfletli2x/image/upload/icons/lit/chevron-left.svg);-webkit-mask-image:url(https://res.cloudinary.com/dfletli2x/image/upload/icons/lit/chevron-left.svg);mask-repeat:no-repeat;-webkit-mask-repeat:no-repeat;mask-position:center;-webkit-mask-position:center;mask-size:contain;-webkit-mask-size:contain;mask-type:alpha"></div></summary><div class="p-6"><!--$--><div class="grid min-w-0 grid-cols-[minmax(0,1fr)] gap-4"><p class="text-xs leading-relaxed text-gray-500">תשובות שמורות הן קטעי טקסט לשימוש חוזר בשיחות Messenger. אלה אינן תבניות WhatsApp ואינן דורשות אישור של Meta.</p><ul class="grid min-w-0 grid-cols-[minmax(0,1fr)] gap-1.5"><li class="flex min-w-0 items-center gap-2 rounded-md border border-gray-200 bg-white px-3 py-2"><div class="min-w-0 flex-1"><p class="truncate text-sm font-medium text-gray-900">שעות פעילות</p><p class="mt-0.5 truncate text-xs text-gray-500">אנחנו פתוחים א׳-ה׳ 9:00-17:00</p><p class="mt-0.5 text-[11px] text-gray-400">1 תשובות מהירות · 1 כפתורים · קובץ מצורף</p></div><button class="flex items-center min-w-fit justify-center font-medium rounded-md flex-nowrap border text-black border-gray-200 bg-white hover:bg-gray-100/60 h-9 px-3 gap-3 text-[15px]" aria-label="עריכת שעות פעילות"><span>עריכה</span></button><button type="button" aria-label="מחק את שעות פעילות" title="מחק את שעות פעילות" class="flex size-8 shrink-0 items-center justify-center rounded-md text-gray-400 transition-colors hover:bg-red-50 hover:text-red-600 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-red-500/40"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-trash2 lucide-trash-2 size-3.5" aria-hidden="true"><path d="M10 11v6"></path><path d="M14 11v6"></path><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6"></path><path d="M3 6h18"></path><path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg></button></li></ul><div><button class="flex items-center min-w-fit justify-center font-medium rounded-md flex-nowrap border text-black border-gray-200 bg-white hover:bg-gray-100/60 h-10 px-4 gap-3"><div aria-hidden="true" class="dark:bg-white bg-black size-4 " style="mask-image:url(https://res.cloudinary.com/dfletli2x/image/upload/icons/reg/plus.svg);-webkit-mask-image:url(https://res.cloudinary.com/dfletli2x/image/upload/icons/reg/plus.svg);mask-repeat:no-repeat;-webkit-mask-repeat:no-repeat;mask-position:center;-webkit-mask-position:center;mask-size:contain;-webkit-mask-size:contain;mask-type:alpha"></div><span>הוסף תשובה שמורה</span></button></div></div><!--/$--></div></details><details id="templates" name="x" class="group/acrdn border-b-2 last:border-b-0"><summary><div class="flex items-center gap-2"><div aria-hidden="true" class="size-[18.5px] dark:bg-white bg-[#25D366] group-open/acrdn:bg-[#25D366] " style="mask-image:url(https://res.cloudinary.com/dfletli2x/image/upload/icons/reg/whatsapp.svg);-webkit-mask-image:url(https://res.cloudinary.com/dfletli2x/image/upload/icons/reg/whatsapp.svg);mask-repeat:no-repeat;-webkit-mask-repeat:no-repeat;mask-position:center;-webkit-mask-position:center;mask-size:contain;-webkit-mask-size:contain;mask-type:alpha"></div><p class="group-open/acrdn:text-solid">הודעות WhatsApp מוכנות</p><!--$--><span class="flex items-center gap-1"><span class="inline-flex shrink-0 items-center rounded-full border font-medium tabular-nums gap-1 px-1.5 py-0.5 text-[10px] leading-tight " style="background-color:var(--color-success-bg);color:var(--color-success-text);border-color:var(--color-success-border)"><span class="shrink-0 rounded-full size-1 " style="background-color:var(--color-success-dot)"></span>1 מוכנות</span><span class="inline-flex shrink-0 items-center rounded-full border font-medium tabular-nums gap-1 px-1.5 py-0.5 text-[10px] leading-tight " style="background-color:var(--color-warning-bg);color:var(--color-warning-text);border-color:var(--color-warning-border)"><span class="shrink-0 rounded-full size-1 " style="background-color:var(--color-warning-dot)"></span>1 בבדיקה</span></span><!--/$--></div><div aria-hidden="true" class="bg-gray-800 size-[18.5px] dark:bg-white duration-200 group-hover/acrdn:bg-gray-950 group-open/acrdn:rotate-90 group-open/acrdn:bg-solid " style="mask-image:url(https://res.cloudinary.com/dfletli2x/image/upload/icons/lit/chevron-left.svg);-webkit-mask-image:url(https://res.cloudinary.com/dfletli2x/image/upload/icons/lit/chevron-left.svg);mask-repeat:no-repeat;-webkit-mask-repeat:no-repeat;mask-position:center;-webkit-mask-position:center;mask-size:contain;-webkit-mask-size:contain;mask-type:alpha"></div></summary><div class="p-6"><!--$--><!--$--><div class="grid gap-3"><div class="flex justify-end"><button class="flex items-center min-w-fit justify-center font-medium rounded-md flex-nowrap bg-solid text-white hover:bg-solid/85 h-9 px-3 gap-3 text-[15px] w-fit"><div aria-hidden="true" class="dark:bg-white bg-white size-[15px] " style="mask-image:url(https://res.cloudinary.com/dfletli2x/image/upload/icons/sol/plus.svg);-webkit-mask-image:url(https://res.cloudinary.com/dfletli2x/image/upload/icons/sol/plus.svg);mask-repeat:no-repeat;-webkit-mask-repeat:no-repeat;mask-position:center;-webkit-mask-position:center;mask-size:contain;-webkit-mask-size:contain;mask-type:alpha"></div><span>הודעה מוכנה חדשה</span></button></div><ul class="grid list-none gap-2" aria-label="הודעות WhatsApp מוכנות"><li><div class="rounded-md border border-gray-200 p-3"><div class="flex items-center justify-between gap-3"><div class="min-w-0"><p class="truncate text-sm font-medium text-gray-800">הצעה אחרונה</p><p class="line-clamp-1 text-sm text-gray-500">קנו עכשיו!!!</p></div><div class="flex shrink-0 items-center gap-1"><span class="inline-flex shrink-0 items-center rounded-full border font-medium tabular-nums gap-1.5 px-2 py-0.5 text-xs " style="background-color:var(--color-error-bg);color:var(--color-error-text);border-color:var(--color-error-border)"><span class="shrink-0 rounded-full size-1.5 " style="background-color:var(--color-error-dot)"></span>נדחתה</span><button class="flex items-center min-w-fit justify-center font-medium rounded-md flex-nowrap bg-transparent text-black hover:bg-gray-100/60 h-9 px-3 gap-3 text-[15px]"><span>עריכה ושליחה מחדש</span></button><button class="flex items-center min-w-fit justify-center font-medium rounded-md flex-nowrap bg-transparent text-black hover:bg-gray-100/60 h-9 px-3 gap-3 text-[15px]"><span>הסר</span></button></div></div><div class="mt-2"><div role="status" class="rounded-md border p-3 border-red-200 bg-red-50"><p class="text-sm font-medium text-red-800">ההודעה לא אושרה</p><p class="mt-1 text-sm text-red-700">ההודעה לא אושרה — התוכן נוגד את מדיניות וואטסאפ. כדאי לנסח מחדש בלי תוכן שיווקי אגרסיבי.</p></div></div></div></li><li><div class="rounded-md border border-gray-200 p-3"><div class="flex items-center justify-between gap-3"><div class="min-w-0"><p class="truncate text-sm font-medium text-gray-800">מבצע חגים</p><p class="line-clamp-1 text-sm text-gray-500">מבצע מיוחד לחגים!</p></div><div class="flex shrink-0 items-center gap-1"><span class="inline-flex shrink-0 items-center rounded-full border font-medium tabular-nums gap-1.5 px-2 py-0.5 text-xs " style="background-color:var(--color-warning-bg);color:var(--color-warning-text);border-color:var(--color-warning-border)"><span class="shrink-0 rounded-full size-1.5 animate-pulse" style="background-color:var(--color-warning-dot)"></span>בבדיקת וואטסאפ</span><button class="flex items-center min-w-fit justify-center font-medium rounded-md flex-nowrap bg-transparent text-black hover:bg-gray-100/60 h-9 px-3 gap-3 text-[15px]"><span>הסר</span></button></div></div><div class="mt-2"><div role="status" class="rounded-md border p-3 border-amber-300 bg-amber-50"><p class="text-sm font-medium text-amber-800">ההודעה נשלחה לאישור וואטסאפ</p><p class="mt-1 text-sm text-amber-700">אין צורך לעשות דבר — ברגע שתאושר, היא תהיה מוכנה לשליחה.</p></div></div></div></li><li><div class="rounded-md border border-gray-200 p-3"><div class="flex items-center justify-between gap-3"><div class="min-w-0"><p class="truncate text-sm font-medium text-gray-800">תזכורת פגישה</p><p class="line-clamp-1 text-sm text-gray-500">היי {{שם הליד}}, מזכירים את הפגישה מחר.</p></div><div class="flex shrink-0 items-center gap-1"><span class="inline-flex shrink-0 items-center rounded-full border font-medium tabular-nums gap-1.5 px-2 py-0.5 text-xs " style="background-color:var(--color-success-bg);color:var(--color-success-text);border-color:var(--color-success-border)"><span class="shrink-0 rounded-full size-1.5 " style="background-color:var(--color-success-dot)"></span>מוכנה לשליחה</span><button class="flex items-center min-w-fit justify-center font-medium rounded-md flex-nowrap bg-transparent text-black hover:bg-gray-100/60 h-9 px-3 gap-3 text-[15px]"><span>עריכת הודעה</span></button><button class="flex items-center min-w-fit justify-center font-medium rounded-md flex-nowrap bg-transparent text-black hover:bg-gray-100/60 h-9 px-3 gap-3 text-[15px]"><span>ארכיון</span></button></div></div></div></li></ul></div><!--/$--><!--/$--></div></details></div></div></section><section><h2 class="text-xl font-bold text-dark">כלים מחוברים</h2><p class="mt-1 mb-4 max-w-2xl text-sm text-gray-600">שירותים חיצוניים שמעשירים את הלידים הקיימים.</p><div class="grid max-w-3xl grid-cols-2 gap-4 mobile:grid-cols-1"><div class="rounded-lg border border-gray-200 bg-white p-6 flex flex-col gap-4"><div class="flex items-center gap-2.5"><img src="/media/social-icons/google-calendar-color.svg" alt="" aria-hidden="true" class="size-7 shrink-0 object-contain"/><h3 class="text-lg font-bold">Google Calendar</h3></div><p class="text-gray-600 text-sm leading-relaxed">תזמון פגישות עם לידים וקישורי Google Meet אוטומטיים, ישירות מתוך ה-CRM.</p><div class="rounded-md border border-amber-200 bg-amber-50 px-3 py-2 text-sm text-amber-900"><p class="font-medium">החיבור ליומן פג.</p><p class="mt-0.5">יש להתחבר מחדש כדי לסנכרן פגישות חדשות.</p><p class="mt-1 text-xs text-amber-700">פרטים: invalid_grant: Token has been expired or revoked.</p></div><div class="mt-auto flex items-center justify-between gap-3"><span class="text-sm text-gray-400">דורש חיבור מחדש</span><button class="flex items-center min-w-fit justify-center font-medium rounded-md flex-nowrap bg-solid text-white hover:bg-solid/85 h-10 px-4 gap-3"><span>חבר מחדש</span></button></div></div><div class="rounded-lg border border-gray-200 bg-white p-6 flex flex-col gap-4"><div class="flex items-center gap-2.5"><img src="/media/social-icons/google-drive-color.svg" alt="" aria-hidden="true" class="size-7 shrink-0 object-contain"/><h3 class="text-lg font-bold text-dark">Google Drive</h3></div><p class="text-sm text-gray-600 leading-relaxed">חיפוש, צירוף וניתוח של קבצים מ-Drive ישירות בתוך הלידים ובעוזר החכם.</p><div class="mt-auto h-9 flex items-center text-sm text-gray-400">טוען…</div></div><div class="col-span-2 mobile:col-span-1 rounded-lg border border-gray-200 bg-white p-6 flex flex-col gap-4"><div class="flex items-center gap-2.5"><h3 class="text-lg font-bold">חיבורי AI</h3><div aria-hidden="true" class="dark:bg-white size-4 bg-green-600 " style="mask-image:url(https://res.cloudinary.com/dfletli2x/image/upload/icons/reg/check.svg);-webkit-mask-image:url(https://res.cloudinary.com/dfletli2x/image/upload/icons/reg/check.svg);mask-repeat:no-repeat;-webkit-mask-repeat:no-repeat;mask-position:center;-webkit-mask-position:center;mask-size:contain;-webkit-mask-size:contain;mask-type:alpha"></div></div><div class="flex flex-col gap-1"><p class="text-gray-600 text-sm leading-relaxed">חברו את SocialCRM ל-Claude או ChatGPT כדי לשאול על לידים, מעקבים ושיחות.</p><p class="text-xs text-gray-500">הגישה מוגבלת לנתונים שאתם מורשים לראות. מספרי טלפון ואימיילים אינם נשלחים.</p></div><ul class="divide-y divide-gray-100 rounded-md border border-gray-100"><li class="flex flex-col gap-2 px-4 py-3"><div class="flex items-center gap-3"><span class="flex size-7 shrink-0 items-center justify-center"><img src="/media/social-icons/claude-color.png" alt="" aria-hidden="true" class="max-h-7 max-w-7 object-contain"/></span><div class="min-w-0 flex-1"><p class="text-sm font-medium text-gray-800">Claude</p><div class="flex flex-wrap items-center gap-x-1.5 text-xs text-gray-500"><span class="inline-flex items-center gap-1 font-medium text-green-700"><div aria-hidden="true" class="dark:bg-white size-3 bg-green-600 " style="mask-image:url(https://res.cloudinary.com/dfletli2x/image/upload/icons/reg/check.svg);-webkit-mask-image:url(https://res.cloudinary.com/dfletli2x/image/upload/icons/reg/check.svg);mask-repeat:no-repeat;-webkit-mask-repeat:no-repeat;mask-position:center;-webkit-mask-position:center;mask-size:contain;-webkit-mask-size:contain;mask-type:alpha"></div>מחובר</span><span>· מאז 1.10.2026</span><span>· שימוש אחרון 27.10.2026</span></div></div><button class="flex items-center min-w-fit justify-center font-medium rounded-md flex-nowrap border text-black border-gray-200 bg-white hover:bg-gray-100/60 h-10 px-4 gap-3"><span>נתק את Claude</span></button></div><ul class="list-disc ps-[3.25rem] text-xs text-gray-600"><li class="desktop:whitespace-nowrap">צפייה בלידים שלך, במעקבים ובסיכום היומי</li></ul></li><li class="flex flex-col gap-2 px-4 py-3"><div class="flex items-center gap-3"><span class="flex size-7 shrink-0 items-center justify-center"><img src="/media/social-icons/openai.png" alt="" aria-hidden="true" class="max-h-7 max-w-7 object-contain"/></span><div class="min-w-0 flex-1"><p class="text-sm font-medium text-gray-800">ChatGPT</p><div class="text-xs text-gray-500"><span class="text-gray-400">לא מחובר עדיין</span> · החיבור מתחיל מתוך ChatGPT</div></div><button class="flex items-center min-w-fit justify-center font-medium rounded-md flex-nowrap border text-black border-gray-200 bg-white hover:bg-gray-100/60 h-9 px-3 gap-3 text-[15px]" aria-controls="ai-connections-howto"><span>הוראות חיבור</span></button></div></li><li class="flex flex-col gap-2 px-4 py-3"><div class="flex items-center gap-3"><span class="flex size-7 shrink-0 items-center justify-center"><div aria-hidden="true" class="dark:bg-white size-5 bg-gray-400 " style="mask-image:url(https://res.cloudinary.com/dfletli2x/image/upload/icons/reg/plug.svg);-webkit-mask-image:url(https://res.cloudinary.com/dfletli2x/image/upload/icons/reg/plug.svg);mask-repeat:no-repeat;-webkit-mask-repeat:no-repeat;mask-position:center;-webkit-mask-position:center;mask-size:contain;-webkit-mask-size:contain;mask-type:alpha"></div></span><div class="min-w-0 flex-1"><p class="text-sm font-medium text-gray-800">Cursor</p><div class="flex flex-wrap items-center gap-x-1.5 text-xs text-gray-500"><span class="inline-flex items-center gap-1 font-medium text-green-700"><div aria-hidden="true" class="dark:bg-white size-3 bg-green-600 " style="mask-image:url(https://res.cloudinary.com/dfletli2x/image/upload/icons/reg/check.svg);-webkit-mask-image:url(https://res.cloudinary.com/dfletli2x/image/upload/icons/reg/check.svg);mask-repeat:no-repeat;-webkit-mask-repeat:no-repeat;mask-position:center;-webkit-mask-position:center;mask-size:contain;-webkit-mask-size:contain;mask-type:alpha"></div>מחובר</span><span>· מאז 20.10.2026</span><span>· שימוש אחרון —</span></div></div><button class="flex items-center min-w-fit justify-center font-medium rounded-md flex-nowrap border text-black border-gray-200 bg-white hover:bg-gray-100/60 h-10 px-4 gap-3"><span>נתק את Cursor</span></button></div><ul class="list-disc ps-[3.25rem] text-xs text-gray-600"><li class="desktop:whitespace-nowrap">צפייה בלידים שלך, במעקבים ובסיכום היומי</li><li class="desktop:whitespace-nowrap">צפייה בסיכומי שיחות WhatsApp עם הלידים שלך, ובהודעות עצמן לפי בקשה</li></ul></li></ul><details id="ai-connections-howto" class="group/howto"><summary class="flex w-fit cursor-pointer list-none items-center gap-1.5 text-sm text-solid [&amp;::-webkit-details-marker]:hidden"><div aria-hidden="true" class="dark:bg-white size-3 bg-solid transition-transform duration-200 group-open/howto:rotate-180 " style="mask-image:url(https://res.cloudinary.com/dfletli2x/image/upload/icons/reg/chevron-down.svg);-webkit-mask-image:url(https://res.cloudinary.com/dfletli2x/image/upload/icons/reg/chevron-down.svg);mask-repeat:no-repeat;-webkit-mask-repeat:no-repeat;mask-position:center;-webkit-mask-position:center;mask-size:contain;-webkit-mask-size:contain;mask-type:alpha"></div>איך מתחברים?</summary><ol class="mt-2.5 list-decimal space-y-1.5 ps-5 text-sm text-gray-600"><li>פותחים את Claude או ChatGPT</li><li>מוסיפים חיבור MCP חדש</li><li><div class="grid gap-1.5 min-w-0"><span class="text-sm text-gray-500">מזינים:</span><div class="flex items-start gap-2 min-w-0"><code dir="ltr" class="min-w-0 flex-1 break-all rounded-md border border-gray-200 bg-gray-50 px-3 py-2 text-xs leading-relaxed text-gray-800">https://mcp.example.test/mcp</code><button class="flex items-center min-w-fit justify-center font-medium rounded-md flex-nowrap border text-black border-gray-200 bg-white hover:bg-gray-100/60 h-9 px-3 gap-3 text-[15px]"><div aria-hidden="true" class="dark:bg-white bg-black size-[15px] " style="mask-image:url(https://res.cloudinary.com/dfletli2x/image/upload/icons/reg/copy.svg);-webkit-mask-image:url(https://res.cloudinary.com/dfletli2x/image/upload/icons/reg/copy.svg);mask-repeat:no-repeat;-webkit-mask-repeat:no-repeat;mask-position:center;-webkit-mask-position:center;mask-size:contain;-webkit-mask-size:contain;mask-type:alpha"></div><span>העתקה</span></button></div></div></li><li>מתחברים ל-SocialCRM ומאשרים הרשאה</li></ol></details></div></div></section></div>",
  "mcpOff": "<link rel="preload" as="image" href="/media/social-icons/google-calendar-color.svg"/><link rel="preload" as="image" href="/media/social-icons/google-drive-color.svg"/><div><h1 class="title">אינטגרציות</h1><p class="mt-2 mb-8 max-w-2xl text-sm text-gray-600 leading-relaxed">חברו כאן את המערכות שמהן מגיעים הלידים, ואת הכלים שעוזרים לטפל בהם. החיבור מתבצע פעם אחת.</p><section class="mb-10"><h2 class="text-xl font-bold text-dark">מקורות לידים</h2><p class="mt-1 mb-4 max-w-2xl text-sm text-gray-600">מכאן נכנסים לידים חדשים למערכת, אוטומטית.</p><div class="max-w-lg"><div class="accordion border rounded-lg bg-white"><details id="facebook" name="x" class="group/acrdn border-b-2 last:border-b-0" open="" data-edu="facebook-section"><summary><div class="flex items-center gap-2"><div aria-hidden="true" class="size-[18.5px] dark:bg-white bg-[#1877F2] group-open/acrdn:bg-[#1877F2] " style="mask-image:url(https://res.cloudinary.com/dfletli2x/image/upload/icons/reg/facebook.svg);-webkit-mask-image:url(https://res.cloudinary.com/dfletli2x/image/upload/icons/reg/facebook.svg);mask-repeat:no-repeat;-webkit-mask-repeat:no-repeat;mask-position:center;-webkit-mask-position:center;mask-size:contain;-webkit-mask-size:contain;mask-type:alpha"></div><p class="group-open/acrdn:text-solid">פייסבוק</p></div><div aria-hidden="true" class="bg-gray-800 size-[18.5px] dark:bg-white duration-200 group-hover/acrdn:bg-gray-950 group-open/acrdn:rotate-90 group-open/acrdn:bg-solid " style="mask-image:url(https://res.cloudinary.com/dfletli2x/image/upload/icons/lit/chevron-left.svg);-webkit-mask-image:url(https://res.cloudinary.com/dfletli2x/image/upload/icons/lit/chevron-left.svg);mask-repeat:no-repeat;-webkit-mask-repeat:no-repeat;mask-position:center;-webkit-mask-position:center;mask-size:contain;-webkit-mask-size:contain;mask-type:alpha"></div></summary><div class="p-6"><!--$--><div class="grid gap-4"><p class="text-sm text-gray-600" data-edu="facebook-connect">מחובר לדף: <strong>סטודיו דנה</strong></p><p class="text-sm text-green-600">החיבור תקין  לידים מגיעים אוטומטית</p><button class="flex items-center min-w-fit justify-center font-medium rounded-md flex-nowrap bg-red-600 text-white hover:bg-red-700 h-9 px-3 gap-3 text-[15px] w-fit"><span>נתק דף</span></button></div><!--/$--></div></details><details id="whatsapp" name="x" class="group/acrdn border-b-2 last:border-b-0" data-edu="whatsapp-section"><summary><div class="flex items-center gap-2"><div aria-hidden="true" class="size-[18.5px] dark:bg-white bg-[#25D366] group-open/acrdn:bg-[#25D366] " style="mask-image:url(https://res.cloudinary.com/dfletli2x/image/upload/icons/reg/whatsapp.svg);-webkit-mask-image:url(https://res.cloudinary.com/dfletli2x/image/upload/icons/reg/whatsapp.svg);mask-repeat:no-repeat;-webkit-mask-repeat:no-repeat;mask-position:center;-webkit-mask-position:center;mask-size:contain;-webkit-mask-size:contain;mask-type:alpha"></div><p class="group-open/acrdn:text-solid">וואטסאפ</p></div><div aria-hidden="true" class="bg-gray-800 size-[18.5px] dark:bg-white duration-200 group-hover/acrdn:bg-gray-950 group-open/acrdn:rotate-90 group-open/acrdn:bg-solid " style="mask-image:url(https://res.cloudinary.com/dfletli2x/image/upload/icons/lit/chevron-left.svg);-webkit-mask-image:url(https://res.cloudinary.com/dfletli2x/image/upload/icons/lit/chevron-left.svg);mask-repeat:no-repeat;-webkit-mask-repeat:no-repeat;mask-position:center;-webkit-mask-position:center;mask-size:contain;-webkit-mask-size:contain;mask-type:alpha"></div></summary><div class="p-6"><!--$--><div class="grid gap-4" data-edu="whatsapp-connect"><p class="text-sm text-green-600">החיבור תקין — לידים מגיעים אוטומטית</p><div class="flex flex-wrap items-center gap-3"><button class="flex items-center min-w-fit justify-center font-medium rounded-md flex-nowrap border bg-white h-9 px-3 gap-3 text-[15px] w-fit border-red-200 text-red-600 hover:bg-red-50"><span>נתק וואטסאפ</span></button></div></div><!--/$--></div></details><details id="messenger" name="x" class="group/acrdn border-b-2 last:border-b-0"><summary><div class="flex items-center gap-2"><div aria-hidden="true" class="size-[18.5px] dark:bg-white bg-[#1877F2] group-open/acrdn:bg-[#1877F2] " style="mask-image:url(https://res.cloudinary.com/dfletli2x/image/upload/icons/reg/facebook.svg);-webkit-mask-image:url(https://res.cloudinary.com/dfletli2x/image/upload/icons/reg/facebook.svg);mask-repeat:no-repeat;-webkit-mask-repeat:no-repeat;mask-position:center;-webkit-mask-position:center;mask-size:contain;-webkit-mask-size:contain;mask-type:alpha"></div><p class="group-open/acrdn:text-solid">הודעת פתיחה ותפריט ב-Messenger</p></div><div aria-hidden="true" class="bg-gray-800 size-[18.5px] dark:bg-white duration-200 group-hover/acrdn:bg-gray-950 group-open/acrdn:rotate-90 group-open/acrdn:bg-solid " style="mask-image:url(https://res.cloudinary.com/dfletli2x/image/upload/icons/lit/chevron-left.svg);-webkit-mask-image:url(https://res.cloudinary.com/dfletli2x/image/upload/icons/lit/chevron-left.svg);mask-repeat:no-repeat;-webkit-mask-repeat:no-repeat;mask-position:center;-webkit-mask-position:center;mask-size:contain;-webkit-mask-size:contain;mask-type:alpha"></div></summary><div class="p-6"><!--$--><div class="grid gap-5"><div><label for="messenger-greeting" class="block text-sm font-medium text-gray-900">הודעת פתיחה</label><p class="mt-0.5 text-xs text-gray-500">מוצגת לפונה לפני ההודעה הראשונה שלו, כשהוא פותח את השיחה עם הדף.</p><textarea id="messenger-greeting" rows="2" placeholder="היי! כתבו לנו ונחזור אליכם בהקדם." class="mt-1.5 w-full resize-none rounded-md border border-gray-200 bg-white px-3 py-2 text-sm text-gray-900 placeholder:text-gray-400 focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary disabled:opacity-50">שלום! איך אפשר לעזור?</textarea><p class="mt-0.5 text-[11px] text-gray-400">21/160 · השאר ריק כדי לא להציג הודעת פתיחה</p></div><div><p class="text-sm font-medium text-gray-900">תפריט קבוע</p><p class="mt-0.5 text-xs text-gray-500">עד 3 אפשרויות שהפונה יכול לבחור בתוך השיחה. בחירה תופיע אצלך בשיחה כשורה נפרדת.</p><div class="mt-1.5 grid gap-2"><div><label for="messenger-menu-0" class="sr-only">פריט 1 בתפריט</label><input id="messenger-menu-0" type="text" placeholder="לדוגמה: לקבלת הצעת מחיר" class="w-full rounded-md border border-gray-200 bg-white px-3 py-2 text-sm text-gray-900 placeholder:text-gray-400 focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary disabled:opacity-50" value="הצעת מחיר"/></div><div><label for="messenger-menu-1" class="sr-only">פריט 2 בתפריט</label><input id="messenger-menu-1" type="text" placeholder="אפשרות נוספת (לא חובה)" class="w-full rounded-md border border-gray-200 bg-white px-3 py-2 text-sm text-gray-900 placeholder:text-gray-400 focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary disabled:opacity-50" value=""/></div><div><label for="messenger-menu-2" class="sr-only">פריט 3 בתפריט</label><input id="messenger-menu-2" type="text" placeholder="אפשרות נוספת (לא חובה)" class="w-full rounded-md border border-gray-200 bg-white px-3 py-2 text-sm text-gray-900 placeholder:text-gray-400 focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary disabled:opacity-50" value=""/></div></div><p class="mt-1 text-[11px] text-gray-400">השאר את כל השדות ריקים כדי להסיר את התפריט.</p></div><div><button class="flex items-center min-w-fit justify-center font-medium rounded-md flex-nowrap bg-solid text-white hover:bg-solid/85 h-10 px-4 gap-3"><span>שמור שינויים</span></button></div></div><!--/$--></div></details><details id="messenger-replies" name="x" class="group/acrdn border-b-2 last:border-b-0"><summary><div class="flex items-center gap-2"><div aria-hidden="true" class="size-[18.5px] dark:bg-white bg-[#1877F2] group-open/acrdn:bg-[#1877F2] " style="mask-image:url(https://res.cloudinary.com/dfletli2x/image/upload/icons/reg/facebook.svg);-webkit-mask-image:url(https://res.cloudinary.com/dfletli2x/image/upload/icons/reg/facebook.svg);mask-repeat:no-repeat;-webkit-mask-repeat:no-repeat;mask-position:center;-webkit-mask-position:center;mask-size:contain;-webkit-mask-size:contain;mask-type:alpha"></div><p class="group-open/acrdn:text-solid">תשובות שמורות ב-Messenger</p></div><div aria-hidden="true" class="bg-gray-800 size-[18.5px] dark:bg-white duration-200 group-hover/acrdn:bg-gray-950 group-open/acrdn:rotate-90 group-open/acrdn:bg-solid " style="mask-image:url(https://res.cloudinary.com/dfletli2x/image/upload/icons/lit/chevron-left.svg);-webkit-mask-image:url(https://res.cloudinary.com/dfletli2x/image/upload/icons/lit/chevron-left.svg);mask-repeat:no-repeat;-webkit-mask-repeat:no-repeat;mask-position:center;-webkit-mask-position:center;mask-size:contain;-webkit-mask-size:contain;mask-type:alpha"></div></summary><div class="p-6"><!--$--><div class="grid min-w-0 grid-cols-[minmax(0,1fr)] gap-4"><p class="text-xs leading-relaxed text-gray-500">תשובות שמורות הן קטעי טקסט לשימוש חוזר בשיחות Messenger. אלה אינן תבניות WhatsApp ואינן דורשות אישור של Meta.</p><ul class="grid min-w-0 grid-cols-[minmax(0,1fr)] gap-1.5"><li class="flex min-w-0 items-center gap-2 rounded-md border border-gray-200 bg-white px-3 py-2"><div class="min-w-0 flex-1"><p class="truncate text-sm font-medium text-gray-900">שעות פעילות</p><p class="mt-0.5 truncate text-xs text-gray-500">אנחנו פתוחים א׳-ה׳ 9:00-17:00</p><p class="mt-0.5 text-[11px] text-gray-400">1 תשובות מהירות · 1 כפתורים · קובץ מצורף</p></div><button class="flex items-center min-w-fit justify-center font-medium rounded-md flex-nowrap border text-black border-gray-200 bg-white hover:bg-gray-100/60 h-9 px-3 gap-3 text-[15px]" aria-label="עריכת שעות פעילות"><span>עריכה</span></button><button type="button" aria-label="מחק את שעות פעילות" title="מחק את שעות פעילות" class="flex size-8 shrink-0 items-center justify-center rounded-md text-gray-400 transition-colors hover:bg-red-50 hover:text-red-600 focus-visible:outline-none focus-visible:ring-2 focus-