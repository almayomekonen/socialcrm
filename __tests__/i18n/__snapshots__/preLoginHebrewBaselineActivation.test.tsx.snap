@media (prefers-reduced-motion: reduce) {
  .mh-anim { animation: none !important; }
  .mh-rise { animation: none !important; opacity: 1 !important; transform: none !important; }
}
</style><div class="mh-rise w-full" style="animation-delay: 40ms;"><div class="relative mx-auto w-full" style="max-width: min(86vw, 320px);" aria-hidden="true"><div class="mh-anim pointer-events-none absolute rounded-full" style="inset: -16%; background: radial-gradient(rgba(252, 191, 73, 0.22) 0%, rgba(63, 32, 245, 0.13) 45%, transparent 72%); filter: blur(38px); animation: mh-breathe 7s ease-in-out infinite;"></div><div class="mh-anim relative overflow-hidden rounded-2xl" style="background: rgba(255, 255, 255, 0.045); border: 1px solid rgba(255, 255, 255, 0.1); backdrop-filter: blur(14px); box-shadow: 0 30px 70px rgba(0,0,0,0.55), inset 0 1px 0 rgba(255,255,255,0.10); animation: mh-float 7s ease-in-out infinite;"><div class="flex items-center gap-1.5 px-4 py-3" style="border-bottom: 1px solid rgba(255, 255, 255, 0.07);"><span class="size-2 rounded-full" style="background: rgba(255, 255, 255, 0.2);"></span><span class="size-2 rounded-full" style="background: rgba(255, 255, 255, 0.14);"></span><span class="size-2 rounded-full" style="background: rgba(255, 255, 255, 0.1);"></span></div><div class="flex flex-col gap-4 px-4 py-5"><div class="flex items-center gap-3"><div class="relative inline-flex items-center justify-center"><div class="absolute rounded-full animate-pulse" style="inset: -15px; background: radial-gradient(rgba(252, 191, 73, 0.45) 0%, rgba(251, 146, 60, 0.15) 38%, transparent 70%); filter: blur(26px);"></div><div class="relative grid place-items-center" style="width: 34px; height: 34px; border-radius: 10px; background: linear-gradient(135deg, rgb(254, 252, 247) 0%, rgb(250, 242, 220) 60%, rgb(245, 230, 184) 100%); box-shadow: 0 18px 44px rgba(0,0,0,0.55), 0 0 48px rgba(252,191,73,0.28), inset 0 1px 0 rgba(255,255,255,1), inset 0 0 0 1px rgba(255,255,255,0.5);"><img alt="SocialCRM" width="21" height="21" style="width: 21px; height: 21px;" draggable="false" src="/media/fav.svg"></div></div><span class="flex flex-1 flex-col gap-1.5"><span class="block h-2