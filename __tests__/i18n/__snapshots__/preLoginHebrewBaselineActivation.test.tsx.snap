exports[`Hebrew baseline — /oauth/consent > MCP off, signed out, expired / used request, every ineligible reason, the card 1`] = `
{
  "card": "<div class="mx-auto mt-16 max-w-md px-4"><form class="rounded-lg border border-gray-200 bg-white p-6 flex flex-col gap-4" action="/api/oauth/consent" method="post"><h1 class="text-lg font-bold">חיבור Claude ל-SocialCRM</h1><p class="text-sm text-gray-600">Claude · <span class="font-medium text-gray-800">claude.ai</span></p><p class="text-sm text-gray-600">מחובר בתור <span class="font-medium text-gray-800">דנה</span> · <span class="font-medium text-gray-800">סלון דנה</span></p><div><h2 class="text-sm font-bold">Claude יוכל:</h2><ul class="mt-1 list-disc ps-5 text-sm text-gray-700"><li>צפייה בלידים שלך, במעקבים ובסיכום היומי</li><li>צפייה בסיכומי שיחות WhatsApp עם הלידים שלך, ובהודעות עצמן לפי בקשה</li></ul></div><p class="text-sm text-gray-600">Claude לא יקבל מספרי טלפון או כתובות אימייל, לא יוכל לשנות נתונים ולא ישלח הודעות WhatsApp.</p><input type="hidden" name="csrf" value="cccccccccccccccccccccccccccccccc"/><div class="mt-auto flex items-center justify-end gap-3"><button type="submit" class="flex items-center min-w-fit justify-center font-medium rounded-md flex-nowrap border text-black border-gray-200 bg-white hover:bg-gray-100/60 h-10 px-4 gap-3 aria-disabled:pointer-events-none aria-disabled:opacity-50" value="deny" data-decision="deny" name="decision"><div aria-hidden="true" class="dark:bg-white bg-black size-4 " style="mask-image:url(https://res.cloudinary.com/dfletli2x/image/upload/icons/reg/xmark.svg);-webkit-mask-image:url(https://res.cloudinary.com/dfletli2x/image/upload/icons/reg/xmark.svg);mask-repeat:no-repeat;-webkit-mask-repeat:no-repeat;mask-position:center;-webkit-mask-position:center;mask-size:contain;-webkit-mask-size:contain;mask-type:alpha"></div><span>ביטול</span></button><button type="submit" class="flex items-center min-w-fit justify-center font-medium rounded-md flex-nowrap bg-solid text-white hover:bg-solid/85 h-10 px-4 gap-3 aria-disabled:pointer-events-none aria-disabled:opacity-50" value="approve" data-decision="approve" name="decision"><div aria-hidden="true" class="dark:bg-white bg-white size-4 " style="mask-image:url(https://res.cloudinary.com/dfletli2x/image/upload/icons/sol/check.svg);-webkit-mask-image:url(https://res.cloudinary.com/dfletli2x/image/upload/icons/sol/check.svg);mask-repeat:no-repeat;-webkit-mask-repeat:no-repeat;mask-position:center;-webkit-mask-position:center;mask-size:contain;-webkit-mask-size:contain;mask-type:alpha"></div><span>אשר חיבור ל-Claude</span></button></div></form></div>",
  "cardChatGpt": "<div class="mx-auto mt-16 max-w-md px-4"><form class="rounded-lg border border-gray-200 bg-white p-6 flex flex-col gap-4" action="/api/oauth/consent" method="post"><h1 class="text-lg font-bold">חיבור ChatGPT ל-SocialCRM</h1><p class="text-sm text-gray-600">ChatGPT · <span class="font-medium text-gray-800">chatgpt.com</span></p><p class="text-sm text-gray-600">מחובר בתור <span class="font-medium text-gray-800">דנה</span> · <span class="font-medium text-gray-800">סלון דנה</span></p><div><h2 class="text-sm font-bold">ChatGPT יוכל:</h2><ul class="mt-1 list-disc ps-5 text-sm text-gray-700"><li>צפייה בלידים שלך, במעקבים ובסיכום היומי</li><li>צפייה בסיכומי שיחות WhatsApp עם הלידים שלך, ובהודעות עצמן לפי בקשה</li></ul></div><p class="text-sm text-gray-600">ChatGPT לא יקבל מספרי טלפון או כתובות אימייל, לא יוכל לשנות נתונים ולא ישלח הודעות WhatsApp.</p><input type="hidden" name="csrf" value="cccccccccccccccccccccccccccccccc"/><div class="mt-auto flex items-center justify-end gap-3"><button type="submit" class="flex items-center min-w-fit justify-center font-medium rounded-md flex-nowrap border text-black border-gray-200 bg-white hover:bg-gray-100/60 h-10 px-4 gap-3 aria-disabled:pointer-events-none aria-disabled:opacity-50" value="deny" data-decision="deny" name="decision"><div aria-hidden="true" class="dark:bg-white bg-black size-4 " style="mask-image:url(https://res.cloudinary.com/dfletli2x/image/upload/icons/reg/xmark.svg);-webkit-mask-image:url(https://res.cloudinary.com/dfletli2x/image/upload/icons/reg/xmark.svg);mask-repeat:no-repeat;-webkit-mask-repeat:no-repeat;mask-position:center;-webkit-mask-position:center;mask-size:contain;-webkit-mask-size:contain;mask-type:alpha"></div><span>ביטול</span></button><button type="submit" class="flex items-center min-w-fit justify-center font-medium rounded-md flex-nowrap bg-solid text-white hover:bg-solid/85 h-10 px-4 gap-3 aria-disabled:pointer-events-none aria-disabled:opacity-50" value="approve" data-decision="approve" name="decision"><div aria-hidden="true" class="dark:bg-white bg-white size-4 " style="mask-image:url(https://res.cloudinary.com/dfletli2x/image/upload/icons/sol/check.svg);-webkit-mask-image:url(https://res.cloudinary.com/dfletli2x/image/upload/icons/sol/check.svg);mask-repeat:no-repeat;-webkit-mask-repeat:no-repeat;mask-position:center;-webkit-mask-position:center;mask-size:contain;-webkit-mask-size:contain;mask-type:alpha"></div><span>אשר חיבור ל-ChatGPT</span></button></div></form></div>",
  "cardNoAgency": "<div class="mx-auto mt-16 max-w-md px-4"><form class="rounded-lg border border-gray-200 bg-white p-6 flex flex-col gap-4" action="/api/oauth/consent" method="post"><h1 class="text-lg font-bold">חיבור Claude ל-SocialCRM</h1><p class="text-sm text-gray-600">Claude · <span class="font-medium text-gray-800">claude.ai</span></p><p class="text-sm text-gray-600">מחובר בתור <span class="font-medium text-gray-800">דנה</span></p><div><h2 class="text-sm font-bold">Claude יוכל:</h2><ul class="mt-1 list-disc ps-5 text-sm text-gray-700"><li>צפייה בלידים שלך, במעקבים ובסיכום היומי</li><li>צפייה בסיכומי שיחות WhatsApp עם הלידים שלך, ובהודעות עצמן לפי בקשה</li></ul></div><p class="text-sm text-gray-600">Claude לא יקבל מספרי טלפון או כתובות אימייל, לא יוכל לשנות נתונים ולא ישלח הודעות WhatsApp.</p><input type="hidden" name="csrf" value="cccccccccccccccccccccccccccccccc"/><div class="mt-auto flex items-center justify-end gap-3"><button type="submit" class="flex items-center min-w-fit justify-center font-medium rounded-md flex-nowrap border text-black border-gray-200 bg-white hover:bg-gray-100/60 h-10 px-4 gap-3 aria-disabled:pointer-events-none aria-disabled:opacity-50" value="deny" data-decision="deny" name="decision"><div aria-hidden="true" class="dark:bg-white bg-black size-4 " style="mask-image:url(https://res.cloudinary.com/dfletli2x/image/upload/icons/reg/xmark.svg);-webkit-mask-image:url(https://res.cloudinary.com/dfletli2x/image/upload/icons/reg/xmark.svg);mask-repeat:no-repeat;-webkit-mask-repeat:no-repeat;mask-position:center;-webkit-mask-position:center;mask-size:contain;-webkit-mask-size:contain;mask-type:alpha"></div><span>ביטול</span></button><button type="submit" class="flex items-center min-w-fit justify-center font-medium rounded-md flex-nowrap bg-solid text-white hover:bg-solid/85 h-10 px-4 gap-3 aria-disabled:pointer-events-none aria-disabled:opacity-50" value="approve" data-decision="approve" name="decision"><div aria-hidden="true" class="dark:bg-white bg-white size-4 " style="mask-image:url(https://res.cloudinary.com/dfletli2x/image/upload/icons/sol/check.svg);-webkit-mask-image:url(https://res.cloudinary.com/dfletli2x/image/upload/icons/sol/check.svg);mask-repeat:no-repeat;-webkit-mask-repeat:no-repeat;mask-position:center;-webkit-mask-position:center;mask-size:contain;-webkit-mask-size:contain;mask-type:alpha"></div><span>אשר חיבור ל-Claude</span></button></div></form></div>",
  "expired": "<div class="mx-auto mt-16 max-w-md px-4"><div class="rounded-lg border border-gray-200 bg-white p-6 flex flex-col gap-4"><h1 class="text-lg font-bold">חיבור אפליקציה ל-SocialCRM</h1><p class="text-sm text-gray-600">בקשת החיבור פגה או כבר טופלה. חזור לאפליקציה שממנה התחלת ונסה שוב.</p><div class="mt-auto flex items-center justify-end gap-3"><a class="flex items-center min-w-fit justify-center font-medium rounded-md flex-nowrap border text-black border-gray-200 bg-white hover:bg-gray-100/60 h-10 px-4 gap-3" href="/dashboard"><span>חזרה ל-SocialCRM</span></a></div></div></div>",
  "mcpOff": "NEXT_NOT_FOUND",
  "no_agency": "<div class="mx-auto mt-16 max-w-md px-4"><div class="rounded-lg border border-gray-200 bg-white p-6 flex flex-col gap-4"><h1 class="text-lg font-bold">חיבור Claude ל-SocialCRM</h1><p class="text-sm text-gray-600">לא ניתן לחבר את Claude לחשבון הזה כרגע.</p><div class="mt-auto flex items-center justify-end gap-3"><a class="flex items-center min-w-fit justify-center font-medium rounded-md flex-nowrap border text-black border-gray-200 bg-white hover:bg-gray-100/60 h-10 px-4 gap-3" href="/dashboard"><span>חזרה ל-SocialCRM</span></a></div></div></div>",
  "no_user": "<div class="mx-auto mt-16 max-w-md px-4"><div class="rounded-lg border border-gray-200 bg-white p-6 flex flex-col gap-4"><h1 class="text-lg font-bold">חיבור Claude ל-SocialCRM</h1><p class="text-sm text-gray-600">לא ניתן לחבר את Claude לחשבון הזה כרגע.</p><div class="mt-auto flex items-center justify-end gap-3"><a class="flex items-center min-w-fit justify-center font-medium rounded-md flex-nowrap border text-black border-gray-200 bg-white hover:bg-gray-100/60 h-10 px-4 gap-3" href="/dashboard"><span>חזרה ל-SocialCRM</span></a></div></div></div>",
  "not_allowlisted": "<div class="mx-auto mt-16 max-w-md px-4"><div class="rounded-lg border border-gray-200 bg-white p-6 flex flex-col gap-4"><h1 class="text-lg font-bold">חיבור Claude ל-SocialCRM</h1><p class="text-sm text-gray-600">החיבור ל-Claude עדיין לא זמין בחשבון שלך.</p><div class="mt-auto flex items-center justify-end gap-3"><a class="flex items-center min-w-fit justify-center font-medium rounded-md flex-nowrap border text-black border-gray-200 bg-white hover:bg-gray-100/60 h-10 px-4 gap-3" href="/dashboard"><span>חזרה ל-SocialCRM</span></a></div></div></div>",
  "signedOut": "REDIRECT /auth",
  "subscription_required": "<div class="mx-auto mt-16 max-w-md px-4"><div class="rounded-lg border border-gray-200 bg-white p-6 flex flex-col gap-4"><h1 class="text-lg font-bold">חיבור Claude ל-SocialCRM</h1><p class="text-sm text-gray-600">כדי לחבר את Claude צריך מנוי פעיל או תקופת ניסיון פעילה.</p><div class="mt-auto flex items-center justify-end gap-3"><a class="flex items-center min-w-fit justify-center font-medium rounded-md flex-nowrap border text-black border-gray-200 bg-white hover:bg-gray-100/60 h-10 px-4 gap-3" href="/dashboard"><span>חזרה ל-SocialCRM</span></a><a class="flex items-center min-w-fit justify-center font-medium rounded-md flex-nowrap bg-solid text-white hover:bg-solid/85 h-10 px-4 gap-3" href="/settings/update_payment"><span>לניהול המנוי</span></a></div></div></div>",
  "suspended": "<div class="mx-auto mt-16 max-w-md px-4"><div class="rounded-lg border border-gray-200 bg-white p-6 flex flex-col gap-4"><h1 class="text-lg font-bold">חיבור Claude ל-SocialCRM</h1><p class="text-sm text-gray-600">לא ניתן לחבר את Claude לחשבון הזה כרגע.</p><div class="mt-auto flex items-center justify-end gap-3"><a class="flex items-center min-w-fit justify-center font-medium rounded-md flex-nowrap border text-black border-gray-200 bg-white hover:bg-gray-100/60 h-10 px-4 gap-3" href="/dashboard"><span>חזרה ל-SocialCRM</span></a></div></div></div>",
