exports[`Hebrew baseline — /activate > the CTA busy label, the completed screen copied state, the phone copy states 1`] = `
{
  "busy": "<button class="flex items-center min-w-fit font-medium rounded-md flex-nowrap bg-solid text-white hover:bg-solid/85 h-10 px-4 gap-3 w-full max-w-[320px] justify-center" disabled=""><div aria-hidden="true" class="dark:bg-white bg-white size-4 animate-spin " style="mask-image: url(&quot;https://res.cloudinary.com/dfletli2x/image/upload/icons/sol/spinner.svg&quot;); -webkit-mask-image: url(&quot;https://res.cloudinary.com/dfletli2x/image/upload/icons/sol/spinner.svg&quot;); mask-repeat: no-repeat; -webkit-mask-repeat: no-repeat; mask-position: center; -webkit-mask-position: center; mask-size: contain; -webkit-mask-size: contain; mask-type: alpha;"></div><span>מתחבר…</span></button>",
  "calls": "[["startOAuth"],["continueDesktop"],["copyToClipboard","https://getsocialcrm.com"],["copyToClipboard","https://getsocialcrm.com"]]",
  "copied": "<div class="flex flex-col items-center gap-6 text-center"><h1 class="text-[26px] font-bold text-white desktop:text-[#0f1024]">סביבת העבודה שלך מוכנה.</h1><p class="max-w-[320px] text-[14px] text-white/70 desktop:text-gray-600">מעכשיו, כל ליד חדש יגיע לכאן אוטומטית.</p><p class="max-w-[320px] text-[14px] text-white/85 desktop:text-gray-700">המשך במחשב לחוויה המלאה.</p><button class="flex items-center min-w-fit font-medium rounded-md flex-nowrap bg-solid text-white hover:bg-solid/85 h-10 px-4 gap-3 w-full max-w-[320px] justify-center"><span>הקישור הועתק</span></button><p class="text-[12px] text-white/45 desktop:text-gray-400" dir="rtl">כבר ליד המחשב? היכנס ל-getsocialcrm.com</p></div>",
  "phoneCopied": "<main dir="rtl" class="flex min-h-dvh w-full flex-col items-center justify-center gap-9 overflow-x-hidden px-6" style="background: radial-gradient(120% 80% at 50% 0%, rgb(12, 10, 31) 0%, rgb(6, 8, 26) 50%, rgb(4, 5, 15) 100%); padding-top: calc(2.5rem + env(0px * , * safe-area-inset-top)); padding-bottom: calc(2.5rem + env(0px * , * safe-area-inset-bottom));"><style>
@keyframes mh-float { 0%,100% { transform: translateY(0) } 50% { transform: translateY(-9px) } }
@keyframes mh-breathe { 0%,100% { opacity: .62; transform: scale(1) } 50% { opacity: 1; transform: scale(1.05) } }
@keyframes mh-rise { from { opacity: 0; transform: translateY(12px) } to { opacity: 1; transform: none } }
.mh-rise { opacity: 0; animation: mh-rise 420ms cubic-bezier(0.32,0.72,0,1) forwards; }
@media (prefers-reduced-motion: reduce) {
  .mh-anim { animation: none !important; }
  .mh-rise { animation: none !important; opacity: 1 !important; transform: none !important; }
}
</style><div class="mh-rise w-full" style="animation-delay: 40ms;"><div class="relative mx-auto w-full" style="max-width: min(86vw, 320px);" aria-hidden="true"><div class="mh-anim pointer-events-none absolute rounded-full" style="inset: -16%; background: radial-gradient(rgba(252, 191, 73, 0.22) 0%, rgba(63, 32, 245, 0.13) 45%, transparent 72%); filter: blur(38px); animation: mh-breathe 7s ease-in-out infinite;"></div><div class="mh-anim relative overflow-hidden rounded-2xl" style="background: rgba(255, 255, 255, 0.045); border: 1px solid rgba(255, 255, 255, 0.1); backdrop-filter: blur(14px); box-shadow: 0 30px 70px rgba(0,0,0,0.55), inset 0 1px 0 rgba(255,255,255,0.10); animation: mh-float 7s ease-in-out infinite;"><div class="flex items-center gap-1.5 px-4 py-3" style="border-bottom: 1px solid rgba(255, 255, 255, 0.07);"><span class="size-2 rounded-full" style="background: rgba(255, 255, 255, 0.2);"></span><span class="size-2 rounded-full" style="background: rgba(255, 255, 255, 0.14);"></span><span class="size-2 rounded-full" style="background: rgba(255, 255, 255, 0.1);"></span></div><div class="flex flex-col gap-4 px-4 py-5"><div class="flex items-center gap-3"><div class="relative inline-flex items-center justify-center"><div class="absolute rounded-full animate-pulse" style="inset: -15px; background: radial-gradient(rgba(252, 191, 73, 0.45) 0%, rgba(251, 146, 60, 0.15) 38%, transparent 70%); filter: blur(26px);"></div><div class="relative grid place-items-center" style="width: 34px; height: 34px; border-radius: 10px; background: linear-gradient(135deg, rgb(254, 252, 247) 0%, rgb(250, 242, 220) 60%, rgb(245, 230, 184) 100%); box-shadow: 0 18px 44px rgba(0,0,0,0.55), 0 0 48px rgba(252,191,73,0.28), inset 0 1px 0 rgba(255,255,255,1), inset 0 0 0 1px rgba(255,255,255,0.5);"><img alt="SocialCRM" width="21" height="21" style="width: 21px; height: 21px;" draggable="false" src="/media/fav.svg"></div></div><span class="flex flex-1 flex-col gap-1.5"><span class="block h-2 rounded-full" style="width: 58%; background: rgba(255, 255, 255, 0.14);"></span><span class="block h-2 rounded-full" style="width: 34%; background: rgba(255, 255, 255, 0.08);"></span></span></div><div class="flex flex-col gap-3"><div class="flex items-center gap-2"><span class="block h-2 rounded-full" style="width: 86%; background: rgba(255, 255, 255, 0.14);"></span><span class="h-3.5 flex-none rounded-full" style="width: 34px; background: rgba(252, 191, 73, 0.28);"></span></div><div class="flex items-center gap-2"><span class="block h-2 rounded-full" style="width: 64%; background: rgba(255, 255, 255, 0.08);"></span></div><div class="flex items-center gap-2"><span class="block h-2 rounded-full" style="width: 74%; background: rgba(255, 255, 255, 0.08);"></span></div></div></div></div></div></div><div class="mh-rise flex w-full max-w-[340px] flex-col items-center gap-3 text-center" style="animation-delay: 130ms;"><h1 class="text-[26px] font-bold leading-tight text-white">SocialCRM עובד במיטבו במחשב.</h1><p class="text-[14px] leading-[1.75] text-white/60">המערכת מותאמת למסך גדול, כדי לנהל לידים, שיחות ו-AI במקום אחד.</p></div><div class="flex w-full max-w-[340px] flex-col items-center"><div class="mh-rise flex w-full flex-col items-center gap-3" style="animation-delay: 220ms;"><button class="flex items-center min-w-fit font-medium rounded-md flex-nowrap bg-solid text-white hover:bg-solid/85 h-11 px-5 gap-4 text-lg w-full max-w-[320px] justify-center"><div aria-hidden="true" class="dark:bg-white bg-white size-5 " style="mask-image: url(&quot;https://res.cloudinary.com/dfletli2x/image/upload/icons/sol/check.svg&quot;); -webkit-mask-image: url(&quot;https://res.cloudinary.com/dfletli2x/image/upload/icons/sol/check.svg&quot;); mask-repeat: no-repeat; -webkit-mask-repeat: no-repeat; mask-position: center; -webkit-mask-position: center; mask-size: contain; -webkit-mask-size: contain; mask-type: alpha;"></div><span>הקישור הועתק</span></button><p class="select-all text-center text-[13px] tracking-wide text-white/45" dir="ltr">getsocialcrm.com</p><p role="status" aria-live="polite" class="min-h-[1rem] text-center text-[12px] text-white/55">הקישור הועתק</p></div></div><div class="mh-rise flex w-full max-w-[340px] flex-col items-center gap-3" style="animation-delay: 300ms;"><span aria-hidden="true" class="h-px w-full" style="background: rgba(255, 255, 255, 0.08);"></span><p class="text-[12px] tracking-wide text-white/45">אפליקציה לנייד — בפיתוח</p><a href="/support" class="text-[12px] text-white/60 underline-offset-4 hover:underline">צריך עזרה? דברו איתנו</a></div></main>",
  "phoneFailed": "<main dir="rtl" class="flex min-h-dvh w-full flex-col items-center justify-center gap-9 overflow-x-hidden px-6" style="background: radial-gradient(120% 80% at 50% 0%, rgb(12, 10, 31) 0%, rgb(6, 8, 26) 50%, rgb(4, 5, 15) 100%); padding-top: calc(2.5rem + env(0px * , * safe-area-inset-top)); padding-bottom: calc(2.5rem + env(0px * , * safe-area-inset-bottom));"><style>
@keyframes mh-float { 0%,100% { transform: translateY(0) } 50% { transform: translateY(-9px) } }
