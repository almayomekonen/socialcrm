ext-white hover:bg-solid/85 h-10 px-4 gap-3 aria-disabled:pointer-events-none aria-disabled:opacity-50" name="decision" value="approve" data-decision="approve" aria-disabled="true"><div aria-hidden="true" class="dark:bg-white bg-white size-4 " style="mask-image: url(&quot;https://res.cloudinary.com/dfletli2x/image/upload/icons/sol/check.svg&quot;); -webkit-mask-image: url(&quot;https://res.cloudinary.com/dfletli2x/image/upload/icons/sol/check.svg&quot;); mask-repeat: no-repeat; -webkit-mask-repeat: no-repeat; mask-position: center; -webkit-mask-position: center; mask-size: contain; -webkit-mask-size: contain; mask-type: alpha;"></div><span>אשר חיבור ל-Claude</span></button></div></form></div>",
