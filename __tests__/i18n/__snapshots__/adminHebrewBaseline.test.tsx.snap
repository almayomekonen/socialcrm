exports[`Hebrew baseline — admin settings (server HTML) > quote-templates: active + archived, only archived, empty, expired, no permission 1`] = `
{
  "base": "<div class="grid gap-6 max-w-3xl"><header class="flex items-end justify-between gap-4"><div><h1 class="text-xl font-semibold text-gray-800">תבניות הצעות מחיר</h1><p class="text-sm text-gray-500 mt-1">המחירים שמהם נבנות ההצעות. הצעה שנשלחה שומרת את המחיר שלה — עדכון תבנית לא משנה הצעות קיימות.</p></div><button class="flex items-center min-w-fit justify-center font-medium rounded-md flex-nowrap bg-solid text-white hover:bg-solid/85 h-10 px-4 gap-3"><div aria-hidden="true" class="dark:bg-white bg-white size-4 " style="mask-image:url(https://res.cloudinary.com/dfletli2x/image/upload/icons/sol/file-plus.svg);-webkit-mask-image:url(https://res.cloudinary.com/dfletli2x/image/upload/icons/sol/file-plus.svg);mask-repeat:no-repeat;-webkit-mask-repeat:no-repeat;mask-position:center;-webkit-mask-position:center;mask-size:contain;-webkit-mask-size:contain;mask-type:alpha"></div><span>הצעת מחיר חדשה</span></button></header><ul class="border rounded-md bg-white divide-y"><li class="px-4 py-3 flex items-start justify-between gap-4"><div class="min-w-0"><p class="font-semibold text-gray-800 truncate">בניית אתר תדמית</p><p class="text-sm text-gray-500 mt-0.5">2 שורות · 1 אופציונליות · ‏4,500 ‏₪ לפני מע״מ · תוקף 14 ימים</p><p class="text-sm text-gray-400 mt-0.5">פעילה · עודכן לפני 2 ש׳</p></div><div class="flex gap-2 shrink-0"><button class="flex items-center min-w-fit justify-center font-medium rounded-md flex-nowrap border text-black border-gray-200 bg-white hover:bg-gray-100/60 h-9 px-3 gap-3 text-[15px]"><span>עריכה</span></button><button class="flex items-center min-w-fit justify-center font-medium rounded-md flex-nowrap bg-transparent text-black hover:bg-gray-100/60 h-9 px-3 gap-3 text-[15px]"><span>לארכיון</span></button></div></li></ul><section class="grid gap-3"><h2 class="text-sm font-semibold text-gray-600">ארכיון</h2><ul class="border rounded-md bg-white divide-y"><li class="px-4 py-3 flex items-start justify-between gap-4"><div class="min-w-0"><p class="font-semibold text-gray-800 truncate">ניהול קמפיין</p><p class="text-sm text-gray-500 mt-0.5">שורה אחת · ‏1,200 ‏₪ לפני מע״מ · תוקף יום אחד</p><p class="text-sm text-gray-400 mt-0.5">בארכיון · עודכן לפני 3 ימים</p></div><div class="flex gap-2 shrink-0"><button class="flex items-center min-w-fit justify-center font-medium rounded-md flex-nowrap border text-black border-gray-200 bg-white hover:bg-gray-100/60 h-9 px-3 gap-3 text-[15px]"><span>עריכה</span></button><button class="flex items-center min-w-fit justify-center font-medium rounded-md flex-nowrap bg-transparent text-black hover:bg-gray-100/60 h-9 px-3 gap-3 text-[15px]"><span>החזרה לשימוש</span></button></div></li></ul></section></div>",
  "empty": "<div class="grid gap-6 max-w-3xl"><header class="flex items-end justify-between gap-4"><div><h1 class="text-xl font-semibold text-gray-800">תבניות הצעות מחיר</h1><p class="text-sm text-gray-500 mt-1">המחירים שמהם נבנות ההצעות. הצעה שנשלחה שומרת את המחיר שלה — עדכון תבנית לא משנה הצעות קיימות.</p></div><button class="flex items-center min-w-fit justify-center font-medium rounded-md flex-nowrap bg-solid text-white hover:bg-solid/85 h-10 px-4 gap-3"><div aria-hidden="true" class="dark:bg-white bg-white size-4 " style="mask-image:url(https://res.cloudinary.com/dfletli2x/image/upload/icons/sol/file-plus.svg);-webkit-mask-image:url(https://res.cloudinary.com/dfletli2x/image/upload/icons/sol/file-plus.svg);mask-repeat:no-repeat;-webkit-mask-repeat:no-repeat;mask-position:center;-webkit-mask-position:center;mask-size:contain;-webkit-mask-size:contain;mask-type:alpha"></div><span>הצעת מחיר חדשה</span></button></header><div class="border border-dashed rounded-md bg-white text-center py-12 px-6"><p class="text-base text-gray-700 mb-1">אין עדיין תבניות הצעות מחיר</p><p class="text-sm text-gray-500 mb-4">תבנית מרכזת את המחירים שאתם מציעים, כך שאפשר לשלוח הצעה בלי להקליד אותה מחדש בכל פעם.</p><button class="flex items-center min-w-fit justify-center font-medium rounded-md flex-nowrap bg-solid text-white hover:bg-solid/85 h-10 px-4 gap-3"><div aria-hidden="true" class="dark:bg-white bg-white size-4 " style="mask-image:url(https://res.cloudinary.com/dfletli2x/image/upload/icons/sol/file-plus.svg);-webkit-mask-image:url(https://res.cloudinary.com/dfletli2x/image/upload/icons/sol/file-plus.svg);mask-repeat:no-repeat;-webkit-mask-repeat:no-repeat;mask-position:center;-webkit-mask-position:center;mask-size:contain;-webkit-mask-size:contain;mask-type:alpha"></div><span>הצעת מחיר חדשה</span></button></div></div>",
  "expired": "<div class="mb-6 max-w-2xl"><div data-testid="subscription-expired-inline" class="flex flex-wrap items-center gap-3 rounded-lg border border-warning-border bg-warning-bg px-3.5 py-3 "><div aria-hidden="true" class="dark:bg-white size-4 shrink-0 bg-warning-text " style="mask-image:url(https://res.cloudinary.com/dfletli2x/image/upload/icons/sol/lock.svg);-webkit-mask-image:url(https://res.cloudinary.com/dfletli2x/image/upload/icons/sol/lock.svg);mask-repeat:no-repeat;-webkit-mask-repeat:no-repeat;mask-position:center;-webkit-mask-position:center;mask-size:contain;-webkit-mask-size:contain;mask-type:alpha"></div><p class="min-w-0 flex-1 text-[13px] leading-snug text-warning-text">חידוש המנוי מחזיר את עריכת תבניות הצעות המחיר</p><a href="/settings/update_payment?source=quote_templates_settings" class="shrink-0 text-[13px] font-semibold text-warning-text underline underline-offset-2">חידוש מנוי</a></div></div><div class="grid gap-6 max-w-3xl"><header class="flex items-end justify-between gap-4"><div><h1 class="text-xl font-semibold text-gray-800">תבניות הצעות מחיר</h1><p class="text-sm text-gray-500 mt-1">המחירים שמהם נבנות ההצעות. הצעה שנשלחה שומרת את המחיר שלה — עדכון תבנית לא משנה הצעות קיימות.</p></div><button class="flex items-center min-w-fit justify-center font-medium rounded-md flex-nowrap bg-solid text-white hover:bg-solid/85 h-10 px-4 gap-3"><div aria-hidden="true" class="dark:bg-white bg-white size-4 " style="mask-image:url(https://res.cloudinary.com/dfletli2x/image/upload/icons/sol/file-plus.svg);-webkit-mask-image:url(https://res.cloudinary.com/dfletli2x/image/upload/icons/sol/file-plus.svg);mask-repeat:no-repeat;-webkit-mask-repeat:no-repeat;mask-position:center;-webkit-mask-position:center;mask-size:contain;-webkit-mask-size:contain;mask-type:alpha"></div><span>הצעת מחיר חדשה</span></button></header><ul class="border rounded-md bg-white divide-y"><li class="px-4 py-3 flex items-start justify-between gap-4"><div class="min-w-0"><p class="font-