  "screenNotConnected": "<div class="px-4 pb-8 pt-4"><a class="mb-3 inline-flex min-h-11 items-center text-sm font-medium text-primary-text" href="/settings/integrations">חזרה לאינטגרציות</a><h1 class="text-xl font-bold text-ink">הודעות מוכנות</h1><div class="mt-3 grid gap-3"><div role="status" class="rounded-md border p-3 border-amber-300 bg-amber-50"><p class="text-sm font-medium text-amber-800">צריך לחבר וואטסאפ עסקי</p><p class="mt-1 text-sm text-amber-700">כדי ליצור הודעות WhatsApp מוכנות, חברו קודם את מספר הוואטסאפ העסקי.</p></div><a class="press flex min-h-11 items-center justify-center rounded-md bg-solid font-medium text-white" href="/settings/integrations?section=whatsapp">למעבר לחיבור וואטסאפ</a></div></div>",
  "screenNotReady": "<div class="px-4 pb-8 pt-4"><a class="mb-3 inline-flex min-h-11 items-center text-sm font-medium text-primary-text" href="/settings/integrations">חזרה לאינטגרציות</a><h1 class="text-xl font-bold text-ink">הודעות מוכנות</h1><div class="mt-3"><div role="status" class="rounded-md border p-3 border-amber-300 bg-amber-50"><p class="text-sm font-medium text-amber-800">חיבור הוואטסאפ עדיין לא מוכן</p><p class="mt-1 text-sm text-amber-700">לאחר שהחיבור יאומת, אפשר יהיה ליצור הודעות WhatsApp מוכנות.</p></div></div></div>",
  "templatesOff": "<link rel="preload" as="image" href="/media/social-icons/google-calendar-color.svg"/><link rel="preload" as="image" href="/media/social-icons/google-drive-color.svg"/><div data-testid="integrations-mobile" class="px-4 pb-8 pt-4"><header class="mb-5"><h1 class="text-xl font-bold leading-tight text-ink">אינטגרציות</h1><p class="mt-1.5 text-sm leading-relaxed text-gray-500">מה מחובר, מה לא, ומה הצעד הבא — במקום אחד.</p></header><section class="flex flex-col gap-3" aria-label="מקורות לידים"><h2 class="text-sm font-semibold text-gray-500">מקורות לידים</h2><article class="rounded-xl border border-gray-200 bg-white p-4"><div class="flex items-start gap-3"><div class="shrink-0"><div class="relative flex shrink-0 items-center " aria-hidden="true"><div class="flex size-7 rounded-lg items-center justify-center shadow-sm ring-1 ring-white bg-[#25D366] "><div aria-hidden="true" class="dark:bg-white size-3.5 bg-white " style="mask-image:url(https://res.cloudinary.com/dfletli2x/image/upload/icons/sol/whatsapp.svg);-webkit-mask-image:url(https://res.cloudinary.com/dfletli2x/image/upload/icons/sol/whatsapp.svg);mask-repeat:no-repeat;-webkit-mask-repeat:no-repeat;mask-position:center;-webkit-mask-position:center;mask-size:contain;-webkit-mask-size:contain;mask-type:alpha"></div></div></div></div><div class="min-w-0 flex-1"><div class="flex flex-wrap items-center gap-2"><h2 class="text-[15px] font-semibold leading-tight text-ink">וואטסאפ</h2><span class="inline-flex shrink-0 items-center rounded-full border font-medium tabular-nums gap-1 px-1.5 py-0.5 text-[10px] leading-tight " style="background-color:var(--color-success-bg);color:var(--color-success-text);border-color:var(--color-success-border)"><span class="shrink-0 rounded-full size-1 " style="background-color:var(--color-success-dot)"></span>מחובר</span></div><p class="mt-1.5 text-sm leading-relaxed text-gray-600">החיבור תקין — לידים מגיעים אוטומטית.</p></div></div><button type="button" class="press flex min-h-11 w-full items-center justify-center rounded-md bg-solid font-medium text-white hover:bg-solid/85 focus:outline-none focus-visible:ring-2 focus-visible:ring-primary disabled:opacity-60 mt-4">ניהול</button></article><article class="rounded-xl border border-gray-200 bg-white p-4"><div class="flex items-start gap-3"><div class="shrink-0"><div class="relative flex shrink-0 items-center " aria-hidden="true"><div class="flex size-7 rounded-lg items-center justify-center shadow-sm ring-1 ring-white bg-[#1877F2] "><div aria-hidden="true" class="dark:bg-white size-3.5 bg-white " style="mask-image:url(https://res.cloudinary.com/dfletli2x/image/upload/icons/sol/facebook-f.svg);-webkit-mask-image:url(https://res.cloudinary.com/dfletli2x/image/upload/icons/sol/facebook-f.svg);mask-repeat:no-repeat;-webkit-mask-repeat:no-repeat;mask-position:center;-webkit-mask-position:center;mask-size:contain;-webkit-mask-size:contain;mask-type:alpha"></div></div><div class="flex size-7 rounded-lg items-center justify-center shadow-sm ring-1 ring-white bg-gradient-to-tr from-[#F58529] via-[#DD2A7B] to-[#8134AF] -ms-2.5"><div aria-hidden="true" class="dark:bg-white size-3.5 bg-white " style="mask-image:url(https://res.cloudinary.com/dfletli2x/image/upload/icons/sol/instagram.svg);-webkit-mask-image:url(https://res.cloudinary.com/dfletli2x/image/upload/icons/sol/instagram.svg);mask-repeat:no-repeat;-webkit-mask-repeat:no-repeat;mask-position:center;-webkit-mask-position:center;mask-size:contain;-webkit-mask-size:contain;mask-type:alpha"></div></div></div></div><div class="min-w-0 flex-1"><div class="flex flex-wrap items-center gap-2"><h2 class="text-[15px] font-semibold leading-tight text-ink">פייסבוק ואינסטגרם</h2><span class="inline-flex shrink-0 items-center rounded-full border font-medium tabular-nums gap-1 px-1.5 py-0.5 text-[10px] leading-tight " style="background-color:var(--color-success-bg);color:var(--color-success-text);border-color:var(--color-success-border)"><span class="shrink-0 rounded-full size-1 " style="background-color:var(--color-success-dot)"></span>מחובר</span></div><p class="mt-1.5 text-sm leading-relaxed text-gray-600">מחובר לדף סטודיו דנה — לידים מגיעים אוטומטית.</p></div></div><button type="button" class="press flex min-h-11 w-full items-center justify-center rounded-md bg-solid font-medium text-white hover:bg-solid/85 focus:outline-none focus-visible:ring-2 focus-visible:ring-primary disabled:opacity-60 mt-4">ניהול</button></article></section><section class="mt-8 flex flex-col gap-3" aria-label="כלים מחוברים"><h2 class="text-sm font-semibold text-gray-500">כלים מחוברים</h2><article class="rounded-xl border border-gray-200 bg-white p-4"><div class="flex items-start gap-3"><div class="shrink-0"><img src="/media/social-icons/google-calendar-color.svg" alt="" aria-hidden="true" class="size-7 shrink-0 object-contain"/></div><div class="min-w-0 flex-1"><div class="flex flex-wrap items-center gap-2"><h2 class="text-[15px] font-semibold leading-tight text-ink">Google Calendar</h2><span class="inline-flex shrink-0 items-center rounded-full border font-medium tabular-nums gap-1 px-1.5 py-0.5 text-[10px] leading-tight " style="background-color:var(--color-success-bg);color:var(--color-success-text);border-color:var(--color-success-border)"><span class="shrink-0 rounded-full size-1 " style="background-color:var(--color-success-dot)"></span>מחובר</span></div><p class="mt-1.5 text-sm leading-relaxed text-gray-600">מחובר · dana@gmail.test</p></div></div><button type="button" class="press flex min-h-11 w-full items-center justify-center rounded-md bg-solid font-medium text-white hover:bg-solid/85 focus:outline-none focus-visible:ring-2 focus-visible:ring-primary disabled:opacity-60 mt-4">ניהול</button></article><article class="rounded-xl border border-gray-200 bg-white p-4"><div class="flex items-start gap-3"><div class="shrink-0"><img src="/media/social-icons/google-drive-color.svg" alt="" aria-hidden="true" class="size-7 shrink-0 object-contain"/></div><div class="min-w-0 flex-1"><div class="flex flex-wrap items-center gap-2"><h2 class="text-[15px] font-semibold leading-tight text-ink">Google Drive</h2><span class="inline-flex shrink-0 items-center rounded-full border font-medium tabular-nums gap-1 px-1.5 py-0.5 text-[10px] leading-tight " style="background-color:var(--color-neutral-bg);color:var(--color-neutral-text);border-color:var(--color-neutral-border)"><span class="shrink-0 rounded-full size-1 " style="background-color:var(--color-neutral-dot)"></span>טוען…</span></div><p class="mt-1.5 text-sm leading-relaxed text-gray-600">חיפוש, צירוף וניתוח של קבצים מ-Drive ישירות בתוך הלידים ובעוזר החכם.</p></div></div><button type="button" class="press flex min-h-11 w-full items-center justify-center rounded-md bg-solid font-medium text-white hover:bg-solid/85 focus:outline-none focus-visible:ring-2 focus-visible:ring-primary disabled:opacity-60 mt-4">חבר את Google Drive</button></article></section></div>",
  "website": "<div class="px-4 pb-8 pt-4"><a class="mb-3 inline-flex min-h-11 items-center text-sm font-medium text-primary-text" href="/settings/integrations">חזרה לאינטגרציות</a><h1 class="mb-3 text-xl font-bold text-ink">האתר שלי</h1><div data-testid="website-connection"></div></div>",
}
`;

