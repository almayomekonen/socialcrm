exports[`Hebrew baseline — deal form > expired: the lock panel instead of the form 1`] = `"<div data-testid="subscription-expired-state" class="flex flex-col items-center gap-4 text-center px-6 py-12 "><span class="flex size-14 items-center justify-center rounded-full bg-gray-100"><div aria-hidden="true" class="dark:bg-white size-6 bg-gray-500 " style="mask-image: url(&quot;https://res.cloudinary.com/dfletli2x/image/upload/icons/sol/lock.svg&quot;); -webkit-mask-image: url(&quot;https://res.cloudinary.com/dfletli2x/image/upload/icons/sol/lock.svg&quot;); mask-repeat: no-repeat; -webkit-mask-repeat: no-repeat; mask-position: center; -webkit-mask-position: center; mask-size: contain; -webkit-mask-size: contain; mask-type: alpha;"></div></span><div class="max-w-[380px]"><h2 class="text-lg font-bold text-ink">המנוי שלך הסתיים</h2><p class="mt-1.5 text-sm leading-relaxed text-gray-500">חידוש המנוי מחזיר את סגירת העסקאות. כל הלידים, השיחות וההיסטוריה שלכם שמורים ונשארים זמינים. חידוש המנוי מחזיר את היכולות המתקדמות מיד.</p><p class="mt-1.5 text-[13px] text-gray-400">תוקף המנוי הסתיים בתאריך 20 באוקטובר 2026</p></div><a href="/settings/update_payment?source=close_deal" class="press inline-flex min-h-11 items-center justify-center rounded-md bg-solid px-5 font-medium text-white hover:bg-solid/85 focus:outline-none focus-visible:ring-2 focus-visible:ring-primary">חידוש מנוי</a></div>"`;

