  "noAccounts": "<div class="grid grid-cols-[minmax(0,1fr)] gap-4 py-6"><h1 class="title">ביצועי מודעות</h1><div class="grid max-w-2xl gap-2"><div role="status" class="rounded-md border p-3 border-amber-300 bg-amber-50"><p class="text-sm font-medium text-amber-800">לא נמצאו חשבונות מודעות</p><p class="mt-1 text-sm text-amber-700">החיבור הצליח, אבל פייסבוק לא החזיר אף חשבון מודעות שהמשתמש המחובר מורשה לצפות בו.</p><p class="mt-2 text-xs text-amber-700/80">בדרך כלל בגלל:</p><ul class="mt-0.5 list-disc ps-5 text-sm text-amber-700"><li>לא נבחר חשבון מודעות במסך האישור</li><li>למשתמש אין הרשאה לחשבון המודעות ב-Business Manager</li></ul><p class="mt-2 text-sm text-amber-700">לחבר מחדש ולבחור את חשבון המודעות, או לבקש גישה לחשבון.</p></div><div class="grid gap-2"><button class="flex items-center min-w-fit justify-center font-medium rounded-md flex-nowrap bg-solid text-white hover:bg-solid/85 h-9 px-3 gap-3 text-[15px] w-fit"><div aria-hidden="true" class="dark:bg-white bg-white size-[15px] " style="mask-image:url(https://res.cloudinary.com/dfletli2x/image/upload/icons/sol/facebook.svg);-webkit-mask-image:url(https://res.cloudinary.com/dfletli2x/image/upload/icons/sol/facebook.svg);mask-repeat:no-repeat;-webkit-mask-repeat:no-repeat;mask-position:center;-webkit-mask-position:center;mask-size:contain;-webkit-mask-size:contain;mask-type:alpha"></div><span>חבר מחדש ובחר חשבון</span></button></div><button class="flex items-center min-w-fit justify-center font-medium rounded-md flex-nowrap bg-red-600 text-white hover:bg-red-700 h-9 px-3 gap-3 text-[15px] w-fit"><span>נתק חשבון מודעות</span></button></div><section aria-label="לידים ממודעות Meta ב-SocialCRM" class="@container/crm grid gap-3"><div><h2 class="text-base font-semibold text-gray-900">לידים ממודעות Meta ב-SocialCRM</h2><p class="text-xs text-gray-500"><span dir="ltr">15.09.2026–14.10.2026</span> · 8 לידים שנקלטו עם זיהוי קמפיין מ-Meta. הוצאה ונתוני Meta יוצגו אחרי חיבור חשבון המודעות.</p></div><ul class="grid grid-cols-1 items-start gap-3 @3xl/crm:grid-cols-2"><li class="@container min-w-0 rounded-lg border border-gray-200 bg-white p-4 shadow-xs"><h3 class="truncate text-[15px] font-semibold text-gray-900" title="קמפיין לידים ספטמבר">קמפיין לידים ספטמבר</h3><div class="mt-2"><div class="rounded-md border border-primary/15 bg-primary-tint/40 px-3 py-2"><p class="mb-1 text-[11px] font-medium text-primary-text">ב-SocialCRM</p><dl class="grid grid-cols-3 gap-2 @md:grid-cols-5"><div class="min-w-0"><dt class="text-[11px] text-gray-500">נקלטו</dt><dd dir="ltr" class="text-right text-sm font-semibold text-gray-900 tabular-nums">7</dd></div><div class="min-w-0" title="כל ליד שהסטטוס שלו כבר לא &quot;חדש&quot;"><dt class="text-[11px] text-gray-500">טופלו</dt><dd dir="ltr" class="text-right text-sm font-semibold text-gray-900 tabular-nums">5</dd></div><div class="min-w-0" title="לידים שעדיין בסטטוס &quot;חדש&quot;"><dt class="text-[11px] text-gray-500">לא טופלו</dt><dd dir="ltr" class="text-right text-sm font-semibold text-gray-900 tabular-nums">2</dd></div><div class="min-w-0"><dt class="text-[11px] text-gray-500">מעוניינים</dt><dd dir="ltr" class="text-right text-sm font-semibold text-gray-900 tabular-nums">0</dd></div><div class="min-w-0" title="לידים בסטטוס &quot;סגור&quot;"><dt class="text-[11px] text-gray-500">נסגרו</dt><dd dir="ltr" class="text-right text-sm font-semibold text-gray-900 tabular-nums">0</dd></div></dl></div></div></li><li class="@container min-w-0 rounded-lg border border-gray-200 bg-white p-4 shadow-xs"><h3 class="truncate text-[15px] font-semibold text-gray-900">קמפיין ללא שם</h3><div class="mt-2"><div class="rounded-md border border-primary/15 bg-primary-tint/40 px-3 py-2"><p class="mb-1 text-[11px] font-medium text-primary-text">ב-SocialCRM</p><dl class="grid grid-cols-3 gap-2 @md:grid-cols-5"><div class="min-w-0"><dt class="text-[11px] text-gray-500">נקלטו</dt><dd dir="ltr" class="text-right text-sm font-semibold text-gray-900 tabular-nums">1</dd></div><div class="min-w-0" title="כל ליד שהסטטוס שלו כבר לא &quot;חדש&quot;"><dt class="text-[11px] text-gray-500">טופלו</dt><dd dir="ltr" class="text-right text-sm font-semibold text-gray-900 tabular-nums">0</dd></div><div class="min-w-0" title="לידים שעדיין בסטטוס &quot;חדש&quot;"><dt class="text-[11px] text-gray-500">לא טופלו</dt><dd dir="ltr" class="text-right text-sm font-semibold text-gray-900 tabular-nums">1</dd></div><div class="min-w-0"><dt class="text-[11px] text-gray-500">מעוניינים</dt><dd dir="ltr" class="text-right text-sm font-semibold text-gray-900 tabular-nums">0</dd></div><div class="min-w-0" title="לידים בסטטוס &quot;סגור&quot;"><dt class="text-[11px] text-gray-500">נסגרו</dt><dd dir="ltr" class="text-right text-sm font-semibold text-gray-900 tabular-nums">0</dd></div></dl></div></div></li></ul></section></div>",
  "noActivity": "<div class="grid grid-cols-[minmax(0,1fr)] gap-4 py-6"><h1 class="title">ביצועי מודעות</h1><div class="grid gap-4"><div class="flex flex-wrap items-end justify-between gap-3"><div class="flex flex-wrap items-end gap-3"><div class="w-64 max-w-full"><div class="block"><div class="flex justify-between mb-1 ms-1 items-end "><label for="ads-account" class="text-gray-600 text-sm font-medium ">חשבון מודעות</label></div><select id="ads-account" class="h-10 w-full rounded-md border border-gray-200 bg-white px-3 focus:outline-2 focus:outline-offset-0 focus:outline-primary"><option value="act_1" selected="">חשבון ראשי</option><option value="act_2">Second</option></select></div></div><div class="w-48 max-w-full"><div class="block"><div class="flex justify-between mb-1 ms-1 items-end "><label for="ads-range" class="text-gray-600 text-sm font-medium ">טווח תאריכים</label></div><select id="ads-range" class="h-10 w-full rounded-md border border-gray-200 bg-white px-3 focus:outline-2 focus:outline-offset-0 focus:outline-primary"><option value="today">היום</option><option value="last_7d">7 ימים אחרונים</option><option value="last_30d" selected="">30 ימים אחרונים</option><option value="this_month">החודש</option><option value="last_month">החודש הקודם</option><option value="custom">טווח תאריכים</option></select></div></div></div><button class="flex items-center min-w-fit justify-center font-medium rounded-md flex-nowrap bg-red-600 text-white hover:bg-red-700 h-9 px-3 gap-3 text-[15px] w-fit"><span>נתק חשבון מודעות</span></button></div><div role="status" class="flex min-h-9 flex-wrap items-center gap-2 text-sm" data-testid="ads-report-status"><span class="text-gray-600">הבחירה: חשבון ראשי · 30 ימים אחרונים</span></div><div aria-busy="false" class="transition-opacity duration-150 " data-testid="ads-report-body"><div class="grid max-w-2xl gap-2"><div role="status" class="rounded-md border p-3 border-amber-300 bg-amber-50"><p class="text-sm font-medium text-amber-800">אין פעילות בטווח הזה</p><p class="mt-1 text-sm text-amber-700">Meta לא החזירה נתוני ביצועים לחשבון הזה בטווח התאריכים שנבחר — לא הייתה הוצאה או חשיפה בטווח הזה. זה לא אומר שהחשבון לא פרסם בתקופות אחרות.</p><p class="mt-2 text-sm text-amber-700">אפשר לבחור טווח תאריכים אחר (למשל טווח מותאם) או חשבון מודעות אחר.</p></div></div></div></div></div>",
  "notAdmin": "<div class="grid grid-cols-[minmax(0,1fr)] gap-4 py-6"><h1 class="title">ביצועי מודעות</h1><p class="text-sm text-gray-600">ביצועי המודעות זמינים למנהלי החשבון בלבד.</p></div>",
  "reportRateLimited": "<div class="grid grid-cols-[minmax(0,1fr)] gap-4 py-6"><h1 class="title">ביצועי מודעות</h1><div class="grid gap-4"><div class="flex flex-wrap items-end justify-between gap-3"><div class="flex flex-wrap items-end gap-3"><div class="w-64 max-w-full"><div class="block"><div class="flex justify-between mb-1 ms-1 items-end "><label for="ads-account" class="text-gray-600 text-sm font-medium ">חשבון מודעות</label></div><select id="ads-account" class="h-10 w-full rounded-md border border-gray-200 bg-white px-3 focus:outline-2 focus:outline-offset-0 focus:outline-primary"><option value="act_1" selected="">חשבון ראשי</option><option value="act_2">Second</option></select></div></div><div class="w-48 max-w-full"><div class="block"><div class="flex justify-between mb-1 ms-1 items-end "><label for="ads-range" class="text-gray-600 text-sm font-medium ">טווח תאריכים</label></div><select id="ads-range" class="h-10 w-full rounded-md border border-gray-200 bg-white px-3 focus:outline-2 focus:outline-offset-0 focus:outline-primary"><option value="today">היום</option><option value="last_7d">7 ימים אחרונים</option><option value="last_30d">30 ימים אחרונים</option><option value="this_month">החודש</option><option value="last_month">החודש הקודם</option><option value="custom" selected="">טווח תאריכים</option></select></div></div><div class="block"><div class="flex justify-between mb-1 ms-1 items-end "><label for="ads-since" class="text-gray-600 text-sm font-medium ">מתאריך</label></div><input id="ads-since" type="date" class="h-10 w-full rounded-md border border-gray-200 bg-white px-3 focus:outline-2 focus:outline-offset-0 focus:outline-primary" max="2026-10-15" value="2026-10-10"/></div><div class="block"><div class="flex justify-between mb-1 ms-1 items-end "><label for="ads-until" class="text-gray-600 text-sm font-medium ">עד תאריך</label></div><input id="ads-until" type="date" class="h-10 w-full rounded-md border border-gray-200 bg-white px-3 focus:outline-2 focus:o