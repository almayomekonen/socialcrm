  "adsets": "<div class="grid grid-cols-[minmax(0,1fr)] gap-4 py-6"><h1 class="title">ביצועי מודעות</h1><div class="grid gap-4"><div class="flex flex-wrap items-end justify-between gap-3"><div class="flex flex-wrap items-end gap-3"><div class="w-64 max-w-full"><div class="block"><div class="flex justify-between mb-1 ms-1 items-end "><label for="ads-account" class="text-gray-600 text-sm font-medium ">חשבון מודעות</label></div><select id="ads-account" class="h-10 w-full rounded-md border border-gray-200 bg-white px-3 focus:outline-2 focus:outline-offset-0 focus:outline-primary"><option value="act_1" selected="">חשבון ראשי</option><option value="act_2">Second</option></select></div></div><div class="w-48 max-w-full"><div class="block"><div class="flex justify-between mb-1 ms-1 items-end "><label for="ads-range" class="text-gray-600 text-sm font-medium ">טווח תאריכים</label></div><select id="ads-range" class="h-10 w-full rounded-md border border-gray-200 bg-white px-3 focus:outline-2 focus:outline-offset-0 focus:outline-primary"><option value="today">היום</option><option value="last_7d">7 ימים אחרונים</option><option value="last_30d" selected="">30 ימים אחרונים</option><option value="this_month">החודש</option><option value="last_month">החודש הקודם</option><option value="custom">טווח תאריכים</option></select></div></div></div><button class="flex items-center min-w-fit justify-center font-medium rounded-md flex-nowrap bg-red-600 text-white hover:bg-red-700 h-9 px-3 gap-3 text-[15px] w-fit"><span>נתק חשבון מודעות</span></button></div><div role="status" class="flex min-h-9 flex-wrap items-center gap-2 text-sm" data-testid="ads-report-status"><span class="text-gray-600">הבחירה: חשבון ראשי · 30 ימים אחרונים</span></div><div aria-busy="false" class="transition-opacity duration-150 " data-testid="ads-report-body"><div class="grid grid-cols-[minmax(0,1fr)] gap-6"><dl class="flex flex-wrap gap-x-6 gap-y-1 text-sm text-gray-600"><div class="flex gap-1"><dt>תקופה:</dt><dd dir="ltr"