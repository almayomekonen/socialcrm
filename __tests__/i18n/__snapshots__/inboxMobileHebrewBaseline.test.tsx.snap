  "messengerError": "<div class="flex min-h-[40vh] w-full items-center justify-center p-6" dir="rtl" role="alert"><div class="grid w-full max-w-md gap-3 rounded-xl border border-gray-200 bg-white p-7 text-center shadow-sm"><h2 class="m-0 text-lg font-bold text-gray-900">לא ניתן לטעון את שיחות ה-Messenger</h2><p class="m-0 text-sm leading-relaxed text-gray-600">משהו השתבש בטעינת השיחות. אפשר לנסות שוב, או לחזור לשיחות.</p><div class="mt-2 flex flex-col items-stretch justify-center gap-2 sm:flex-row sm:items-center"><button class="flex items-center min-w-fit justify-center font-medium rounded-md flex-nowrap bg-solid text-white hover:bg-solid/85 h-11 px-5 gap-4 text-lg" type="button"><span>נסה שנית</span></button><a class="flex items-center min-w-fit justify-center font-medium rounded-md flex-nowrap border text-black border-gray-200 bg-white hover:bg-gray-100/60 h-11 px-5 gap-4 text-lg" href="/inbox"><span>חזרה לשיחות</span></a></div></div></div>",
