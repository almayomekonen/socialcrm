exports[`Hebrew baseline — mobile thread (server HTML) > composer states: window closed (ready-message sheet button / no template / no manage), window unknown, blocked health, no facts 1`] = `
{
  "closedNoManage": "<div class="shrink-0 border-t border-[#e0e0e0] bg-[#f0f2f5] px-3 py-2"><div class="grid gap-2"><p class="text-sm text-gray-500">חלון ההודעות נסגר. כדי להמשיך את השיחה, נדרשת הודעה מוכנה מאושרת.</p><a href="https://wa.me/972500000001" class="text-sm font-medium text-primary-text underline">פתיחת השיחה בוואטסאפ</a></div></div></div></div></div>",
  "closedNoTemplate": "<div class="shrink-0 border-t border-[#e0e0e0] bg-[#f0f2f5] px-3 py-2"><div class="grid gap-2"><p class="text-sm text-gray-500">חלון ההודעות נסגר. כדי להמשיך את השיחה, נדרשת הודעה מוכנה מאושרת.</p><a href="https://wa.me/972500000001" class="text-sm font-medium text-primary-text underline">פתיחת השיחה בוואטסאפ</a><a class="text-sm font-medium text-primary-text underline" href="/settings/integrations?section=templates">להודעות המוכנות</a></div></div></div></div></div>",
  "closedTemplate": "<div class="shrink-0 border-t border-[#e0e0e0] bg-[#f0f2f5] px-3 py-2"><div class="grid gap-2"><p class="text-sm font-medium text-gray-800">חלון ההודעות ב-WhatsApp נסגר</p><p class="text-sm text-gray-500">עברו יותר מ-24 שעות מאז ההודעה האחרונה של הלקוח. כדי להמשיך את השיחה, יש לשלוח הודעה מוכנה מאושרת.</p><div data-testid="send-ready-message-mobile"><button type="button" class="press flex min-h-11 w-full items-center justify-center rounded-md bg-solid font-medium text-white hover:bg-solid/85 focus:outline-none focus-visible:ring-2 focus-visible:ring-primary">בחר הודעה מוכנה</button></div></div></div></div></div></div>",
  "health_disconnected": "<div class="shrink-0 border-t border-[#e0e0e0] bg-[#f0f2f5] px-3 py-2"><div class="grid gap-2"><p class="text-sm text-gray-500">כדי לשלוח הודעות, <a class="font-medium text-primary-text underline" href="/settings/integrations">חברו את וואטסאפ</a></p></div></div></div></div></div>",
  "health_registration_pending": "<div class="shrink-0 border-t border-[#e0e0e0] bg-[#f0f2f5] px-3 py-2"><div class="grid gap-2"><div role="status" class="rounded-md border p-3 border-amber-300 bg-amber-50"><p class="text-sm font-medium text-amber-800">הגדרת מספר ה-WhatsApp עדיין לא הושלמה</p><p class="mt-1 text-sm text-amber-700">עד להשלמת ההגדרה, SocialCRM לא יכול לקבל הודעות ולידים דרך החיבור הזה.</p><p class="mt-2 text-xs text-amber-700/80">בדרך כלל בגלל:</p><ul class="mt-0.5 list-disc ps-5 text-sm text-amber-700"><li>המספר טרם אומת</li><li>מוגדר קוד אימות דו-שלבי</li></ul><p class="mt-2 text-sm text-amber-700">להשלים את האימות ב-WhatsApp Manager. אם מוגדר קוד דו-שלבי, יש להשביתו זמנית.</p></div><a class="text-sm font-medium text-primary-text underline" href="/settings/integrations">להגדרות החיבור</a></div></div></div></div></div>",
  "health_restricted": "<div class="shrink-0 border-t border-[#e0e0e0] bg-[#f0f2f5] px-3 py-2"><div class="grid gap-2"><div role="status" class="rounded-md border p-3 border-red-200 bg-red-50"><p class="text-sm font-medium text-red-800">לא ניתן לשלוח הודעות כרגע</p><p class="mt-1 text-sm text-red-700">WhatsApp לא מאפשרת כרגע לשלוח הודעות מהחשבון המחובר.</p><p class="mt-2 text-sm text-red-700">בדוק את חשבון WhatsApp המחובר ל-SocialCRM.</p></div><a class="text-sm font-medium text-primary-text underline" href="/settings/integrations">להגדרות החיבור</a></div></div></div></div></div>",
  "health_token": "<div class="shrink-0 border-t border-[#e0e0e0] bg-[#f0f2f5] px-3 py-2"><div class="grid gap-2"><div role="status" class="rounded-md border p-3 border-red-200 bg-red-50"><p class="text-sm font-medium text-red-800">החיבור לוואטסאפ פג</p><p class="mt-1 text-sm text-red-700">הודעות ולידים חדשים אינם נכנסים כרגע. כל המידע הקיים במערכת נשמר במלואו.</p><p class="mt-2 text-xs text-red-700/80">בדרך כלל בגלל:</p><ul class="mt-0.5 list-disc ps-5 text-sm text-red-700"><li>חלף זמן מהחיבור</li><li>ההרשאה ב-WhatsApp שונתה</li></ul><p class="mt-2 text-sm text-red-700">חידוש החיבור אורך פחות מדקה ואינו משפיע על נתונים קיימים.</p></div><a class="text-sm font-medium text-primary-text underline" href="/settings/integrations">להגדרות החיבור</a></div></div></div></div></div>",
  "unknown": "<div class="shrink-0 border-t border-[#e0e0e0] bg-[#f0f2f5] px-3 py-2"><div class="grid gap-2"><p class="text-sm text-gray-500">לא ניתן לשלוח הודעת טקסט. אין הודעה נכנסת מהלקוח בשיחה הזו.</p><a href="https://wa.me/972500000001" class="text-sm font-medium text-primary-text underline">פתיחת השיחה בוואטסאפ</a></div></div></div></div></div>",
}
`;

