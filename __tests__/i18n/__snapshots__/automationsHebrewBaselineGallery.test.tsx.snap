    ],
  ],
  "connect": "<div role="dialog" aria-modal="true" aria-label="חיבור האתר שלי" tabindex="-1" class="overflow-y-auto bg-white shadow-2xl relative popin overflow-x-hidden scrollbar-slim outline-none p-8 max-h-[90vh] rounded-lg w-[460px] max-w-[92vw]"><button class="absolute top-2 left-2" title="יציאה ללא שמירה" aria-label="סגירה"><div aria-hidden="true" class="dark:bg-white size-[22px] bg-red-700 " style="mask-image: url(&quot;https://res.cloudinary.com/dfletli2x/image/upload/icons/lit/circle-xmark.svg&quot;); -webkit-mask-image: url(&quot;https://res.cloudinary.com/dfletli2x/image/upload/icons/lit/circle-xmark.svg&quot;); mask-repeat: no-repeat; -webkit-mask-repeat: no-repeat; mask-position: center; -webkit-mask-position: center; mask-size: contain; -webkit-mask-size: contain; mask-type: alpha;"></div></button><div class="grid gap-4 pt-2"><h2 class="text-lg font-semibold text-dark">חיבור האתר שלי</h2><p class="text-sm text-gray-600 leading-relaxed">נפיק כתובת וקוד סודי שצריך להזין במערכת שלכם.</p><div class="block"><div class="flex justify-between mb-1 ms-1 items-end "><label for="«id»" class="text-gray-600 text-sm font-medium ">כתובת האתר או המערכת</label></div><input id="«id»" class="h-10 w-full rounded-md border bg-white focus:outline-2 focus:outline-offset-0 disabled:opacity-50 border-gray-200 focus:outline-primary px-2.5" required="" dir="ltr" placeholder="https://example.com" value=""></div><div class="block"><div class="flex justify-between mb-1 ms-1 items-end "><label for="«id»" class="text-gray-600 text-sm font-medium ">שם לתצוגה (לא חובה)</label></div><input id="«id»" class="h-10 w-full rounded-md border bg-white focus:outline-2 focus:outline-offset-0 disabled:opacity-50 border-gray-200 focus:outline-primary px-2.5" required="" value=""></div><div class="flex justify-end mt-2"><button class="flex items-center min-w-fit justify-center font-medium rounded-md flex-nowrap bg-solid text-white hover:bg-solid/85 h-10 px-4 gap-3" disabled=""><div aria-hidden="true" class="dark:bg-white bg-white size-4 " style="mask-image: url(&quot;https://res.cloudinary.com/dfletli2x/image/upload/icons/sol/plug.svg&quot;); -webkit-mask-image: url(&quot;https://res.cloudinary.com/dfletli2x/image/upload/icons/sol/plug.svg&quot;); mask-repeat: no-repeat; -webkit-mask-repeat: no-repeat; mask-position: center; -webkit-mask-position: center; mask-size: contain; -webkit-mask-size: contain; mask-type: alpha;"></div><span>יצירת חיבור</span></button></div></div></div>",
  "connectRefused": "<p class="text-sm text-red-600" role="alert">כתובת האתר אינה תקינה</p>",
  "details": "<div role="dialog" aria-modal="true" aria-label="אתר הקורסים" tabindex="-1" class="overflow-y-auto bg-white shadow-2xl relative popin overflow-x-hidden scrollbar-slim outline-none p-8 max-h-[90vh] rounded-lg w-[520px] max-w-[92vw]"><button class="absolute top-2 left-2" title="יציאה ללא שמירה" aria-label="סגירה"><div aria-hidden="true" class="dark:bg-white size-[22px] bg-red-700 " style="mask-image: url(&quot;https://res.cloudinary.com/dfletli2x/image/upload/icons/lit/circle-xmark.svg&quot;); -webkit-mask-image: url(&quot;https://res.cloudinary.com/dfletli2x/image/upload/icons/lit/circle-xmark.svg&quot;); mask-repeat: no-repeat; -webkit-mask-repeat: no-repeat; mask-position: center; -webkit-mask-position: center; mask-size: contain; -webkit-mask-size: contain; mask-type: alpha;"></div></button><div class="flex flex-col gap-4 max-h-[80dvh] min-h-0 pt-2"><div class="flex items-start justify-between gap-3 shrink-0"><div class="grid gap-0.5 min-w-0"><h2 class="text-lg font-semibold text-dark truncate leading-tight">אתר הקורסים</h2><p class="text-sm text-gray-500">האתר שלי</p></div><span class="flex shrink-0 items-center gap-2"><span class="inline-flex shrink-0 items-center rounded-full border font-medium tabular-nums gap-1.5 px-2 py-0.5 text-xs " style="background-color: var(--color-error-bg); color: var(--color-error-text); border-color: var(--color-error-border);"><span class="shrink-0 rounded-full size-1.5 " style="background-color: var(--color-error-dot);"></span>פניות נדחות</span></span></div><p class="text-sm text-gray-500 shrink-0">מגיעות פניות לחיבור הזה אבל הן לא נכנסות למערכת.</p><div class="border-b w-full my-0 shrink-0"></div><div class="flex-1 min-h-0 min-w-0 overflow-y-auto overflow-x-hidden grid gap-4 content-start scrollbar-slim"><section class="grid gap-3"><h3 class="text-sm font-semibold text-gray-800">הגדרת החיבור</h3><div class="grid gap-4 min-w-0"><div class="grid gap-1.5 min-w-0"><span class="text-sm text-gray-500">כתובת לשליחה</span><div class="flex items-start gap-2 min-w-0"><code dir="ltr" class="min-w-0 flex-1 break-all rounded-md border border-gray-200 bg-gray-50 px-3 py-2 text-xs leading-relaxed text-gray-800">https://app.example.test/api/automations/hook/abc</code><button class="flex items-center min-w-fit justify-center font-medium rounded-md flex-nowrap border text-black border-gray-200 bg-white hover:bg-gray-100/60 h-9 px-3 gap-3 text-[15px]"><div aria-hidden="true" class="dark:bg-white bg-black size-[15px] " style="mask-image: url(&quot;https://res.cloudinary.com/dfletli2x/image/upload/icons/reg/copy.svg&quot;); -webkit-mask-image: url(&quot;https://res.cloudinary.com/dfletli2x/image/upload/icons/reg/copy.svg&quot;); mask-repeat: no-repeat; -webkit-mask-repeat: no-repeat; mask-position: center; -webkit-mask-position: center; mask-size: contain; -webkit-mask-size: contain; mask-type: alpha;"></div><span>העתקה</span></button></div></div><h4 class="text-sm font-semibold text-gray-800">חיבור אתר וורדפרס בשלושה צעדים</h4><ol class="grid gap-1.5 ps-5 list-decimal marker:text-gray-400"><li class="text-sm text-gray-600 leading-relaxed">החיבור הזה מתאים לאתר שבנוי על וורדפרס. אם האתר שלכם בנוי אחרת, דברו איתנו.</li><li class="text-sm text-gray-600 leading-relaxed">היכנסו לניהול וורדפרס של האתר.</li><li class="text-sm text-gray-600 leading-relaxed">הוסיפו את קטע הקוד הבא ל-functions.php של ערכת העיצוב, או לתוסף קטעי קוד.</li><li class="text-sm text-gray-600 leading-relaxed">שלחו טופס אחד לבדיקה — הטופס יופיע כאן תוך שניות.</li></ol><div class="grid gap-1 min-w-0"><div class="flex items-center justify-between gap-2"><span class="text-sm text-gray-500">קוד לוורדפרס</span><button class="flex items-center min-w-fit justify-center font-medium rounded-md flex-nowrap border text-black border-gray-200 bg-white hover:bg-gray-100/60 h-9 px-3 gap-3 text-[15px]"><div aria-hidden="true" class="dark:bg-white bg-black size-[15px] " style="mask-image: url(&quot;https://res.cloudinary.com/dfletli2x/image/upload/icons/reg/copy.svg&quot;); -webkit-mask-image: url(&quot;https://res.cloudinary.com/dfletli2x/image/upload/icons/reg/copy.svg&quot;); mask-repeat: no-repeat; -webkit-mask-repeat: no-repeat; mask-position: center; -webkit-mask-position: center; mask-size: contain; -webkit-mask-size: contain; mask-type: alpha;"></div><span>העתקת הקוד</span></button></div><pre dir="ltr" class="max-h-56 max-w-full overflow-auto rounded-md border border-gray-200 bg-gray-50 p-3 text-xs text-gray-800 scrollbar-slim"><code>add_action('wpcf7_submit', function ($form, $result) {
  $status = $result['status'] ?? '';
  if ($status !== 'mail_sent' &amp;&amp; $status !== 'mail_failed') { return; }
  $url = 'https://app.example.test/api/automations/hook/abc';
  $secret = 'הקוד-הסודי-ששמרתם'; // הקוד מוצג פעם אחת בלבד ביצירת החיבור
  $submission = WPCF7_Submission::get_instance();
  if (!$submission) { return; }
  $body = wp_json_encode([
    'form_id'       =&gt; $form-&gt;id(),
    'form_title'    =&gt; $form-&gt;title(),
    'submission_id' =&gt; wp_generate_uuid4(),
    'page_url'      =&gt; $submission-&gt;get_meta('url'),
    'fields'        =&gt; $submission-&gt;get_posted_data(),
  ]);
  wp_remote_post($url, [
    'headers' =&gt; [
      'Content-Type'         =&gt; 'application/json',
      'x-socialcrm-signature' =&gt; hash_hmac('sha256', $body, $secret),
    ],
    'body'    =&gt; $body,
    'timeout' =&gt; 5,
  ]);
}, 10, 2);</code></pre></div><a class="flex items-center min-w-fit justify-center font-medium rounded-md flex-nowrap bg-transparent text-black hover:bg-gray-100/60 h-9 px-3 gap-3 text-[15px]" href="/settings/integrations?section=website"><span>לא מגיע מידע? בדקו שקטע הקוד נשמר</span></a></div><div class="flex items-center justify-between gap-3"><span class="text-sm text-gray-500">הקוד הסודי אינו ניתן לשחזור.</span><button class="flex items-center min-w-fit justify-center font-medium rounded-md flex-nowrap border text-black border-gray-200 bg-white hover:bg-gray-100/60 h-9 px-3 gap-3 text-[15px]"><div aria-hidden="true" class="dark:bg-white bg-black size-[15px] " style="mask-image: url(&quot;https://res.cloudinary.com/dfletli2x/image/upload/icons/reg/rotate.svg&quot;); -webkit-mask-image: url(&quot;https://res.cloudinary.com/dfletli2x/image/upload/icons/reg/rotate.svg&quot;); mask-repeat: no-repeat; -webkit-mask-repeat: no-repeat; mask-position: center; -webkit-mask-position: center; mask-size: contain; -webkit-mask-size: contain; mask-type: alpha;"></div><span>יצירת קוד סודי חדש</span></button></div></section><div class="border-b w-full my-0"></div><section class="grid gap-2"><h3 class="text-sm font-semibold text-gray-800">מה החיבור הזה מאפשר</h3><ul class="grid gap-1"><li class="text-sm text-gray-600">נשלח טופס באתר</li></ul></section><div class="border-b w-full my-0"></div><section class="grid gap-2"><h3 class="text-sm font-semibold text-gray-800">מקורות</h3><ul class="grid gap-2"><li class="flex items-center justify-between gap-3"><span class="min-w-0 truncate text-sm text-gray-700">טופס צור קשר</span><span class="flex shrink-0 items-center gap-2"><span class="inline-flex shrink-0 items-center rounded-full border font-medium tabular-nums gap-1 px-1.5 py-0.5 text-[10px] leading-tight " style="background-color: var(--color-success-bg); color: var(--color-success-text); border-color: var(--color-success-border);"><span class="shrink-0 rounded-full size-1 " style="background-color: var(--color-success-dot);"></span>פעיל</span><button class="flex items-center min-w-fit justify-center font-medium rounded-md flex-nowrap bg-transparent text-black hover:bg-gray-100/60 h-9 px-3 gap-3 text-[15px]"><div aria-hidden="true" class="dark:bg-white bg-black size-[15px] " style="mask-image: url(&quot;https://res.cloudinary.com/dfletli2x/image/upload/icons/reg/pen.svg&quot;); -webkit-mask-image: url(&quot;https://res.cloudinary.com/dfletli2x/image/upload/icons/reg/pen.svg&quot;); mask-repeat: no-repeat; -webkit-mask-repeat: no-repeat; mask-position: center; -webkit-mask-position: center; mask-size: contain; -webkit-mask-size: contain; mask-type: alpha;"></div><span>שינוי שם</span></button></span></li><li class="flex items-center justify-between gap-3"><span class="min-w-0 truncate text-sm text-gray-700">הרשמה לסדנה</span><span class="flex shrink-0 items-center gap-2"><span class="inline-flex shrink-0 items-center rounded-full border font-medium tabular-nums gap-1 px-1.5 py-0.5 text-[10px] leading-tight " style="background-color: var(--color-neutral-bg); color: var(--color-neutral-text); border-color: var(--color-neutral-border);"><span class="shrink-0 rounded-full size-1 " style="background-color: var(--color-neutral-dot);"></span>ממתין</span><span class="inline-flex shrink-0 items-center rounded-full border font-medium tabular-nums gap-1 px-1.5 py-0.5 text-[10px] leading-tight " style="background-color: var(--color-warning-bg); color: var(--color-warning-text); border-color: var(--color-warning-border);"><span class="shrink-0 rounded-full size-1 " style="background-color: var(--color-warning-dot);"></span>החיבור אינו שלם</span><button class="flex items-center min-w-fit justify-center font-medium rounded-md flex-nowrap bg-transparent text-black hover:bg-gray-100/60 h-9 px-3 gap-3 text-[15px]"><div aria-hidden="true" class="dark:bg-white bg-black size-[15px] " style="mask-image: url(&quot;https://res.cloudinary.com/dfletli2x/image/upload/icons/reg/pen.svg&quot;); -webkit-mask-image: url(&quot;https://res.cloudinary.com/dfletli2x/image/upload/icons/reg/pen.svg&quot;); mask-repeat: no-repeat; -webkit-mask-repeat: no-repeat; mask-position: center; -webkit-mask-position: center; mask-size: contain; -webkit-mask-size: contain; mask-type: alpha;"></div><span>שינוי שם</span></button></span></li></ul></section><div class="border-b w-full my-0"></div><section class="grid gap-2"><h3 class="text-sm font-semibold text-gray-800">אוטומציות שמשתמשות בחיבור</h3><p class="text-sm text-gray-600">אף אוטומציה עדיין לא משתמשת בחיבור הזה.</p><p class="text-sm text-gray-500">אירוע אחרון לפני 5 שעות · 57 אירועים בסך הכול</p><p class="text-sm text-gray-500">עדיין לא נרשמה פעילות אוטומציות</p></section></div></div></div>",
  "disconnect": "<div role="dialog" aria-modal="true" aria-label="ניתוק &quot;אתר הקורסים&quot; יבטל את האירועים שהחיבור הזה מאפשר." tabindex="-1" class="overflow-y-auto bg-white shadow-2xl relative popin overflow-x-hidden scrollbar-slim outline-none p-8 max-h-[90vh] rounded-lg"><button class="absolute top-2 left-2" title="יציאה ללא שמירה" aria-label="סגירה"><div aria-hidden="true" class="dark:bg-white size-[22px] bg-red-700 " style="mask-image: url(&quot;https://res.cloudinary.com/dfletli2x/image/upload/icons/lit/circle-xmark.svg&quot;); -webkit-mask-image: url(&quot;https://res.cloudinary.com/dfletli2x/image/upload/icons/lit/circle-xmark.svg&quot;); mask-repeat: no-repeat; -webkit-mask-repeat: no-repeat; mask-position: center; -webkit-mask-position: center; mask-size: contain; -webkit-mask-size: contain; mask-type: alpha;"></div></button><div class="flex flex-col gap-6 min-w-[320px] pt-4"><p class="font-semibold whitespace-pre-line pe-6">ניתוק "אתר הקורסים" יבטל את האירועים שהחיבור הזה מאפשר.</p><div class="flex justify-end gap-2"><button class="flex items-center min-w-fit justify-center font-medium rounded-md flex-nowrap border text-black border-gray-200 bg-white hover:bg-gray-100/60 h-10 px-4 gap-3"><span>ביטול</span></button><button class="flex items-center min-w-fit justify-center font-medium rounded-md flex-nowrap bg-red-600 text-white hover:bg-red-700 h-10 px-4 gap-3"><span>ניתוק</span></button></div></div></div>",
  "disconnectUsed": "<div role="dialog" aria-modal="true" aria-label="ניתוק &quot;אתר הקורסים&quot; יסמן 2 אוטומציות כדורשות טיפול, והן יפסיקו לפעול עד לחיבור מחדש." tabindex="-1" class="overflow-y-auto bg-white shadow-2xl relative popin overflow-x-hidden scrollbar-slim outline-none p-8 max-h-[90vh] rounded-lg"><button class="absolute top-2 left-2" title="יציאה ללא שמירה" aria-label="סגירה"><div aria-hidden="true" class="dark:bg-white size-[22px] bg-red-700 " style="mask-image: url(&quot;https://res.cloudinary.com/dfletli2x/image/upload/icons/lit/circle-xmark.svg&quot;); -webkit-mask-image: url(&quot;https://res.cloudinary.com/dfletli2x/image/upload/icons/lit/circle-xmark.svg&quot;); mask-repeat: no-repeat; -webkit-mask-repeat: no-repeat; mask-position: center; -webkit-mask-position: center; mask-size: contain; -webkit-mask-size: contain; mask-type: alpha;"></div></button><div class="flex flex-col gap-6 min-w-[320px] pt-4"><p class="font-semibold whitespace-pre-line pe-6">ניתוק "אתר הקורסים" יסמן 2 אוטומציות כדורשות טיפול, והן יפסיקו לפעול עד לחיבור מחדש.</p><div class="flex justify-end gap-2"><button class="flex items-center min-w-fit justify-center font-medium rounded-md flex-nowrap border text-black border-gray-200 bg-white hover:bg-gray-100/60 h-10 px-4 gap-3"><span>ביטול</span></button><button class="flex items-center min-w-fit justify-center font-medium rounded-md flex-nowrap bg-red-600 text-white hover:bg-red-700 h-10 px-4 gap-3"><span>ניתוק</span></button></div></div></div>",
  "issued": "<div role="dialog" aria-modal="true" aria-label="חיבור האתר שלי" tabindex="-1" class="overflow-y-auto bg-white shadow-2xl relative popin overflow-x-hidden scrollbar-slim outline-none p-8 max-h-[90vh] rounded-lg w-[460px] max-w-[92vw]"><button class="absolute top-2 left-2" title="יציאה ללא שמירה" aria-label="סגירה"><div aria-hidden="true" class="dark:bg-white size-[22px] bg-red-700 " style="mask-image: url(&quot;https://res.cloudinary.com/dfletli2x/image/upload/icons/lit/circle-xmark.svg&quot;); -webkit-mask-image: url(&quot;https://res.cloudinary.com/dfletli2x/image/upload/icons/lit/circle-xmark.svg&quot;); mask-repeat: no-repeat; -webkit-mask-repeat: no-repeat; mask-position: center; -webkit-mask-position: center; mask-size: contain; -webkit-mask-size: contain; mask-type: alpha;"></div></button><div class="grid gap-4 pt-2"><h2 class="text-lg font-semibold text-dark">חיבור האתר שלי</h2><p class="text-sm text-gray-600 leading-relaxed">הזינו את שני הפרטים האלה במערכת שלכם. הקוד הסודי מוצג פעם אחת בלבד — שמרו אותו עכשיו.</p><div class="grid gap-1.5 min-w-0"><span class="text-sm text-gray-500">כתובת לשליחה</span><div class="flex items-start gap-2 min-w-0"><code class="min-w-0 flex-1 break-all rounded-md border border-gray-200 bg-gray-50 px-3 py-2 text-xs leading-relaxed text-gray-800" dir="ltr">https://app.example.test/api/automations/hook/abc</code><button class="flex items-center min-w-fit justify-center font-medium rounded-md flex-nowrap border text-black border-gray-200 bg-white hover:bg-gray-100/60 h-9 px-3 gap-3 text-[15px]"><div aria-hidden="true" class="dark:bg-white bg-black size-[15px] " style="mask-image: url(&quot;https://res.cloudinary.com/dfletli2x/image/upload/icons/reg/copy.svg&quot;); -webkit-mask-image: url(&quot;https://res.cloudinary.com/dfletli2x/image/upload/icons/reg/copy.svg&quot;); mask-repeat: no-repeat; -webkit-mask-repeat: no-repeat; mask-position: center; -webkit-mask-position: center; mask-size: contain; -webkit-mask-size: contain; mask-type: alpha;"></div><span>העתקה</span></button></div></div><div class="grid gap-1.5 min-w-0"><span class="text-sm text-gray-500">קוד סודי</span><div class="flex items-start gap-2 min-w-0"><code class="min-w-0 flex-1 break-all rounded-md border border-gray-200 bg-gray-50 px-3 py-2 text-xs leading-relaxed text-gray-800" dir="ltr">sec_123</code><button class="flex items-center min-w-fit justify-center font-medium rounded-md flex-nowrap border text-black border-gray-200 bg-white hover:bg-gray-100/60 h-9 px-3 gap-3 text-[15px]"><div aria-hidden="true" class="dark:bg-white bg-black size-[15px] " style="mask-image: url(&quot;https://res.cloudinary.com/dfletli2x/image/upload/icons/reg/copy.svg&quot;); -webkit-mask-image: url(&quot;https://res.cloudinary.com/dfletli2x/image/upload/icons/reg/copy.svg&quot;); mask-repeat: no-repeat; -webkit-mask-repeat: no-repeat; mask-position: center; -webkit-mask-position: center; mask-size: contain; -webkit-mask-size: contain; mask-type: alpha;"></div><span>העתקה</span></button></div></div><div class="flex justify-end mt-2"><button class="flex items-center min-w-fit justify-center font-medium rounded-md flex-nowrap bg-solid text-white hover:bg-solid/85 h-10 px-4 gap-3"><span>סיימתי</span></button></div></div></div>",
  "secret": "<section class="grid gap-3"><h3 class="text-sm font-semibold text-gray-800">הגדרת החיבור</h3><div class="grid gap-4 min-w-0"><div class="grid gap-1.5 min-w-0"><span class="text-sm text-gray-500">כתובת לשליחה</span><div class="flex items-start gap-2 min-w-0"><code dir="ltr" class="min-w-0 flex-1 break-all rounded-md border border-gray-200 bg-gray-50 px-3 py-2 text-xs leading-relaxed text-gray-800">https://app.example.test/api/automations/hook/abc</code><button class="flex items-center min-w-fit justify-center font-medium rounded-md flex-nowrap border text-black border-gray-200 bg-white hover:bg-gray-100/60 h-9 px-3 gap-3 text-[15px]"><div aria-hidden="true" class="dark:bg-white bg-black size-[15px] " style="mask-image: url(&quot;https://res.cloudinary.com/dfletli2x/image/upload/icons/reg/copy.svg&quot;); -webkit-mask-image: url(&quot;https://res.cloudinary.com/dfletli2x/image/upload/icons/reg/copy.svg&quot;); mask-repeat: no-repeat; -webkit-mask-repeat: no-repeat; mask-position: center; -webkit-mask-position: center; mask-size: contain; -webkit-mask-size: contain; mask-type: alpha;"></div><span>העתקה</span></button></div></div><h4 class="text-sm font-semibold text-gray-800">חיבור אתר וורדפרס בשלושה צעדים</h4><ol class="grid gap-1.5 ps-5 list-decimal marker:text-gray-400"><li class="text-sm text-gray-600 leading-relaxed">החיבור הזה מתאים לאתר שבנוי על וורדפרס. אם האתר שלכם בנוי אחרת, דברו איתנו.</li><li class="text-sm text-gray-600 leading-relaxed">היכנסו לניהול וורדפרס של האתר.</li><li class="text-sm text-gray-600 leading-relaxed">הוסיפו את קטע הקוד הבא ל-functions.php של ערכת העיצוב, או לתוסף קטעי קוד.</li><li class="text-sm text-gray-600 leading-relaxed">שלחו טופס אחד לבדיקה — הטופס יופיע כאן תוך שניות.</li></ol><div class="grid gap-1 min-w-0"><div class="flex items-center justify-between gap-2"><span class="text-sm text-gray-500">קוד לוורדפרס</span><button class="flex items-center min-w-fit justify-center font-medium rounded-md flex-nowrap border text-black border-gray-200 bg-white hover:bg-gray-100/60 h-9 px-3 gap-3 text-[15px]"><div aria-hidden="true" class="dark:bg-white bg-black size-[15px] " style="mask-image: url(&quot;https://res.cloudinary.com/dfletli2x/image/upload/icons/reg/copy.svg&quot;); -webkit-mask-image: url(&quot;https://res.cloudinary.com/dfletli2x/image/upload/icons/reg/copy.svg&quot;); mask-repeat: no-repeat; -webkit-mask-repeat: no-repeat; mask-position: center; -webkit-mask-position: center; mask-size: contain; -webkit-mask-size: contain; mask-type: alpha;"></div><span>העתקת הקוד</span></button></div><pre dir="ltr" class="max-h-56 max-w-full overflow-auto rounded-md border border-gray-200 bg-gray-50 p-3 text-xs text-gray-800 scrollbar-slim"><code>add_action('wpcf7_submit', function ($form, $result) {
  $status = $result['status'] ?? '';
  if ($status !== 'mail_sent' &amp;&amp; $status !== 'mail_failed') { return; }
  $url = 'https://app.example.test/api/automations/hook/abc';
  $secret = 'הקוד-הסודי-ששמרתם'; // הקוד מוצג פעם אחת בלבד ביצירת החיבור
  $submission = WPCF7_Submission::get_instance();
  if (!$submission) { return; }
  $body = wp_json_encode([
    'form_id'       =&gt; $form-&gt;id(),
    'form_title'    =&gt; $form-&gt;title(),
    'submission_id' =&gt; wp_generate_uuid4(),
    'page_url'      =&gt; $submission-&gt;get_meta('url'),
    'fields'        =&gt; $submission-&gt;get_posted_data(),
  ]);
  wp_remote_post($url, [
    'headers' =&gt; [
      'Content-Type'         =&gt; 'application/json',
      'x-socialcrm-signature' =&gt; hash_hmac('sha256', $body, $secret),
    ],
    'body'    =&gt; $body,
    'timeout' =&gt; 5,
  ]);
}, 10, 2);</code></pre></div><a class="flex items-center min-w-fit justify-center font-medium rounded-md flex-nowrap bg-transparent text-black hover:bg-gray-100/60 h-9 px-3 gap-3 text-[15px]" href="/settings/integrations?section=website"><span>לא מגיע מידע? בדקו שקטע הקוד נשמר</span></a></div><div class="grid gap-1.5 min-w-0"><span class="text-sm text-gray-500">קוד סודי חדש</span><div class="flex items-start gap-2 min-w-0"><code dir="ltr" class="min-w-0 flex-1 break-all rounded-md border border-gray-200 bg-gray-50 px-3 py-2 text-xs leading-relaxed text-gray-800">sec_456</code><button class="flex items-center min-w-fit justify-center font-medium rounded-md flex-nowrap border text-black border-gray-200 bg-white hover:bg-gray-100/60 h-9 px-3 gap-3 text-[15px]"><div aria-hidden="true" class="dark:bg-white bg-black size-[15px] " style="mask-image: url(&quot;https://res.cloudinary.com/dfletli2x/image/upload/icons/reg/copy.svg&quot;); -webkit-mask-image: url(&quot;https://res.cloudinary.com/dfletli2x/image/upload/icons/reg/copy.svg&quot;); mask-repeat: no-repeat; -webkit-mask-repeat: no-repeat; mask-position: center; -webkit-mask-position: center; mask-size: contain; -webkit-mask-size: contain; mask-type: alpha;"></div><span>העתקה</span></button></div></div><p class="text-sm text-amber-700">הקוד מוצג פעם אחת בלבד. עדכנו אותו במערכת שלכם — עד אז לא יתקבלו נתונים.</p></section>",
  "used": "<p class="mb-4 text-sm text-gray-600 leading-relaxed">חברו את הטפסים באתר שלכם כדי שכל פנייה תיכנס כליד. אחרי החיבור אפשר לבנות על זה אוטומציות.</p><div class="grid gap-4"><div class="rounded-lg border border-gray-200 bg-white p-6 grid gap-4 content-start"><div class="flex items-start justify-between gap-3"><div class="flex items-center gap-2.5 min-w-0"><div aria-hidden="true" class="dark:bg-white size-7 bg-gray-900 shrink-0 " style="mask-image: url(&quot;https://res.cloudinary.com/dfletli2x/image/upload/icons/lit/globe.svg&quot;); -webkit-mask-image: url(&quot;https://res.cloudinary.com/dfletli2x/image/upload/icons/lit/globe.svg&quot;); mask-repeat: no-repeat; -webkit-mask-repeat: no-repeat; mask-position: center; -webkit-mask-position: center; mask-size: contain; -webkit-mask-size: contain; mask-type: alpha;"></div><h3 class="text-lg font-bold text-dark truncate">האתר שלי</h3></div><span class="inline-flex shrink-0 items-center rounded-full border font-medium tabular-nums gap-1.5 px-2 py-0.5 text-xs " style="background-color: var(--color-success-bg); color: var(--color-success-text); border-color: var(--color-success-border);"><span class="shrink-0 rounded-full size-1.5 " style="background-color: var(--color-success-dot);"></span>מחובר</span></div><p class="text-sm text-gray-600 leading-relaxed">מאפשר אוטומציות על: נשלח טופס באתר</p><ul class="grid gap-3"><li class="grid gap-2 rounded-md border border-gray-100 bg-gray-50 p-3"><div class="flex items-center justify-between gap-3"><span class="min-w-0 truncate text-sm font-medium text-gray-800">האתר של דנה</span><span class="flex shrink-0 items-center gap-2"><span class="inline-flex shrink-0 items-center rounded-full border font-medium tabular-nums gap-1 px-1.5 py-0.5 text-[10px] leading-tight " style="background-color: var(--color-error-bg); color: var(--color-error-text); border-color: var(--color-error-border);"><span class="shrink-0 rounded-full size-1 " style="background-color: var(--color-error-dot);"></span>מנותק</span><span class="inline-flex shrink-0 items-center rounded-full border font-medium tabular-nums gap-1 px-1.5 py-0.5 text-[10px] leading-tight " style="background-color: var(--color-error-bg); color: var(--color-error-text); border-color: var(--color-error-border);"><span class="shrink-0 rounded-full size-1 " style="background-color: var(--color-error-dot);"></span>החיבור נותק</span></span></div><p class="text-sm text-gray-500">החיבור אינו פעיל.</p><p class="text-sm text-gray-500">0 מקורות · 0 אוטומציות</p><div class="flex flex-wrap items-center gap-2"><button class="flex items-center min-w-fit justify-center font-medium rounded-md flex-nowrap bg-transparent text-black hover:bg-gray-100/60 h-9 px-3 gap-3 text-[15px]"><div aria-hidden="true" class="dark:bg-white bg-black size-[15px] " style="mask-image: url(&quot;https://res.cloudinary.com/dfletli2x/image/upload/icons/reg/eye.svg&quot;); -webkit-mask-image: url(&quot;https://res.cloudinary.com/dfletli2x/image/upload/icons/reg/eye.svg&quot;); mask-repeat: no-repeat; -webkit-mask-repeat: no-repeat; mask-position: center; -webkit-mask-position: center; mask-size: contain; -webkit-mask-size: contain; mask-type: alpha;"></div><span>פרטים</span></button><button class="flex items-center min-w-fit justify-center font-medium rounded-md flex-nowrap bg-solid text-white hover:bg-solid/85 h-9 px-3 gap-3 text-[15px]"><span>יצירת חיבור</span></button></div></li><li class="grid gap-2 rounded-md border border-gray-100 bg-gray-50 p-3"><div class="flex items-center justify-between gap-3"><span class="min-w-0 truncate text-sm font-medium text-gray-800">אתר הקורסים</span><span class="flex shrink-0 items-center gap-2"><span class="inline-flex shrink-0 items-center rounded-full border font-medium tabular-nums gap-1 px-1.5 py-0.5 text-[10px] leading-tight " style="background-color: var(--color-error-bg); color: var(--color-error-text); border-color: var(--color-error-border);"><span class="shrink-0 rounded-full size-1 " style="background-color: var(--color-error-dot);"></span>פניות נדחות</span></span></div><p class="text-sm text-gray-500">מגיעות פניות לחיבור הזה אבל הן לא נכנסות למערכת.</p><div class="grid gap-2 rounded-md border border-red-200 bg-red-50 p-3" role="alert"><p class="text-sm font-semibold text-red-900">יש בעיה בחיבור לטופס באתר</p><p class="text-sm text-red-800">התקבל ניסיון לשלוח ליד מהטופס באתר שלך, אבל החיבור לא אומת ולכן הליד לא נכנס למערכת.</p></div><p class="text-sm text-gray-500">2 מקורות · 2 אוטומציות · אירוע אחרון לפני 5 שעות</p><div class="flex flex-wrap items-center gap-2"><button class="flex items-center min-w-fit justify-center font-medium rounded-md flex-nowrap bg-transparent text-black hover:bg-gray-100/60 h-9 px-3 gap-3 text-[15px]"><div aria-hidden="true" class="dark:bg-white bg-black size-[15px] " style="mask-image: url(&quot;https://res.cloudinary.com/dfletli2x/image/upload/icons/reg/eye.svg&quot;); -webkit-mask-image: url(&quot;https://res.cloudinary.com/dfletli2x/image/upload/icons/reg/eye.svg&quot;); mask-repeat: no-repeat; -webkit-mask-repeat: no-repeat; mask-position: center; -webkit-mask-position: center; mask-size: contain; -webkit-mask-size: contain; mask-type: alpha;"></div><span>פרטים</span></button><button class="flex items-center min-w-fit justify-center font-medium rounded-md flex-nowrap border text-black border-gray-200 bg-white hover:bg-gray-100/60 h-9 px-3 gap-3 text-[15px]"><span>יצירת חיבור חדש</span></button><button class="flex items-center min-w-fit justify-center font-medium rounded-md flex-nowrap bg-transparent text-black hover:bg-gray-100/60 h-9 px-3 gap-3 text-[15px]"><div aria-hidden="true" class="dark:bg-white bg-black size-[15px] " style="mask-image: url(&quot;https://res.cloudinary.com/dfletli2x/image/upload/icons/reg/link-slash.svg&quot;); -webkit-mask-image: url(&quot;https://res.cloudinary.com/dfletli2x/image/upload/icons/reg/link-slash.svg&quot;); mask-repeat: no-repeat; -webkit-mask-repeat: no-repeat; mask-position: center; -webkit-mask-position: center; mask-size: contain; -webkit-mask-size: contain; mask-type: alpha;"></div><span>ניתוק</span></button></div></li></ul></div></div>",
}
`;
