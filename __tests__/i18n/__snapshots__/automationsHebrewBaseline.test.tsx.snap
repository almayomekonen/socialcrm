  "expired": "<div><div class="mb-6 max-w-2xl"><div data-testid="subscription-expired-inline" class="flex flex-wrap items-center gap-3 rounded-lg border border-warning-border bg-warning-bg px-3.5 py-3 "><div aria-hidden="true" class="dark:bg-white size-4 shrink-0 bg-warning-text " style="mask-image:url(https://res.cloudinary.com/dfletli2x/image/upload/icons/sol/lock.svg);-webkit-mask-image:url(https://res.cloudinary.com/dfletli2x/image/upload/icons/sol/lock.svg);mask-repeat:no-repeat;-webkit-mask-repeat:no-repeat;mask-position:center;-webkit-mask-position:center;mask-size:contain;-webkit-mask-size:contain;mask-type:alpha"></div><p class="min-w-0 flex-1 text-[13px] leading-snug text-warning-text">חידוש המנוי מחזיר את התקנת האוטומציות</p><a href="/settings/update_payment?source=automation_templates_settings" class="shrink-0 text-[13px] font-semibold text-warning-text underline underline-offset-2">חידוש מנוי</a></div></div><h1 class="title">תבניות אוטומציה</h1><p class="mt-2 mb-8 max-w-2xl text-sm text-gray-600 leading-relaxed">אוטומציות מוכנות לשימוש. ההתקנה יוצרת אותן כטיוטות אצלכם — משם הן שלכם לחלוטין, לעריכה ולהפעלה.</p><div class="grid max-w-252.5 gap-10"><section><div class="flex items-center gap-3 pb-4.5"><h2 class="text-[12.5px] font-semibold tracking-[0.14em] text-[#aab3c0]">לידים</h2><span class="text-[12.5px] text-[#c2c9d4]">3</span><span aria-hidden="true" class="h-px flex-1 bg-[#eef0f4]"></span></div><div class="grid grid-cols-2 gap-4.5 mobile:grid-cols-1"><div class="group/card relative flex flex-col rounded-2xl bg-white p-3 pb-4 shadow-[0_0_0_1px_rgba(16,24,64,.05),0_1px_1px_rgba(16,24,64,.04),0_6px_16px_-12px_rgba(16,24,64,.18)] transition-all duration-180 ease-[cubic-bezier(.2,.7,.3,1)] hover:-translate-y-0.5 hover:shadow-[0_0_0_1px_rgba(16,24,64,.09),0_2px_3px_rgba(16,24,64,.05),0_18px_34px_-18px_rgba(16,24,64,.26)] active:translate-y-0 "><div class="relative flex h-48 items-center justify-center overflow-hidden rounded-[11px] bg-[#f7f8fa] transition