<option value="followup">דרוש המשך טיפול</option></select><div class="flex flex-wrap gap-1.5"><button type="button" aria-pressed="false" class="rounded-full border px-2.5 py-1 text-xs transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary/40 border-gray-200 text-gray-500 hover:bg-gray-50">לא נקראו</button><button type="button" aria-pressed="false" class="rounded-full border px-2.5 py-1 text-xs transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary/40 border-gray-200 text-gray-500 hover:bg-gray-50">ממתינות למענה</button></div></div><div class="flex min-h-0 flex-1 flex-col"><div class="min-h-0 flex-1 overflow-y-auto"><p class="p-6 text-center text-sm text-gray-400">לא נמצאו שיחות</p></div></div></aside><section aria-label="שיחה" class="flex min-w-0 flex-1 flex-col overflow-hidden rounded-lg border border-gray-200 bg-white"><div class="flex h-full flex-col items-center justify-center px-6 text-center"><span class="flex size-14 items-center justify-center rounded-full bg-success-bg"><span aria-hidden="true" class="inline-block shrink-0 size-6" style="background-color:var(--color-success);mask-image:url(/media/social-icons/whatsapp.svg);-webkit-mask-image:url(/media/social-icons/whatsapp.svg);mask-repeat:no-repeat;-webkit-mask-repeat:no-repeat;mask-position:center;-webkit-mask-position:center;mask-size:contain;-webkit-mask-size:contain"></span></span><p class="mt-3 text-base font-medium text-gray-700">אין שיחות WhatsApp עדיין</p><p class="mt-1 text-sm text-gray-500">כשליד יכתוב בוואטסאפ, השיחה תופיע כאן אוטומטית.</p></div></section><aside class="hidden w-80 shrink-0 overflow-y-auto xl:block"></aside></div>"`;

