  "expiredSheet": "<div data-testid="subscription-expired-inline" class="flex flex-wrap items-center gap-3 rounded-lg border border-warning-border bg-warning-bg px-3.5 py-3 "><div aria-hidden="true" class="dark:bg-white size-4 shrink-0 bg-warning-text " style="mask-image: url(&quot;https://res.cloudinary.com/dfletli2x/image/upload/icons/sol/lock.svg&quot;); -webkit-mask-image: url(&quot;https://res.cloudinary.com/dfletli2x/image/upload/icons/sol/lock.svg&quot;); mask-repeat: no-repeat; -webkit-mask-repeat: no-repeat; mask-position: center; -webkit-mask-position: center; mask-size: contain; -webkit-mask-size: contain; mask-type: alpha;"></div><p class="min-w-0 flex-1 text-[13px] leading-snug text-warning-text">חידוש המנוי מחזיר את הפעלת האוטומציות</p><a href="/settings/update_payment?source=automation_save" class="shrink-0 text-[13px] font-semibold text-warning-text underline underline-offset-2">חידוש מנוי</a></div>",
  "install": "<div role="dialog" aria-modal="true" aria-label="משימה לנציג על כל ליד חדש" tabindex="-1" class="overflow-y-auto bg-white shadow-2xl relative popin overflow-x-hidden scrollbar-slim outline-none p-8 max-h-[90vh] rounded-b-lg"><button class="absolute top-2 left-2" title="יציאה ללא שמירה" aria-label="סגירה"><div aria-hidden="true" class="dark:bg-white size-[22px] bg-red-700 " style="mask-image: url(&quot;https://res.cloudinary.com/dfletli2x/image/upload/icons/lit/circle-xmark.svg&quot;); -webkit-mask-image: url(&quot;https://res.cloudinary.com/dfletli2x/image/upload/icons/lit/circle-xmark.svg&quot;); mask-repeat: no-repeat; -webkit-mask-repeat: no-repeat; mask-position: center; -webkit-mask-position: center; mask-size: contain; -webkit-mask-size: contain; mask-type: alpha;"></div></button><div class="grid gap-5 w-[min(90vw,560px)] pt-2"><h2 class="text-lg font-semibold text-gray-800">משימה לנציג על כל ליד חדש</h2><p class="text-sm text-gray-600 leading-relaxed">כל ליד חדש פותח משימה לנציג המטפל, כך שאף פנייה לא נשארת בלי בעלים.</p><div class="border-b w-full my-0"></div><section class="grid gap-3"><h3 class="text-sm font-semibold text-gray-800">הגדרות</h3><div class="block"><div class="flex justify-between mb-1 ms-1 items-end "><label for="«id»" class="text-gray-600 text-sm font-medium ">כותרת המשימה</label></div><input id="«id»" class="h-10 w-full rounded-md border bg-white focus:outline-2 focus:outline-offset-0 disabled:opacity-50 border-gray-200 focus:outline-primary px-2.5" required="" maxlength="120" value="ליד חדש — ליצור קשר עם {{שם הליד}}"></div><p class="text-sm text-gray-500 ms-1">אפשר להשתמש ב-{{שם הליד}}</p></section><div class="border-b w-full my-0"></div><section class="grid gap-2"><h3 class="text-sm font-semibold text-gray-800">מה ייווצר</h3><ul class="grid gap-2"><li class="rounded-md border border-gray-100 bg-gray-50 p-3 grid gap-1"><span class="text-sm font-medium text-gray-800">משימה על ליד חדש</span><span class="text-sm text-gray-500">ליד חדש — ליצור קשר עם {{שם הליד}}</span></li></ul><p class="text-sm text-gray-500">האוטומציות ייווצרו כטיוטות. אפשר לערוך ולהפעיל אותן במסך האוטומציות.</p></section><div class="grid gap-2"><button class="flex items-center min-w-fit justify-center font-medium rounded-md flex-nowrap bg-solid text-white hover:bg-solid/85 h-10 px-4 gap-3 w-full"><div aria-hidden="true" class="dark:bg-white bg-white size-4 " style="mask-image: url(&quot;https://res.cloudinary.com/dfletli2x/image/upload/icons/sol/plus.svg&quot;); -webkit-mask-image: url(&quot;https://res.cloudinary.com/dfletli2x/image/upload/icons/sol/plus.svg&quot;); mask-repeat: no-repeat; -webkit-mask-repeat: no-repeat; mask-position: center; -webkit-mask-position: center; mask-size: contain; -webkit-mask-size: contain; mask-type: alpha;"></div><span>התקנה</span></button></div></div></div>",
  "installMissing": "<div role="dialog" aria-modal="true" aria-label="משימה לנציג על כל ליד חדש" tabindex="-1" class="overflow-y-auto bg-white shadow-2xl relative popin overflow-x-hidden scrollbar-slim outline-none p-8 max-h-[90vh] rounded-b-lg"><button class="absolute top-2 left-2" title="יציאה ללא שמירה" aria-label="סגירה"><div aria-hidden="true" class="dark:bg-white size-[22px] bg-red-700 " style="mask-image: url(&quot;https://res.cloudinary.com/dfletli2x/image/upload/icons/lit/circle-xmark.svg&quot;); -webkit-mask-image: url(&quot;https://res.cloudinary.com/dfletli2x/image/upload/icons/lit/circle-xmark.svg&quot;); mask-repeat: no-repeat; -webkit-mask-repeat: no-repeat; mask-position: center; -webkit-mask-position: center; mask-size: contain; -webkit-mask-size: contain; mask-type: alpha;"></div></button><div class="grid gap-5 w-[min(90vw,560px)] pt-2"><h2 class="text-lg font-semibold text-gray-800">משימה לנציג על כל ליד חדש</h2><p class="text-sm text-gray-600 leading-relaxed">כל ליד חדש פותח משימה לנציג המטפל, כך שאף פנייה לא נשארת בלי בעלים.</p><div class="border-b w-full my-0"></div><section class="grid gap-3"><h3 class="text-sm font-semibold text-gray-800">הגדרות</h3><div class="block"><div class="flex justify-between mb-1 ms-1 items-end "><label for="«id»" class="text-gray-600 text-sm font-medium ">כותרת המשימה</label></div><input id="«id»" class="h-10 w-full rounded-md border bg-white focus:outline-2 focus:outline-offset-0 disabled:opacity-50 border-gray-200 focus:outline-primary px-2.5" required="" maxlength="120" value=""></div><p class="text-sm text-gray-500 ms-1">אפשר להשתמש ב-{{שם הליד}}</p></section><div class="border-b w-full my-0"></div><section class="grid gap-2"><h3 class="text-sm font-semibold text-gray-800">מה ייווצר</h3><ul class="grid gap-2"><li class="rounded-md border border-gray-100 bg-gray-50 p-3 grid gap-1"><span class="text-sm font-medium text-gray-800">משימה על ליד חדש</span><span class="text-sm text-gray-500">ליד חדש — ליצור קשר עם {{שם