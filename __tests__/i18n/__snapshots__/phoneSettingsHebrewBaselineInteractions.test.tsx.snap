n-h-11 items-center rounded-full border border-primary/30 bg-primary-tint px-4 text-sm text-primary-text hover:bg-primary-tint/70 focus:outline-none focus-visible:ring-2 focus-visible:ring-primary">שם העסק</button></div></div><fieldset class="grid gap-2"><legend class="text-sm font-medium text-ink">מה מטרת ההודעה?</legend><label class="flex min-h-11 items-center gap-3 rounded-md border px-3 border-primary bg-primary-tint/40"><input class="size-4" type="radio" value="UTILITY" name="template-purpose"><span class="text-sm text-ink">עדכון או תזכורת לליד <span class="text-gray-400">(סטטוס, תזכורת, מענה)</span></span></label><label class="flex min-h-11 items-center gap-3 rounded-md border px-3 border-gray-200 bg-white"><input class="size-4" type="radio" value="MARKETING" name="template-purpose"><span class="text-sm text-ink">מבצע או הצעה שיווקית <span class="text-gray-400">(קופון, מבצע, השקה)</span></span></label></fieldset><p class="text-sm text-gray-500">פרטים שיוחלפו בשליחה: שם הליד</p><ul class="list-disc ps-5 text-sm text-error-text" role="alert"><li>שם ההודעה ארוך מדי.</li><li>אין להקליד סוגריים מסולסלים ({{ }}) בהודעה. להוספת פרטים אישיים השתמשו בכפתורי הפרטים.</li></ul><div><p class="mb-1.5 text-sm text-gray-500">כך הליד יראה את ההודעה</p><div class="rounded-lg p-3 bg-bg bg-[radial-gradient(var(--color-primary-soft)_1px,transparent_1px)] bg-size-[16px_16px]" aria-hidden="true"><div class="flex justify-end"><div class="max-w-[85%] rounded-2xl rounded-se-none border border-success-border bg-success-bg px-3 py-1.5"><p class="min-w-0 text-sm leading-normal whitespace-pre-wrap wrap-break-word text-gray-800">שלוםדוד</p></div></div></div></div><button type="submit" class="press flex min-h-11 w-full items-center justify-center rounded-md bg-solid font-medium text-white hover:bg-solid/85 disabled:opacity-60 focus:outline-none focus-visible:ring-2 focus-visible:ring-primary">שלח לבדיקה</button><button type="button" class="press flex min-h-11 w-full items-center justify-center rounded-md border border-gray-200 bg-white font-medium text-ink hover:bg-gray-50 focus:outline-none focus-visible:ring-2 focus-visible:ring-primary">ביטול</button></form></div>",
