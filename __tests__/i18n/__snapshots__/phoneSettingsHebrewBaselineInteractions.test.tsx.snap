  "detail_מבצע חגים": "<div role="dialog" aria-modal="true" aria-labelledby="ready-message-detail" tabindex="-1" class="overflow-y-auto bg-white shadow-2xl relative popin overflow-x-hidden scrollbar-slim outline-none p-5 pb-[calc(env(safe-area-inset-bottom,0px)+1.25rem)] w-full max-w-[640px] max-h-[85dvh] rounded-t-2xl anim-slide-down motion-reduce:animation-none"><div aria-hidden="true" class="mx-auto mb-4 h-1 w-10 rounded-full bg-gray-300"></div><div class="mb-4 flex items-center justify-between gap-3"><h2 id="ready-message-detail" class="text-lg font-bold text-ink">מבצע חגים</h2><button type="button" aria-label="סגירה" class="-me-1 flex size-11 shrink-0 items-center justify-center rounded-full text-gray-500 hover:bg-gray-100 focus:outline-none focus-visible:ring-2 focus-visible:ring-primary"><span aria-hidden="true" class="text-2xl leading-none">×</span></button></div><div class="flex flex-col gap-4"><div class="flex flex-wrap items-center gap-2"><span class="inline-flex shrink-0 items-center rounded-full border font-medium tabular-nums gap-1.5 px-2 py-0.5 text-xs " style="background-color: var(--color-warning-bg); color: var(--color-warning-text); border-color: var(--color-warning-border);"><span class="shrink-0 rounded-full size-1.5 animate-pulse" style="background-color: var(--color-warning-dot);"></span>בבדיקת וואטסאפ</span><span class="text-sm text-gray-500">מבצע או הצעה</span></div><div role="status" class="rounded-md border p-3 border-amber-300 bg-amber-50"><p class="text-sm font-medium text-amber-800">ההודעה נשלחה לאישור וואטסאפ</p><p class="mt-1 text-sm text-amber-700">אין צורך לעשות דבר — ברגע שתאושר, היא תהיה מוכנה לשליחה.</p></div><div><p class="mb-1.5 text-sm text-gray-500">כך הליד יראה את ההודעה</p><div class="rounded-lg p-3 bg-bg bg-[radial-gradient(var(--color-primary-soft)_1px,transparent_1px)] bg-size-[16px_16px]" aria-hidden="true"><div class="flex justify-end"><div class="max-w-[85%] rounded-2xl rounded-se-none border border-success-border bg-success-bg px-3 py-1.5"><p class="min-w-0 text-sm leading-normal whitespace-pre-wrap wrap-break-word text-gray-800">מבצע מיוחד לחגים!</p></div></div></div></div><div class="flex flex-col gap-2"><button type="button" class="press flex min-h-11 w-full items-center justify-center rounded-md border border-red-200 bg-white font-medium text-red-700 hover:bg-red-50 focus:outline-none focus-visible:ring-2 focus-visible:ring-primary">מחק הודעה</button></div></div></div>",
  "detail_תזכורת פגישה": "<div role="dialog" aria-modal="true" aria-labelledby="ready-message-detail" tabindex="-1" class="overflow-y-auto bg-white shadow-2xl relative popin overflow-x-hidden scrollbar-slim outline-none p-5 pb-[calc(env(safe-area-inset-bottom,0px)+1.25rem)] w-full max-w-[640px] max-h-[85dvh] rounded-t-2xl anim-slide-down motion-reduce:animation-none"><div aria-hidden="true" class="mx-auto mb-4 h-1 w-10 rounded-full bg-gray-300"></div><div class="mb-4 flex items-center justify-between gap-3"><h2 id="ready-message-detail" class="text-lg font-bold text-ink">תזכורת פגישה</h2><button type="button" aria-label="סגירה" class="-me-1 flex size-11 shrink-0 items-center justify-center rounded-full text-gray-500 hover:bg-gray-100 focus:outline-none focus-visible:ring-2 focus-visible:ring-primary"><span aria-hidden="true" class="text-2xl leading-none">×</span></button></div><div class="flex flex-col gap-4"><div class="flex flex-wrap items-center gap-2"><span class="inline-flex shrink-0 items-center rounded-full border font-medium tabular-nums gap-1.5 px-2 py-0.5 text-xs " style="background-color: var(--color-success-bg); color: var(--color-success-text); border-color: var(--color-success-border);"><span class="shrink-0 rounded-full size-1.5 " style="background-color: var(--color-success-dot);"></span>מוכנה לשליחה</span><span class="text-sm text-gray-500">עדכון או תזכורת</span></div><div><p class="mb-1.5 text-sm text-gray-500">כך הליד יראה את ההודעה</p><div class="rounded-lg p-3 bg-bg bg-[radial-gradient(var(--color-primary-soft)_1px,transparent_1px)] bg-size-[16px_16px]" aria-hidden="true"><div class="flex justify-end"><div class="max-w-[85%] rounded-2xl rounded-se-none border border-success-border bg-success-bg px-3 py-1.5"><p class="min-w-0 text-sm leading-normal whitespace-pre-wrap wrap-break-word text-gray-800">היי {{שם הליד}}, מזכירים את הפגישה מחר.</p></div></div></div></div><div class="flex flex-col gap-2"><button type="button" class="press flex min-h-11 w-full items-center justify-center rounded-md bg-solid font-medium text-white hover:bg-solid/85 focus:outline-none focus-visible:ring-2 focus-visible:ring-primary">עריכת הודעה</button><button type="button" class="press flex min-h-11 w-full items-center justify-center rounded-md border border-gray-200 bg-white font-medium text-ink hover:bg-gray-50 focus:outline-none focus-visible:ring-2 focus-visible:ring-primary">העבר לארכיון</button></div></div></div>",
  "discardConfirm": "<div role="dialog" aria-modal="true" aria-labelledby="bottom-sheet-title" tabindex="-1" class="overflow-y-auto bg-white shadow-2xl relative popin overflow-x-hidden scrollbar-slim outline-none p-5 pb-[calc(env(safe-area-inset-bottom,0px)+1.25rem)] w-full max-w-[640px] max-h-[85dvh] rounded-t-2xl anim-slide-down motion-reduce:animation-none"><div aria-hidden="true" class="mx-auto mb-4 h-1 w-10 rounded-full bg-gray-300"></div><div class="mb-4 flex items-center justify-between gap-3"><h2 id="bottom-sheet-title" class="text-lg font-bold text-ink">מחיקת הודעה</h2><button type="button" aria-label="סגירה" class="-me-1 flex size-11 shrink-0 items-center justify-center rounded-full text-gray-500 hover:bg-gray-100 focus:outline-none focus-visible:ring-2 focus-visible:ring-primary"><span aria-hidden="true" class="text-2xl leading-none">×</span></button></div><p class="text-sm leading-relaxed whitespace-pre-line text-gray-600">למחוק את "מבצע חגים"?
ההודעה תוסר ולא תהיה זמינה לשליחה.</p><div class="mt-4 flex flex-col gap-2"><button type="button" class="press flex min-h-11 w-full items-center justify-center rounded-md bg-red-600 font-medium text-white hover:bg-red-700 disabled:opacity-60 focus:outline-none focus-visible:ring-2 focus-visible:ring-primary">מחק</button><button type="button" class="press flex min-h-11 w-full items-center justify-center rounded-md border border-gray-200 bg-white font-medium text-ink hover:bg-gray-50 disabled:opacity-60 focus:outline-none focus-visible:ring-2 focus-visible:ring-primary">ביטול</button></div></div>",
