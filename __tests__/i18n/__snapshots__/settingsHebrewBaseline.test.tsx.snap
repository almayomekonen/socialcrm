x items-start gap-3 px-3 py-2.5 rounded-md border cursor-pointer transition-colors border-solid bg-softy/50"><input type="radio" class="mt-1" name="issuer-radio-businessType" checked="" value="authorized"/><div class="min-w-0 flex-1"><p class="font-medium text-gray-900">עוסק מורשה</p><p class="text-sm text-gray-500">רוב העצמאים בישראל. גובה מע&quot;מ.</p></div></label><label class="flex items-start gap-3 px-3 py-2.5 rounded-md border cursor-pointer transition-colors border-gray-200 hover:border-gray-300"><input type="radio" class="mt-1" name="issuer-radio-businessType" value="company"/><div class="min-w-0 flex-1"><p class="font-medium text-gray-900">חברה בע&quot;מ</p><p class="text-sm text-gray-500">חברה רשומה ברשם החברות (ח.פ).</p></div></label></div><p class="mt-1 ms-1 text-xs text-gray-500">לא בטוחים? תוכלו לעדכן בהמשך בהגדרות.</p></div><div><div class="block"><div class="flex justify-between mb-1 ms-1 items-end "><label for="«id»" class="text-gray-600 text-sm font-medium ">מספר עוסק / ח.פ</label></div><input id="«id»" class="h-10 w-full rounded-md border bg-white focus:outline-2 focus:outline-offset-0 disabled:opacity-50 border-gray-200 focus:outline-primary px-2.5" type="text" placeholder="123456789" value="514123456"/></div><p class="mt-1 ms-1 text-xs text-gray-500">8 ספרות לעצמאי, 9 ספרות לחברה. ללא מקפים.</p></div><div><div class="block"><div class="flex justify-between mb-1 ms-1 items-end "><label for="«id»" class="text-gray-600 text-sm font-medium ">כתובת</label></div><textarea id="«id»" class="h-10 w-full rounded-md border bg-white focus:outline-2 focus:outline-offset-0 disabled:opacity-50 border-gray-200 focus:outline-primary min-h-24 p-2.5" placeholder="לדוגמה:
רוטשילד 12
תל אביב 6688112">הרצל 10
חיפה 3303010</textarea></div><p class="mt-1 ms-1 text-xs text-gray-500">תופיע על החשבוניות. נדרשת לעוסק מורשה ולחברה.</p></div><div><div class="block"><div class="flex justify-between mb-1 ms-1 items-end "><label for="«id»" class="text-gray-600 text-sm font-medium ">טלפון</label></div><input id="«id»" class="h-10 w-full rounded-md border bg-white focus:outline-2 focus:outline-offset-0 disabled:opacity-50 border-gray-200 focus:outline-primary px-2.5" type="tel" placeholder="054-1234567" value="04-1234567"/></div></div><div><div class="block"><div class="flex justify-between mb-1 ms-1 items-end "><label for="«id»" class="text-gray-600 text-sm font-medium ">אימייל לחשבוניות</label></div><input id="«id»" class="h-10 w-full rounded-md border bg-white focus:outline-2 focus:outline-offset-0 disabled:opacity-50 border-gray-200 focus:outline-primary px-2.5" type="email" placeholder="billing@yourbusiness.com" value="billing@example.test"/></div><p class="mt-1 ms-1 text-xs text-gray-500">משמש ככתובת המשיב כשהלקוח עונה למייל.</p></div><div><p class="mb-1 ms-1 text-sm text-gray-600">לוגו</p><div class=""><div class="grid gap-2"><label class="btn"><div aria-hidden="true" class="bg-gray-800 dark:bg-white size-4 " style="mask-image:url(https://res.cloudinary.com/dfletli2x/image/upload/icons/lit/image.svg);-webkit-mask-image:url(https://res.cloudinary.com/dfletli2x/image/upload/icons/lit/image.svg);mask-repeat:no-repeat;-webkit-mask-repeat:no-repeat;mask-position:center;-webkit-mask-position:center;mask-size:contain;-webkit-mask-size:contain;mask-type:alpha"></div><p>לוגו</p><input type="file" accept="image/*" class="hidden"/></label><input type="hidden" name="img" value="null"/></div></div><p class="mt-1 ms-1 text-xs text-gray-500">תמונת PNG או JPG. תופיע בראש החשבונית.</p></div><p class="text-xs text-gray-500 ms-1">פרטים אלו יופיעו על המסמכים שתנפיקו</p><div class="flex justify-end gap-2 mt-2"><button class="flex items-center min-w-fit justify-center font-medium rounded-md flex-nowrap bg-solid text-white hover:bg-solid/85 h-10 px-4 gap-3" type="submit"><span>שמור פרטים</span></button></div></form></div></div>",
