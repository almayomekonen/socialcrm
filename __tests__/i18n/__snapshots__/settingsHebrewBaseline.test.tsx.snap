k-size:contain;mask-type:alpha"></div></button></span></div></div><form class="grid gap-4"><div class="relative "><div class="block"><div class="flex justify-between mb-1 ms-1 items-end "><label for="«id»" class="text-gray-600 text-sm font-medium ">בחר נציג למתן הרשאה</label></div><input id="«id»" class="h-10 w-full rounded-md border bg-white focus:outline-2 focus:outline-offset-0 disabled:opacity-50 border-gray-200 focus:outline-primary px-2.5" placeholder="חיפוש..." role="combobox" aria-expanded="false" aria-autocomplete="list" autoComplete="off" value=""/></div><div class="block"><input id="«id»" class="h-10 w-full rounded-md border bg-white focus:outline-2 focus:outline-offset-0 disabled:opacity-50 border-gray-200 focus:outline-primary px-2.5 absolute top-0 right-0 -z-50 opacity-0" required="" name="permUserId"/></div></div><button class="flex items-center min-w-fit justify-center font-medium rounded-md flex-nowrap bg-solid text-white hover:bg-solid/85 h-10 px-4 gap-3"><div aria-hidden="true" class="dark:bg-white bg-white size-4 " style="mask-image:url(https://res.cloudinary.com/dfletli2x/image/upload/icons/sol/floppy-disk.svg);-webkit-mask-image:url(https://res.cloudinary.com/dfletli2x/image/upload/icons/sol/floppy-disk.svg);mask-repeat:no-repeat;-webkit-mask-repeat:no-repeat;mask-position:center;-webkit-mask-position:center;mask-size:contain;-webkit-mask-size:contain;mask-type:alpha"></div><span>הוסף נציג להרשאות</span></button></form></div></div></details><details name="x" class="group/acrdn border-b-2 last:border-b-0"><summary><div class="flex items-center gap-2"><div aria-hidden="true" class="bg-gray-800 size-[18.5px] dark:bg-white group-open/acrdn:bg-solid " style="mask-image:url(https://res.cloudinary.com/dfletli2x/image/upload/icons/reg/user-alien.svg);-webkit-mask-image:url(https://res.cloudinary.com/dfletli2x/image/upload/icons/reg/user-alien.svg);mask-repeat:no-repeat;-webkit-mask-repeat:no-repeat;mask-position:center;-webkit-mask-position:center;mask-size:contain;-webkit-mask-size:contain;mask-type:alpha"></div><p class="group-open/acrdn:text-solid">נציגים לשיוך לידים</p><span class="text-xs font-medium px-2 py-0.5 rounded-full bg-gray-100 text-gray-500">אופציונלי</span></div><div aria-hidden="true" class="bg-gray-800 size-[18.5px] dark:bg-white duration-200 group-hover/acrdn:bg-gray-950 group-open/acrdn:rotate-90 group-open/acrdn:bg-solid " style="mask-image:url(https://res.cloudinary.com/dfletli2x/image/upload/icons/lit/chevron-left.svg);-webkit-mask-image:url(https://res.cloudinary.com/dfletli2x/image/upload/icons/lit/chevron-left.svg);mask-repeat:no-repeat;-webkit-mask-repeat:no-repeat;mask-position:center;-webkit-mask-position:center;mask-size:contain;-webkit-mask-size:contain;mask-type:alpha"></div></summary><div class="p-6"><p class="text-gray-500 text-sm mb-2">נציגים הם שמות לשיוך לידים בלבד. הם לא מקבלים גישה למערכת ולא יכולים להתחבר אליה.</p><p class="text-gray-500 text-sm mb-4">כדי לתת למישהו גישה למערכת — יש לבקש ממנהל החשבון לשלוח לו הזמנה.</p><div><form class="max-w-72 "><div class="block"><div class="flex justify-between mb-1 ms-1 items-end "><label for="«id»" class="text-gray-600 text-sm font-medium ">שם פרטי</label></div><input id="«id»" class="h-10 w-full rounded-md border bg-white focus:outline-2 focus:outline-offset-0 disabled:opacity-50 border-gray-200 focus:outline-primary px-2.5 mb-1" required="" name="firstName"/></div><div class="block"><div class="flex justify-between mb-1 ms-1 items-end "><label for="«id»" class="text-gray-600 text-sm font-medium ">שם משפחה</label></div><input id="«id»" class="h-10 w-full rounded-md border bg-white focus:outline-2 focus:outline-offset-0 disabled:opacity-50 border-gray-200 focus:outline-primary px-2.5" name="lastName"/></div><div class="grid grid-cols-2 mt-4 gap-4"><button class="flex items-center min-w-fit justify-center font-medium rounded-md flex-nowrap bg-solid text-white hover:bg-solid/85 h-10 px-4 gap-3 col-span-2"><div aria-hidden="true" class="