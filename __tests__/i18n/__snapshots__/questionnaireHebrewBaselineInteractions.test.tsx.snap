exports[`Hebrew baseline — publishing, history, conflicts > history: rows, restore + toast, refusal, error, empty 1`] = `
{
  "empty": "<div role="dialog" aria-modal="true" aria-label="היסטוריית הגרסאות" tabindex="-1" class="overflow-y-auto bg-white shadow-2xl relative popin overflow-x-hidden scrollbar-slim outline-none p-8 max-h-[90vh] rounded-lg"><button class="absolute top-2 left-2" title="יציאה ללא שמירה" aria-label="סגירה"><div aria-hidden="true" class="dark:bg-white size-[22px] bg-red-700 " style="mask-image: url(&quot;https://res.cloudinary.com/dfletli2x/image/upload/icons/lit/circle-xmark.svg&quot;); -webkit-mask-image: url(&quot;https://res.cloudinary.com/dfletli2x/image/upload/icons/lit/circle-xmark.svg&quot;); mask-repeat: no-repeat; -webkit-mask-repeat: no-repeat; mask-position: center; -webkit-mask-position: center; mask-size: contain; -webkit-mask-size: contain; mask-type: alpha;"></div></button><div class="grid min-w-[min(32rem,85vw)] gap-4 pt-2"><div><h2 class="text-lg font-semibold text-ink">היסטוריית הגרסאות</h2><p class="mt-1 text-sm text-gray-600">כל פרסום שומר גרסה חדשה, וגרסאות קודמות נשארות כאן. "יצירת טיוטה מגרסה זו" מעתיקה גרסה לעריכה. היא תגיע ללקוחות רק אחרי שתפרסמו אותה, כגרסה חדשה.</p></div><p class="text-sm text-gray-600">עוד לא פורסמה גרסה.</p></div></div>",
