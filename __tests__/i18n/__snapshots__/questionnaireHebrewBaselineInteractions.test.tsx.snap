ion value="services">שירותים</option></select></div><div role="group" aria-label="התשובות שבהן זה קורה" class="flex flex-wrap gap-x-5 gap-y-1.5"><p class="w-full text-sm text-gray-700">כשהלקוח בחר:</p><label class="flex items-center gap-2 text-sm"><input class="size-4 accent-solid" type="checkbox">חתונה</label><label class="flex items-center gap-2 text-sm"><input class="size-4 accent-solid" type="checkbox">חינה</label><label class="flex items-center gap-2 text-sm"><input class="size-4 accent-solid" type="checkbox">אחר</label></div></div><p class="text-sm text-gray-800"><span class="font-medium">נשלח כאשר:</span> בשאלה "סוג האירוע" עוד לא נבחרה תשובה</p></fieldset></div><div><div class="flex items-baseline gap-2.5"><label for="«id»-custom-1" class="text-sm font-semibold text-gray-700">ההודעה</label><p class="text-xs text-gray-500">למשל הודעת הסיום עם קישור מתאים</p></div><div class="mt-3.5 rounded-md border border-gray-200 bg-white focus-within:outline-2 focus-within:outline-offset-0 focus-within:outline-primary aria-invalid:border-red-500 aria-invalid:focus-within:outline-red-200"><textarea id="«id»-custom-1" rows="3" maxlength="900" class="block w-full resize-none bg-transparent px-4 pt-3.5 text-sm leading-relaxed outline-none" aria-invalid="false" aria-describedby="«id»-custom-1-note" placeholder="">מעולה, קיבלנו את הפרטים. נחזור אליכם בהקדם.</textarea><div class="mx-4 flex items-center justify-between border-t border-gray-100 py-2 text-xs text-gray-500"><span id="«id»-custom-1-note">הטקסט הזה נשלח ללקוח כלשונו</span><span>43 / 900</span></div></div></div><ul class="grid gap-1"><li class="text-sm text-red-700">בסיום השונה צריך לבחור לפחות תשובה אחת שאחריה הוא נשלח.</li></ul></div><div><span class="inline-grid gap-1"><button class="flex items-center min-w-fit justify-center font-medium rounded-md flex-nowrap border text-black border-gray-200 bg-white hover:bg-gray-100/60 h-9 px-3 gap-3 text-[15px]" type="button"><div aria-hidden="true" class="dark:bg-white bg-black