public-hoist-pattern[]=pdfjs-dist
# Install dependencies in a flat (npm-style) node_modules layout instead
# of pnpm's symlinked .pnpm/ store. Vercel's deployment packager refuses
# to traverse pnpm symlinks for the function bundle and fails the build
# with "The framework produced an invalid deployment package for a
# Serverless Function." This affects every package that ships runtime
# assets read by relative path (the @sparticuz/chromium binary blobs,
# pdfjs-dist worker, etc.). Going from symlinked → hoisted is safe: it's
# strictly more permissive (npm-style). pnpm v10 supports this natively;
# no other tooling change is required.
node-linker=hoisted