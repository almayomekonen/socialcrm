{
  "name": "social-crm",
  "version": "0.1.0",
  "private": true,
  "browserslist": [
    "> 0.5%",
    "not dead",
    "not op_mini all"
  ],
  "scripts": {
    "postinstall": "node scripts/copy-pdf-worker.mjs",
    "prebuild": "node scripts/copy-pdf-worker.mjs",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "build:start": "next build && next start",
    "mig": "sh -c 'tsx scripts/$1' --",
    "test": "playwright test",
    "test.ui": "playwright test --ui",
    "test.codegen": "playwright codegen --project=ADMIN http://localhost:3000",
    "test:integration": "NODE_ENV=test vitest run __tests__",
    "test:integration:watch": "NODE_ENV=test vitest __tests__",
    "test:unit": "NODE_ENV=test VITEST_NO_DB=1 vitest run __tests__/ai",
    "test:runtime": "NODE_ENV=test vitest run --config vitest.runtime.config.ts",
    "test:a11y": "NODE_ENV=test VITEST_NO_DB=1 vitest run __tests__/a11y",
    "test:catalog": "NODE_ENV=test VITEST_NO_DB=1 vitest run __tests__/automations",
    "test:support": "NODE_ENV=test VITEST_NO_DB=1 vitest run __tests__/support",
    "test:notifications": "NODE_ENV=test VITEST_NO_DB=1 vitest run __tests__/notifications",
    "test:unit:watch": "NODE_ENV=test VITEST_NO_DB=1 vitest __tests__/ai",
    "test:db:create": "createdb socialcrm_test 2>/dev/null || true",
    "migrate": "knex --knexfile knexfile.cjs migrate:latest",
    "migrate:rollback": "knex --knexfile knexfile.cjs migrate:rollback",
    "migrate:make": "knex --knexfile knexfile.cjs migrate:make",
    "db:migrate": "node scripts/migrate.cjs",
    "db:migrate:prod": "DATABASE_URL=$PROD_DATABASE_URL node scripts/migrate.cjs",
    "db:bootstrap": "node scripts/bootstrap-schema.cjs",
    "db:baseline": "node scripts/regenerate-baseline.cjs",
    "test:db": "NODE_ENV=test vitest run --no-file-parallelism",
    "test:schema": "NODE_ENV=test VITEST_NO_DB=1 vitest run __tests__/schema"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.76",
    "@ai-sdk/google": "^3.0.70",
    "@ai-sdk/openai": "^3.0.63",
    "@aws-sdk/client-s3": "^3.948.0",
    "@aws-sdk/s3-request-presigner": "^3.948.0",
    "@fullcalendar/core": "^6.1.20",
    "@fullcalendar/daygrid": "^6.1.20",
    "@fullcalendar/interaction": "^6.1.20",
    "@fullcalendar/react": "^6.1.20",
    "@fullcalendar/timegrid": "^6.1.20",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-toggle": "^1.1.10",
    "@radix-ui/react-toggle-group": "^1.1.11",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.0.8",
    "ai": "^6.0.176",
    "axios": "^1.13.2",
    "babel-plugin-react-compiler": "19.1.0-rc.2",
    "class-variance-authority": "^0.7.1",
    "driver.js": "^1.8.0",
    "emoji-picker-react": "^4.19.1",
    "framer-motion": "^12.38.0",
    "html2canvas-pro": "^1.5.13",
    "jose": "^5.10.0",
    "jspdf": "^2.5.2",
    "jwt-decode": "^4.0.0",
    "knex": "^3.1.0",
    "lucide-react": "^1.8.0",
    "motion": "^12.38.0",
    "next": "^16.3.1",
    "pdf-lib": "^1.17.1",
    "pg": "^8.16.3",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-email": "^6.0.5",
    "react-pdf": "^9.2.1",
    "resend": "^6.11.0",
    "web-push": "^3.6.7",
    "xlsx": "^0.18.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@react-email/ui": "6.0.5",
    "@tailwindcss/postcss": "^4.1.18",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.19.3",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/web-push": "^3.6.4",
    "dotenv": "^17.2.3",
    "jsdom": "^29.0.2",
    "kanel": "^3.16.0",
    "kanel-knex": "^2.6.0",
    "postcss": "^8.5.6",
    "prettier": "^3.7.4",
    "tailwind-merge": "^2.6.0",
    "tailwindcss": "^4.1.18",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.4"
  },
  "type": "module"
}
