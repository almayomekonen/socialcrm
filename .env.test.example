APP_ENV=test
GROW_MODE=sandbox
APP_HOST=localhost:3000

DATABASE_URL=postgres://test:test@localhost:5432/test_db

JWT_SECRET=test_jwt_secret_change_me_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Grow Light API — the saved-card journey, the only way to pay.
# Payment Links and their webhook secrets were removed; nothing reads
# GROW_PAYMENT_LINK, GROW_WEBHOOK_SECRET, GROW_TOKEN_SECRET or the
# GROW_RECURRING_* secrets any more.
GROW_USER_ID=test-grow-user-id
GROW_PAGE_CODE_TOKEN=test-token-only-page-code
GROW_SANDBOX_ISOLATED_DATA=true
# Absence-blocks: unset means off.
