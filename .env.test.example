APP_ENV=test
GROW_MODE=sandbox
APP_HOST=localhost:3000

DATABASE_URL=postgres://test:test@localhost:5432/test_db

JWT_SECRET=test_jwt_secret_change_me_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GROW_TOKEN_SECRET=test_token_secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GROW_WEBHOOK_SECRET=test_webhook_secret_xxxxxxxxxxxxxxxxxxxxxxxxxxx
GROW_PAYMENT_LINK=https://pay.grow.link/test-link-id

# Consumer Facebook Login (user authentication only — never Page/WhatsApp)
AUTH_FACEBOOK_APP_ID=1576374570608325
AUTH_FACEBOOK_APP_SECRET=test-auth-facebook-app-secret
FACEBOOK_USER_AUTH_ENABLED=1
FACEBOOK_USER_AUTH_AGENCY_ALLOWLIST=103

AI_ENABLED=false
AI_AGENCY_ALLOWLIST=
AI_DAILY_USD_CAP=1
AI_HEALTH_SECRET=test_ai_health_secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_HEAVY_MODEL=claude-opus-4-7
GOOGLE_GENERATIVE_AI_API_KEY=
GOOGLE_AI_MODEL=gemini-2.5-flash-lite
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# --- AI layer (Phase 1) ---
# All keys optional in tests; the AI router falls through silently when missing.
# NEVER put a real key in this file — it is tracked in git. Three real keys
# were once committed here and all three are now dead: Google disabled its one
# with "your API key was reported as leaked", which is a secret scanner finding
# a public repository. Real values belong in .env.local, which is gitignored.
AI_ENABLED=true
AI_AGENCY_ALLOWLIST=27
AI_DAILY_USD_CAP=5
AI_HEALTH_SECRET=test_ai_health_secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_HEAVY_MODEL=claude-opus-4-7
GOOGLE_GENERATIVE_AI_API_KEY=
GOOGLE_AI_MODEL=gemini-2.5-flash-lite
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini